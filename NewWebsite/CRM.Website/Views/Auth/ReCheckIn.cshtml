@using Fanex.NAP.Client.Configuration
@inject INapSettings napSettings
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
</head>
<body>
    <input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
    <input type="checkbox" hidden id="IsHost" @(napSettings.EnableReCheckIn ? "checked" : string.Empty) />
    @Html.AntiForgeryToken()
    <environment include="Development">
        <script src="~/js/dev/pages/auth/recheckin.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/auth/recheckin.chunk.js" asp-append-version="true"></script>
    </environment>
</body>
</html>
