<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/main.chunk.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/main.chunk.css" />
    </environment>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="container-fluid">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <environment include="Development">
        <script src="~/js/dev/lib/react-vendor.chunk.js"></script>
        <script src="~/js/dev/main.chunk.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/react-vendor.chunk.js"></script>
        <script src="~/js/pro/main.chunk.js"></script>
    </environment>
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
    @RenderSection("Scripts", required: false)
</body>
</html>
