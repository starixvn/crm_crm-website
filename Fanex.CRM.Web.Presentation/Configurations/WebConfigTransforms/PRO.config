<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <NapSettings xdt:Transform="Replace"
         UMAddress="tcp://10.40.40.150:8990/UMControllerInterface"
				 Environment="LIVE"
				 EnableDirectLogin="1"
				 SiteId="19"
				 EnableCheckUM="true"
				 EnableReCheckin="true"
				 UnauthorizeUrl="~/Common/AccessDenied"
				 HubUrl="http://58.86.55.10/naphub">
    <Domain>
      <add Name="http://58.86.55.10/NapCRM" Path="/" />
    </Domain>
  </NapSettings>
  <Fanex.Logging xdt:Transform="Replace" msmqPath="FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib" defaultCategory="CRM" />
  <system.web>
    <customErrors xdt:Transform="Replace" mode="RemoteOnly" defaultRedirect="~/Common/ErrorPage">
      <error statusCode="404" redirect="~/Views/Common/404Error.htm" />
    </customErrors>
    <sessionState xdt:Transform="Replace" mode="StateServer" timeout="10" stateConnectionString="tcpip=10.40.40.135:42424" />
  </system.web>
  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="01:00" UMTo="23:00" SiteId="2000000" UMPageUrl="~/Common/Offline" xdt:Transform="Replace">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>
</configuration>