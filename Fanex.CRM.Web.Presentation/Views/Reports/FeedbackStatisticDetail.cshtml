@using DNAide.Core

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/site/ui-darkness/jquery-ui-1.8.14.custom.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/Paging/pagination.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/FanexGrid/FanexGrid.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/site/customizeFanexGrid.less?ver=1")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/Reports/Styles/StyleSheet.css")" rel="stylesheet" type="text/css" />  
</head>
<body>

    <div class="main">
        <div class="maincontent">
            <div class="errmsg" id="errmsg"></div>
            <div id="feedbackstatisticgrid" class="freegrid hidden">
                <div class="grid-title">
                    <div class="grid-title-lable" id="gridtitle"></div>
                    <div class="grid-toolbox">
                        <input type="button" onclick="feedbackDetail.export2excel()" value="  " id="btnExport" class="btnExcel" title="Export to Excel" />
                    </div>
                </div>
                  
                <div class="free-cell free-top-left">
                    <table class="grid-fixed-table free-cell-top-left">
                        <thead>
                            <tr>
                                <th>
                                    <div style="height: 30px; width: 380px;" class="table-cell">
                                        Feedback</div>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>
                <div class="row_header_wrapper">
                    <div class="row_header row-headers-background">
                        <table class="grid-fixed-table row_header_content" id="feedbackstatisticheader">
                            <thead>
                                <tr>
                                    <th>
                                        <div style="height: 30px; width: 380px;" class="table-cell">
                                            Feedback</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="col_header row-headers-background scroll-y">
                    <div class="header-container">
                        <table class="grid-fixed-table col_header_content">
                            <thead>
                                <tr>
                                    <th>
                                        <div style="height: 30px; width: 380px;" class="table-cell">
                                            Feedback</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 120px;" class="table-cell">
                                            Customer</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 200px;" class="table-cell">
                                            Category</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 60px;" class="table-cell">
                                            Status</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 180px;" class="table-cell">
                                            Related Customer</div>
                                    </th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
                <div class="grid-container container">
                    <table id="feedbackstatisticbody" class="grid-fixed-table col_header_content">
                        <thead>
                                <tr>
                                    <th>
                                        <div style="height: 30px; width: 380px;" class="table-cell">
                                            Feedback</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 120px;" class="table-cell">
                                            Customer</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 200px;" class="table-cell">
                                            Category</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 60px;" class="table-cell">
                                            Status</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 180px;" class="table-cell">
                                            Related Customer</div>
                                    </th>                                        
                                </tr>  
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                
            </div>
        </div>
        <div id="divPopup" class="selector" style="display: none;">@Resources.Language.ClickExportButtonAfterSomeSeconds</div>
        <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
        @{
            if (Request["export"] != null && CastAide.AsBoolean(Request["export"]))
            {
                var type = CastAide.AsInt32(Request["type"]);
                var valueId = CastAide.AsInt32(Request["valueId"]);
                var mainCategoryId = CastAide.AsInt32(Request["mainCateId"]);
                var subCategoryId = CastAide.AsInt32(Request["subCateId"]);
                var fDate = CastAide.AsString(Request["fdate"]);
                var tDate = CastAide.AsString(Request["tdate"]);
                var reportTitle = CastAide.AsString(Request["title"]);
                Fanex.CRM.Service.Interface.IFeedbackService feedbackService = new Fanex.CRM.Service.Impl.FeedbackService();
                feedbackService.ExportExcelFeedbackStatisticDetail(type, valueId, mainCategoryId, subCategoryId, fDate, tDate, reportTitle);
            }
        }
        <script type="text/javascript">
            window.rootUrl = '@Url.Content("~")';
            var accname = "@Fanex.CRM.Web.Controllers.Helper.AppSession.CurrentUser.Username";          
            
       
            head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                    head.js("@Url.Content("~/Scripts/json2.js")")
                        .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.min.js")")
                        .js("@Url.Content("~/Scripts/stdlib.js")")                        
                        .js("@Url.Content("~/Scripts/common.js?ver=1")")
                        .js("@Url.Content("~/Scripts/Paging/jpager.js")")
                        .js("@Url.Content("~/Scripts/FanexGrid/FanexGrid.js?ver=1")")
                        .js("@Url.Content("~/Views/Reports/Scripts/FeedbackStatisticDetail.js?ver=1")");
                });   
        </script>

    </div>
</body>
</html>
