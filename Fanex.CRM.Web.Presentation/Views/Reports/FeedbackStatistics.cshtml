<div class="container main">
    <div class="row">Feedback Statistics</div>
    <div class="row filter-frm one-row redemption-filter">
        <div class="row row-item">
            <div class="item">
                <select id="ddlType" name="ddlType" style="width: 100px">
                    <option value="1">By Creator</option>
                    <option value="2">By Country</option>
                    <option value="3">By Role</option>
                    <option value="4">By Site</option>
                    <option value="5">By Status</option>
                    <option value="6">By Response</option>
                    <option value="7">By Product</option>
                    <option value="8">By Category</option>
                    <option value="9">By Licensees</option>
                </select>
            </div>
            <div class="item">
                <label for="txtfromdate">From date</label>
                <input type="text" id="txtfromdate" readonly="readonly" class="textbox txtcalendar" />
            </div>
            <div class="item">
                <label for="txttodate">To date</label>
                <input type="text" id="txttodate" readonly="readonly" class="textbox txtcalendar"/>
            </div>
            <div class="item">
                <label for="status">Status</label>
                <select id="status" class="sel-status">
                    <option value="0">All</option>
                </select>
            </div>
            <div class="item">
                <button id="btnSearch" name="btnSearch" class="btn" onclick="feedbackStatistic.loadFeedback(0);" ><span class="hotkey">S</span>ubmit</button>
            </div>
        </div>
        <div class="row row-item">
            <div class="item width-100">
                 From Duration
            </div>
            <div class="item day">
                <input type="text" id="txtFDDay" class="textbox" />
                            Day
            </div>
            <div class="item day">
                 <input type="text" id="txtFDHour" class="textbox" />
                            Hour
            </div>
            <div class="item day">
                 <input type="text" id="txtFDMinute" class="textbox" />
                            Minute
            </div>
            <div class="item day">
                 <input type="text" id="txtFDSecond" class="textbox" />
                            Second
            </div>
        </div>
        <div class="row">
            <div class="item width-100">
                To Duration
            </div>
            <div class="item day">
                <input type="text" id="txtTDDay" class="textbox"/>
                            Day
            </div>
            <div class="item day">
                 <input type="text" id="txtTDHour" class="textbox"/>
                            Hour
            </div>
            <div class="item day">
                 <input type="text" id="txtTDMinute" class="textbox"/>
                            Minute
            </div>
            <div class="item day">
                 <input type="text" id="txtTDSecond" class="textbox"/>
                            Second
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-7 col-sm-7 col-md-5" id="errmsg">
                </div>
    </div>
    <div class="row">
        <div id="feedbackstatisticgrid" class="freegrid hidden">
            <div class="grid-title">
                <div class="grid-title-lable" id="feedbackstatistictitle">
                    Title</div>
                <div class="grid-toolbox">
                    <input type="button" value=" " id="btnChart" class="btnCharting" onclick="feedbackStatistic.chart.viewByTotal()" />
                    <input type="button" onclick="feedbackStatistic.export2excel()" value="  " id="btnExport"
                        class="btnExcel" title="Export to Excel" />
                </div>
            </div>
            <div class="free-cell free-top-left">
                <table class="grid-fixed-table free-cell-top-left" id="divTopleft">
                    <thead>
                        <tr>
                            <th>
                                <div style="width: 400px;" class="table-cell maxheight">
                                    Sub Category</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="row_header_wrapper">
                <div class="row_header row-headers-background">
                    <table class="grid-fixed-table row_header_content" id="divBackground">
                        <thead>
                            <tr>
                                <th>
                                    <div style="width: 400px;" class="table-cell maxheight">
                                        &nbsp;</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col_header row-headers-background scroll-y">
                <div class="header-container">
                    <table class="grid-fixed-table col_header_content">
                        <thead>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="grid-container container">
                <table id="feedbackstatisticbody" class="grid-fixed-table col_header_content">
                    <thead>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="row_footer row-footer-background z999">
                <table class="grid-fixed-table row_footer_content">
                    <thead>
                    </thead>
                </table>
            </div>
            <div class="col_footer row-footer-background scroll-y">
                <div class="footer-container">
                    <table class="col_footer_content grid-fixed-table">
                        <thead>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
