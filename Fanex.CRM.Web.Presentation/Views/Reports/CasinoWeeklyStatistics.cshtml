        </div>
    </div>
    <div id="divPopup" class="selector" style="display: none;">
        @Resources.Language.InputEmailForReceiveReportFile
        <br /><br />
        <input type="text" id="txtEmail" style="width:320px; height:18px" />
        <br /><span style="font-size:8pt; font-style:italic">Note: @Resources.Language.lblInputMultipleEmail</span>
        <br />
        <div id="divEmailError" class="hidden alertboxerr"></div>
    </div>
    @{
        string fDate = Fanex.CRM.Infrastructure.Helper.Helper.GetFirstDayOfWeek(DateTime.Now).ToString("MM/dd/yyyy");
        string tDate = DateTime.Now.ToString("MM/dd/yyyy");

        if (Request["export"] != null && CastAide.AsBoolean(Request["export"]))
        {
            Fanex.CRM.Service.Interface.IFeedbackService feedbackService = new Fanex.CRM.Service.Impl.FeedbackService();
            switch (CastAide.AsInt32(Request["type"]))
            {
                case 1:
                    feedbackService.ExportExcelCasinoWeeklySummaryReport(CastAide.AsString(Request["fdate"]),
                        CastAide.AsString(Request["tdate"]), CastAide.AsString(Request["title"]));
                    break;
                case 2:
                    feedbackService.ExportExcelCasinoDailyDetailReport(CastAide.AsString(Request["fdate"]),
                        CastAide.AsString(Request["tdate"]), CastAide.AsString(Request["title"]), string.Empty, false);
                    break;
                default:
                    break;
            }
        }
    }
    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
    
    <script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var fromDate = '@fDate';
        var toDate = '@tDate';

        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.min.js")",
                        "@Url.Content("~/Scripts/jquery-ui-timepicker-addon.js")")                    
                    .js("@Url.Content("~/Scripts/stdlib.js")")
                    .js("@Url.Content("~/Scripts/FanexGrid/FanexGrid.js?ver=1")")
                    .js("@Url.Content("~/Scripts/Paging/jpager.js")")
                    .js("@Url.Content("~/Scripts/Chart/highcharts.dev.js")",
                        "@Url.Content("~/Scripts/Chart/accchart.js?ver=1")")
                    .js("@Url.Content("~/Scripts/common.js?ver=1")")
                    .js("@Url.Content("~/Views/Reports/Scripts/CasinoWeeklyStatistics.js?ver=3")");
            });   
    </script>
</body>
</html>
