                            </td>
                            <td>
                                <input type="button" id="btnSearch" name="btnSearch" class="btn" value="Submit" onclick="casinoWeeklySummary.getWeeklySummary();" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5">
                                <div class="icon-filter">
                                </div>
