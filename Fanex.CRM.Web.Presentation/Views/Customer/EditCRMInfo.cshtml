@using Fanex.CRM.Web.Controllers.Helper
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link href="@Url.Content("~/Content/Black2011/ui-darkness/jquery-ui-1.8.14.custom.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/Customer/Styles/StyleSheet.css?ver=1")" rel="stylesheet" type="text/css" />
</head>
<body>

<!--Template area-->
        <script id="tmplOption" type="text/x-jquery-tmpl">
        <option value="${Id}">${Value}</option>
    </script>
      <script id="tmplCountry" type="text/x-jquery-tmpl">
        <option value="${Id}">${CountryName}</option>
    </script>
<!--/Template area-->
    <div class="main">
        <div class="maincontent">
            <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
                <tr>
                    <td class="maincontent_headerL">
                        <img class="maincontent_iconLeft" alt="" src="../Content/Black2011/Images/imgBg.png"/>
                    </td>
                    <td class="maincontent_headerC">
                        Edit CRM Info
                    </td>
                    <td class="maincontent_headerR">
                    </td>
                </tr>
            </table>
            <div class="bg_table" style="margin-top:0px;">
                <div id="sContent">
                    <div class="errmsg" id="errmsg">
                    </div>
                    <table class="tblcollapse" style="width: 100%; text-align:left">                        
                         <tbody id="tbodyCRMInfo">
                           <script type="text/html" id="tmplCRMInfo">
                              <tr class="title">
                                    <td colspan="4" class="l">
                                        <b><span id="Span1">${RoleName}</span>: <span id="lblUserName" >${UserName}</span></b>
                                        {{if (Id > 0)}}
                                        <b><span id="SpanNickName">(NickName</span>: <span id="lblUserName2" >${NickName})</span></b>
                                        {{/if}}
                                        <span id="lblEditIndentity" class="hidden" ><input type="text" id="txtUserName" value="${UserName}" style="margin-top:-3px"/></span>
                                        {{if (RoleId == 7004 || RoleId == 0)}}<span>
                                            <input type="checkbox" id="chkIsUpdateIndentity" value="Edit Identity Information" style="margin:-2px 0 0 2px;" onclick="checkEditIndentityInfo();"/>
                                            Edit Identity Information
                                            </span>
                                        {{/if}}
                                    </td>                                    
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r ">
                                        First Name
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="text" value="${CustomerInfo.FirstName}" id="txtFirstName" name="txtFirstName" />
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Last Name
                                    </td>
                                    <td style="width: 30%">
                                        <input type="text" value="${CustomerInfo.LastName}" id="txtLastName" name="txtLastName" />
                                    </td>
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Birthday (mm/dd/yyyy)
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="text" id="txtBirthDay" class="txtcalendar" name="txtBirthDay" readOnly="true" style="width:100px;" />
                                        
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Language
                                    </td>
                                    <td style="width: 30%">
                                        <select id="ddlLanguage">
                                            <option value="0">N/A</option>
                                        </select>
                                        <span class="hidden error errormsg" id="errorLanguage"></span>
                                    </td>
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Phone
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="text" value="${CustomerInfo.Phone}" id="txtPhone" name="txtPhone" />
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Mobile Phone
                                    </td>
                                    <td style="width: 30%">
                                        <input type="text" value="${CustomerInfo.MobilePhone}" id="txtMobile" name="txtMobile" />
                                    </td>
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Fax
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="text" value="${CustomerInfo.Fax}" id="txtFax" name="txtFax" />
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Email
                                    </td>
                                    <td style="width: 30%">
                                        <input type="text" value="${CustomerInfo.Email}" id="txtEmail" name="txtContactType" />
                                    </td>
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Skype
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="text" value="${CustomerInfo.Skype}" id="txtSkype" name="txtFax" />
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        MSN
                                    </td>
                                    <td style="width: 30%">
                                        <input type="text" value="${CustomerInfo.MSN}" id="txtMSN" name="txtContactType" />
                                    </td>
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        PIC1
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="text" value="${Pic1}" id="txtPIC1" name="txtPIC1" />
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Beting Code
                                    </td>
                                    <td style="width: 30%">
                                        <input type="text" value="${BettingCode}" id="txtBettingCode" name="txtBettingCode" />
                                    </td>
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        PIC2
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="text" value="${Pic2}" id="txtPIC2" name="txtPIC2" />
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Ref Code 2
                                    </td>
                                    <td style="width: 30%">
                                        <input type="text" value="${RefCode2}" id="RefCode2" name="txtRefCode2" />
                                    </td>
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        PIC3
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="text" value="${Pic3}" id="txtPIC3" name="txtPIC3" />
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Country
                                    </td>
                                    <td style="width: 30%">
                                        <select id="ddlCountry">
                                            <option value="0">N/A</option>                                            
                                        </select>

                                        <span class="hidden error errormsg" id="errorCountry"></span>
                                    </td>
                                </tr>
                                <tr class="solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        VIP
                                    </td>
                                    <td style="width: 30%;border-right:1px solid #E5E5E5;">
                                        <input type="checkbox" id="chkVIP" name="chkVIP" />
                                    </td>
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b r">
                                        Site
                                    </td>
                                    <td style="width: 30%">                                        
                                        <select id="ddlRelatedProduct">                                                                                      
                                        </select>         

                                        <span class="hidden error errormsg" id="errorRelatedProduct"></span>
                                    </td>
                                </tr>

                                <tr class="title">
                                    <td colspan="4" class="l">
                                        Bank Information <input type="button" style="" name="btndownup" id="btndownup" class="downup" onclick="downup();">
                                    </td>
                                </tr>
                                <tr class="bankinfo hidden solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b l">
                                        Bank
                                    </td>
                                    <td colspan="3" style="width: 80%">
                                        <input type="text" id="txtBank" name="txtBank" style="width:70%" value="${BankInfo.BankName}" />
                                    </td>
                                </tr>
                                <tr class="bankinfo hidden solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b l">
                                        Account Holder Name
                                    </td>
                                    <td colspan="3" style="width: 80%">
                                        <input type="text" id="txtAccountHolderName" name="txtAccountNo" style="width:70%" value="${BankInfo.AccountHolderName}" />
                                    </td>
                                </tr>
                                <tr class="bankinfo hidden solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b l">
                                        Account No.
                                    </td>
                                    <td colspan="3" style="width: 80%">
                                        <input type="text" id="txtAccountNo" name="txtAccountNo" style="width:70%" value="${BankInfo.AccountNo}" />
                                    </td>
                                </tr>
                                <tr class="bankinfo hidden solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b l">
                                        Bank Address
                                    </td>
                                    <td colspan="3"  style="width: 80%">
                                        <input type="text" id="txtBankAddress" name="txtBankAddress" style="width:70%" value="${BankInfo.BankAddress}" />
                                    </td>
                                </tr>
                                <tr class="bankinfo hidden solid_left">
                                    <td style="width: 20%;border-right:1px solid #E5E5E5;" class="b l">
                                        IBAN/SWIFT
                                    </td>
                                    <td colspan="3" style="width: 80%">
                                        <input type="text" id="txtIBANS_WIFT" name="txtIBANS_WIFT" style="width:70%" value="${BankInfo.SwiftCode}" />
                                    </td>
                                </tr>
                        
                                <tr class="title">
                                    <td colspan="4" class="l">
                                        Remark
                                    </td>
                                    
                                </tr>
                                <tr>
                                    <td colspan="4" class="l">
                                       <textarea id="remarkeditor" name="remarkeditor" style="width:710px; height:100px;">${Remark}</textarea>
                                    </td>
                                </tr>
                            
                            <tr class="title">
                                    <td colspan="4" class="l">
                                       Special Remark
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="l">
                                       <textarea id="specialremarkeditor" name="specialremarkeditor" style="width:710px; height:100px;">${SpecialRemark}</textarea>
                                    </td>
                                </tr>

                                <tr>
                                <td colspan="4">
                                    <input type="button" class="btn" id="btnsubmit" value="Submit" onclick="updateCustomerInfo();" />
                                </td>
                            </tr>
                            </script>
                        </tbody>
                          
                    </table>                    
                </div>
                <input type="hidden" id="hiddenCRMId" name="hiddenCRMId" value="" />
                <input type="hidden" id="hiddenUserName" name="hiddenCreatorUserName" value="" />
                
            </div>
        </div>                
    </div>
    @{
        int custId = Request["custid"] != null ? int.Parse(Request["custid"]) : 0;;
    }  

    <script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';

        var custId = @custId;
        var accname = "@AppSession.CurrentUser.Username";
        var accId = @AppSession.CurrentUser.Id;
        var desvalue = "";
        var isdesreviewmode = false;

        var errorMsg = "@Resources.ErrorMsg.lblErrorInputRequiredDate";
        var errorMsgInvalidUser="@Resources.ErrorMsg.lblInvalidUserName";
        var successMsg="@Resources.ErrorMsg.lblUpdateCRMInfoSuccess";

        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.min.js")")
                    .js("@Url.Content("~/Scripts/jquery.tmpl.js")")
                    .js("@Url.Content("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")")    
                    .js("@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-timepicker-addon.js")")                    
                    .js("@Url.Content("~/Scripts/stdlib.js")")
                    .js("@Url.Content("~/Scripts/dialogbox.js")")
                    .js("@Url.Content("~/Scripts/common.js")")
                    .js("@Url.Content("~/Views/Customer/Scripts/EditCustomerInfo.js?ver=1")");                                       
                    
            });   
    </script>
</body>
</html>