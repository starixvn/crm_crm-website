@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.CRM.Infrastructure.Extensions
@using Fanex.CRM.Infrastructure.Resources
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Models;
@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Common.Services;
@{
    var customer = (ViewBag.CurrentCustomer as SearchedCustomer) ?? new SearchedCustomer();

    var getClientTime = Fanex.CRM.Common.Helpers.DateTimeUtilize.ChangeFullTimeZoneToClient(DateTime.Now);
    var createCustomerInfoPolicy = (Constant.Policy)ViewBag.CreateCustomerInfoPolicy;
    var hasCreateOrUpdateFeedbackPermission = createCustomerInfoPolicy != Constant.Policy.None;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/autocomplete/autocomplete.css")
    @RazorHelper.RenderStyles("~/Views/Home/Styles/default.less")
    @RazorHelper.RenderStyles("~/Views/HomeStyles")
    <!--[if lte IE 8]>
		 @RazorHelper.RenderScripts("~/Scripts/Chart/ChartJs/excanvas.js")
	<![endif]-->
}
<div class="container crm-container">
    <div class="row header">
        <div class="col-xs-3 col-sm-3 col-md-3 leftHeader">
            <img alt="" src="~/Content/site/Images/logo-crm.png" class="crm-logo touchable-element"
                    title="@Resources.Language.Home"
                    onclick="javascript:menuManager.getDashboardMenu(parent.dashboardManager.Enums.SubMenuId.Main);"
                    href="javascript:;" />
            <span id="icon-collapse-expand-leftpanel" class="icon-expand" title="@Labels.Home_Index_CollapseExpandLeftPanel">
            </span>
        </div>
        <div class="col-xs-9 col-sm-9 col-md-9 rightHeader">
            <div class="row">
                <div class="col-xs-8 col-sm-8 col-md-8">
                    @Html.Action("GettingUserMenu", new RouteValueDictionary(new { controller = "Home", area = "" }))
                </div>
                <div class="col-xs-4 col-sm-4 col-md-4">
                    @Html.ActionLink(Resources.Language.Sign_out, "LogOut", "UserLogin", routeValues: null, htmlAttributes: new { @class = "pull-right logout" })
                    <div class="login-info pull-right">
                        @Labels.Welcome
                        <span class="txt-username">@ViewBag.AccUsername</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row search-breadbrumb">
            <div class="col-xs-3 col-sm-3 col-md-3 search-frm">
                @if (hasCreateOrUpdateFeedbackPermission)
                {
                    <div class="text-search col-xs-9 col-sm-9 col-md-9">
                        <input id="txtuserName" type="text" class="inputSearch font-style-italic"
                        value="@Resources.Language.Default_SearchTextbox"
                        name="txtuserName"
                        autocomplete="off" tabindex="2" />
                        <input id="buttonsearch" type="button" class="searchSubmit" tabindex="1" />
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3 checkbox check-guest">
                        <label>
                            <input id="isGuest" type="checkbox" tabindex="3" />
                            @Labels.Guest
                        </label>
                    </div>
                }
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9 breadcrumb">
                <div class="col-xs-9 col-sm-9 col-md-9" id="divSubMenu">
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="pull-right timezone">
                        <span id="span-timezoneContainer">@getClientTime</span>
                        @Resources.Language.TimeZoneGMT
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row contentbox">
        <div class="col-xs-3 col-sm-3 col-md-3 leftcontent">
            <iframe id="leftPanel" name="leftPanel" marginwidth="0" scrolling="auto" src="BlankPage"
                marginheight="0" frameborder="0" vspace="0" hspace="0" style="width: 100%; height: 100%;"
                allowtransparency="true"></iframe>
        </div>
        <div id="rightcontent" class="col-xs-9 col-sm-9 col-md-9 rightcontent">
            <iframe id="centerFr" name="centerFr" src="BlankPage" scrolling="auto" marginwidth="0"
                marginheight="0" frameborder="0" vspace="0" hspace="0" style="width: 100%; height: 100%;"
                allowtransparency="true"></iframe>
        </div>
    </div>
</div>
<div id="divErrorPoup" class="selector" style="display: none;">
</div>
<div id="div-resultpopup" class="selector display-none">
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/JQuery/jquery-1.8.2.js",
                            "~/Scripts/json2.js",
                            "~/Scripts/ShareScripts/HotKeyManager.js",
                            "~/Scripts/ShareScripts/CRMConstants.js",
                            "~/Scripts/ShareScripts/SharedScriptManager.js",
                            "~/Scripts/ShareScripts/KeyboardManager.js",
                            "~/Scripts/ShareScripts/FixBugManager.js",
                            "~/Scripts/ShareScripts/DialogManager.js",
                            "~/Scripts/jscookies.js",
                            "~/Scripts/Vendors/jqueryui/jquery-ui.min.js",
                            "~/Scripts/autocomplete/jquery.autocomplete.js",
                            "~/Scripts/jquery.blockUI.1.33.js",
                            "~/Scripts/BlockUI.js",
                            "~/Scripts/common.js")
    @RazorHelper.RenderScripts("~/Scripts/PopUp")
    @RazorHelper.RenderScripts("~/CRM/Chart/Scripts")
    @RazorHelper.RenderScripts("~/Views/Home/Scripts/Main.js")
    @RazorHelper.RenderScripts("~/Views/HomeScripts")
    @RazorHelper.RenderScripts("~/Views/Home/Dashboard/Scripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var userSearch = '@customer.Name';
        var isGuestSearch = '@customer.IsGuest';
        var accUrlDefault = '@AppSetting.LoginLink';
        var logoutUrl = '@Url.Action("LogOut", "UserLogin")';
        var umUrl = '@Url.Action("Offline", "Common")';
        var userId = @(AppSession.CurrentUser != null ? AppSession.CurrentUser.Id : 0);
        var clientTime = "@getClientTime";
        @if(AppSetting.IsLocalTest == false)
        {
        <text>
        udpateOnlineStatus();
        </text>
        }
    </script>
}