@using Fanex.CRM.Entities
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <link href="@Url.Content("~/Scripts/smoothmenu/ddsmoothmenu.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/site/ui-darkness/jquery-ui-1.8.14.custom.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/autocomplete/styles.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/Home/Styles/default.less?ver=5")" rel="stylesheet" type="text/css" />
</head>
<body>
    @*<div id="fullsize" class="fullsize">
    </div>*@
    <div class="container crm-container">
        <div class="row header">
            <div class="col-md-3 leftHeader">
                <img alt="" src="~/Content/site/Images/logo-crm.png" class="crm-logo" />
                <span class="icon-expand"></span>
            </div>
            <div class="col-md-9 rightHeader">
                <div class="row">
                    <div class="col-md-6">
                        <ul class="menu list-unstyle list-inline">
                            <li class="active">Home</li>
                            <li><a href="#">Feedback <span class="icon-arrow-down"></span></a>
                                <ul class="list-unstyled sub-menu">
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../Feedback/AddGuestFeedback'); ; closedSubmenu('pId0', 0);">
                                        Add Guest Feedback</a></li>
                                    <li><a href="" onclick="javascript:gotoURL('centerFr','../Feedback/LastestFeedback'); ; closedSubmenu('pId0', 0);">
                                        Latest Feedback</a></li>
                                    <li><a href="" onclick="javascript:gotoURL('centerFr','../Feedback/ManageFeedback'); ; closedSubmenu('pId0', 0);">
                                        Manage Feedback</a></li>
                                    <li><a href="" onclick="javascript:gotoURL('centerFr','../Feedback/DeletedFeedback'); ; closedSubmenu('pId0', 0);">
                                        Deleted Feedback</a></li>
                                </ul>
                            </li>
                            <li><a href="#">Report <span class="icon-arrow-down"></span></a>
                                <ul class="list-unstyled sub-menu">
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../Reports/FeedbackStatistics'); ; closedSubmenu('pId1', 0);">
                                        Feedback Statistics</a></li>
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../Reports/DailyStatistic'); ; closedSubmenu('pId1', 0);">
                                        Daily Statistics</a></li>
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../Reports/WeeklyStatistic'); ; closedSubmenu('pId1', 0);">
                                        Weekly Statistics</a></li>
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../Reports/CasinoDailyStatistics'); ; closedSubmenu('pId1', 0);">
                                        Casino Daily Statistics</a></li>
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../Reports/CasinoWeeklyStatistics'); ; closedSubmenu('pId1', 0);">
                                        Casino Weekly Statistics</a></li>
                                </ul>
                            </li>
                            <li><a href="#">AdminTool <span class="icon-arrow-down"></span></a>
                                <ul class="list-unstyled sub-menu">
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../AdminTool/SettingManage'); ; closedSubmenu('pId2', 0);">
                                        Setting Management</a></li>
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../AdminTool/SettingRelation'); ; closedSubmenu('pId2', 0);">
                                        Setting Relation</a></li>
                                    <li><a href="#" onclick="javascript:gotoURL('centerFr','../AdminTool/SubjectTemplateManagement'); ; closedSubmenu('pId2', 0);">
                                        Feedback Subject Management</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <div class="login-info pull-right">
                            Welcome <span class="txt-username">@ViewBag.AccUsername</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row search-breadbrumb">
            <div class="col-md-3 search-frm">
                @*<input type="button" onclick="leftright();" class="leftright" id="btnleftright" name="btnleftright"
                    style="float: left; margin: 4px 0 0 16px;" />
                    <input type="button" onclick="downup();" class="updown" id="btndownup" name="btndownup"
                        style="float: left;" />*@
                <div class="text-search col-md-9">
                    <input type="text" id="txtuserName" class="inputSearch" onkeypress="return KeyPress(event);"
                        onkeyup="return KeyPress(event);" value="Search..." name="txtuserName" onblur="onBlur()"
                        onfocus="onFocus()" autocomplete="off" />
                    <input type="button" class="searchSubmit" value=" " id="btnSendMsg" onclick="submitSearch();" />
                </div>
                <div class="col-md-3 checkbox check-guest">
                    <label>
                        <input id="isGuest" type="checkbox" />
                        Guest
                    </label>
                </div>
            </div>
            <div class="col-md-9 breadcrumb">
                <ul class="list-unstyled list-inline">
                    <li class="active"><span class="hotkey">M</span>ain</li>
                    <li><span class="hotkey">D</span>etail</li>
                    <li><span class="hotkey">C</span>ommunication Log</li>
                    <li><span class="hotkey">S</span>pecial Remark</li>
                </ul>
            </div>
        </div>
        <div class="row contentbox">
            <div class="col-md-3 leftcontent">
                <iframe id="leftPanel" name="leftPanel" marginwidth="0" scrolling="auto" src="" marginheight="0"
                    frameborder="0" vspace="0" hspace="0" style="width: 100%; height: 100%;" allowtransparency="true">
                </iframe>
            </div>
            <div id="rightcontent" class="col-md-9 rightcontent">
                <iframe id="centerFr" name="centerFr" src="BlankPage" scrolling="auto" marginwidth="0"
                    marginheight="0" frameborder="0" vspace="0" hspace="0" style="width: 100%; height: 100%;"
                    allowtransparency="true"></iframe>
            </div>
        </div>
    </div>
