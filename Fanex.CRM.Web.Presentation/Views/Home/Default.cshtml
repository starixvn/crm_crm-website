@using Fanex.CRM.Infrastructure.Configuration
@using Fanex.CRM.Infrastructure.Common
@using Fanex.CRM.Infrastructure.Extension
@using Fanex.CRM.Entities
@using Fanex.CRM.Infrastructure.Resources
@using Fanex.CRM.Customer.Criteria
@using Fanex.CRM.Customer.Services.Implements
@{
    string userSearched = string.Empty;
    bool isGuest = false;

    GetCustomerInfoByUsernameCriteria getCustomerInfoByUsernameCriteria = new CustomerService().GetCustomerInfoByUsernameCriteria;
    if (getCustomerInfoByUsernameCriteria != null)
    {
        userSearched = getCustomerInfoByUsernameCriteria.Username;
        isGuest = getCustomerInfoByUsernameCriteria.IsGuest;
    }

    var getClientTime = Fanex.CRM.Infrastructure.Core.DateTimeUtilize.ChangeFullTimeZoneToClient(DateTime.Now);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <link href="@Url.Content("~/Content/site/ui-darkness/jquery-ui-1.8.14.custom.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/autocomplete/styles.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/Home/Styles/default.less?ver=5")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/site/customizeJqueryUI.less?ver=1")" rel="stylesheet" type="text/css" />
    @Styles.Render("~/Views/HomeStyles")
</head>
<body>
    @*<div id="fullsize" class="fullsize">
    </div>*@
    <div class="container crm-container">
        <div class="row header">
            <div class="col-xs-3 col-sm-3 col-md-3 leftHeader">
                <img alt="" src="~/Content/site/Images/logo-crm.png" class="crm-logo touchable-element" 
                    title="@Resources.Language.Home"
                    onclick="javascript:menuManager.getDashboardMenu(parent.dashboardManager.Enums.SubMenuId.Main);"
                    href="javascript:;"/>
                <span id="icon-collapse-expand-leftpanel" class="icon-expand" title="@Labels.Home_Index_CollapseExpandLeftPanel">
                </span>
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9 rightHeader">
                <div class="row">
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        @Html.Action("GettingUserMenu", new RouteValueDictionary(new { controller = "Home", area = "" }))
                    </div>
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        <div class="login-info pull-right">
                            @Labels.Welcome <span class="txt-username">@ViewBag.AccUsername</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row search-breadbrumb">
            <div class="col-xs-3 col-sm-3 col-md-3 search-frm">
                <div class="text-search col-xs-9 col-sm-9 col-md-9">
                    <input id="txtuserName" type="text" class="inputSearch font-style-italic" 
                        value="@Resources.Language.Default_SearchTextbox" 
                        name="txtuserName"
                        autocomplete="off" tabindex="2" />
                    <input id="buttonsearch" type="button" class="searchSubmit" value=" " tabindex="1" />
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3 checkbox check-guest">
                    <label>
                        <input id="isGuest" type="checkbox" tabindex="3" />
                        @Labels.Guest
                    </label>
                </div>
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9 breadcrumb">
                <div class="col-xs-9 col-sm-9 col-md-9" id="divSubMenu"></div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="pull-right timezone">
                        <span id="span-timezoneContainer">@getClientTime</span>
                        @Resources.Language.TimeZoneGMT
                    </div>
                </div>
            </div>
        </div>
        <div class="row contentbox">
            <div class="col-xs-3 col-sm-3 col-md-3 leftcontent">
                <iframe id="leftPanel" name="leftPanel" marginwidth="0" scrolling="auto" src="" marginheight="0"
                    frameborder="0" vspace="0" hspace="0" style="width: 100%; height: 100%;" allowtransparency="true">
                </iframe>
            </div>
            <div id="rightcontent" class="col-xs-9 col-sm-9 col-md-9 rightcontent">
                <iframe id="centerFr" name="centerFr" src="BlankPage" scrolling="auto" marginwidth="0"
                    marginheight="0" frameborder="0" vspace="0" hspace="0" style="width: 100%; height: 100%;"
                    allowtransparency="true"></iframe>
            </div>
        </div>
    </div>
    <div id="divErrorPoup" class="selector" style="display: none;">
    </div>
    <div id="div-resultpopup" class="selector display-none">
    </div>
    <script type="text/javascript" src="~/Scripts/jquery.js"></script>
    <script type="text/javascript" src="~/Scripts/json2.js"></script>
    <script type="text/javascript" src="~/Scripts/ShareScripts/CRMConstants.js"></script>
    <script type="text/javascript" src="~/Scripts/ShareScripts/SharedScriptManager.js"></script>
    <script type="text/javascript" src="~/Scripts/ShareScripts/KeyboardManager.js"></script>
    <script type="text/javascript" src="~/Scripts/ShareScripts/HotKeyManager.js"></script>
    <script type="text/javascript" src="~/Scripts/ShareScripts/DialogManager.js"></script>
    <script type="text/javascript" src="~/Scripts/jscookies.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery-ui-1.8.14.custom.js"></script>
    <script type="text/javascript" src="~/Scripts/autocomplete/jquery.autocomplete.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.blockUI.1.33.js"></script>
    <script type="text/javascript" src="~/Scripts/BlockUI.js"></script>
    <script type="text/javascript" src="~/Scripts/common.js"></script>
    @Scripts.Render("~/Scripts/PopUp")
    @Scripts.Render("~/CRM/Chart/Scripts")
    <script type="text/javascript" src="~/Views/Home/Scripts/Main.js?ver=1"></script>
    @Scripts.Render("~/Views/HomeScripts")
    @Scripts.Render("~/Views/Home/Dashboard/Scripts")
    <script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var userSearch = '@userSearched';
        var isGuestSearch = '@isGuest';
        var accUrlDefault = '@Fanex.CRM.Infrastructure.Common.AppSetting.LoginUrl';
        var userId = @(Fanex.CRM.Infrastructure.Common.AppSession.CurrentUser != null ? Fanex.CRM.Infrastructure.Common.AppSession.CurrentUser.Id : 0);
        var clientTime = "@getClientTime";
        setInterval('udpateOnlineStatus()', 20000);
    </script>
</body>
</html>
