@{
    bool hasCustomerInfoPermission = (bool)ViewBag.HasCustomerInfoPermission;
    var isCn88 = (ViewBag.UserRole == Fanex.CRM.Common.Enumerations.UserRole.CN88Staff);
    var hideClass = isCn88 ? "hide-item" : "";
}
<ul class="list-unstyled list-inline" id="ulDashboardMenu">
    <li class="active" id="liMain">
        <a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liMain');">
            @Html.Raw(Resources.Language.Tab_Main)
        </a>
    </li>
    @if (hasCustomerInfoPermission)
    {
        <li id="liDetail">
            <a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liDetail');">
                @Html.Raw(Resources.Language.Tab_Detail)                
            </a>
        </li>

            <li id="liCommnunicationLog">
                <a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liCommnunicationLog');">
                    @Html.Raw(Resources.Language.Tab_CommunicationLog)
                </a>
            </li>

            <li id="liSpecialRemark">
                <a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liSpecialRemark');">
                    @Html.Raw(Resources.Language.Tab_SpecialRemark)
                </a>
            </li>

            <li id="liRedemption" class="@hideClass">
                <a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liRedemption');">
                    @Html.Raw(Resources.Language.Tab_Redemption)
                </a>
            </li>

            <li id="liActivityLog">
                <a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liActivityLog');">
                    @Html.Raw(Resources.Language.Tab_ActivityLog)
                </a>
            </li>
    }
</ul>

