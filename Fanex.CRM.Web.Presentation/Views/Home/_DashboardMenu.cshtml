@using Fanex.NAP.Core.Business
@using Fanex.CRM.Service.Interface
@using Fanex.CRM.Service.Impl
@using Fanex.CRM.Infrastructure.Common
@{
    IPermissionService permission = new PermissionService();
}
<ul class="list-unstyled list-inline" id="ulDashboardMenu">
    <li class="active" id="liMain"><a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liMain');">
        <span class="hotkey">M</span>ain</a></li>
    @if (permission.HasPermission(FunctionPermission.CustomerInfo, Constant.Policy.Read))
    {
        <li id="liDetail"><a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liDetail');">
            <span class="hotkey">D</span>etail</a></li>
    }
    @if (permission.HasPermission(FunctionPermission.EditFeedback, Constant.Policy.Read))
    {
        <li id="liCommnunicationLog"><a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liCommnunicationLog');">
            <span class="hotkey">C</span>ommunication Log</a></li>
    }
    @if (permission.HasPermission(FunctionPermission.CustomerInfo, Constant.Policy.Read))
    {
        <li id="liSpecialRemark"><a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liSpecialRemark');">
            <span class="hotkey">S</span>pecial Remark</a></li>
    }
    @if (permission.HasPermission(FunctionPermission.RedemptionManagement, Constant.Policy.Read))
    {
        <li id="liRedemption"><a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liRedemption');">
            <span class="hotkey">R</span>edemption</a></li>
    }
    <li id="liActivityLog"><a href="javascript:;" onclick="javascript:dashboardManager.dashboardMenuClick('liActivityLog');">
        <span class="hotkey">A</span>ctivity Log</a></li>
</ul>
