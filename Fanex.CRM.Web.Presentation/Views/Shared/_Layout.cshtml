<!DOCTYPE html>
<html>
@{
    ViewBag.Title = Resources.Language.CRM_System;
}
<head>
    <title>@ViewBag.Title</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    @RazorHelper.RenderStyles("~/site/common")
    @RenderSection("Styles", required: false)   
    
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
</head>
<body>
@RenderBody()
@RazorHelper.RenderScripts("~/Scripts/CommonScripts", "~/Scripts/AngularJSLibrary")
<script src="~/Scripts/Global/site.js" type="text/javascript"></script>
@RazorHelper.RenderScripts("~/scripts/respond")
@RenderSection("Scripts", required: false)
</body>
</html>
