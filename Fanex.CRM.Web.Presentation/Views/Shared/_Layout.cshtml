@using Fanex.CRM.Common.Services
<!DOCTYPE html>
<html>
@{
    ViewBag.Title = Resources.Language.CRM_System;
}
<head>
    <title>@ViewBag.Title</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    @RazorHelper.RenderStyles("~/site/common")
    @RenderSection("Styles", required: false)
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
</head>
<body>
    @RenderBody()
    @RazorHelper.RenderScripts("~/Scripts/CommonScripts", "~/Scripts/AngularJSLibrary")
    <script src="~/Scripts/Global/site.js" type="text/javascript"></script>
    @RazorHelper.RenderScripts("~/scripts/respond")
    @RenderSection("Scripts", required: false)
    @if (string.IsNullOrWhiteSpace(AppSetting.PiwikSiteId) == false && AppSetting.Environment.Equals("Production", StringComparison.OrdinalIgnoreCase))
    {
        <script type="text/ecmascript">
            var piwikSiteId = '@AppSetting.PiwikSiteId';

            var _paq = _paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
                var u = "https://pw.detecas.com/";
                _paq.push(['setTrackerUrl', u + 'piwik.php']);
                _paq.push(['setSiteId', piwikSiteId]);
                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
            })();
        </script>
        <noscript>
            <p>
                <img src="https://pw.detecas.com/piwik.php?idsite=@(AppSetting.PiwikSiteId)'  style="border:0;" alt="" /></p>
        </noscript>
    }
</body>
</html>