<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta name="CRM" content="width=device-width" />
    <title>@Fanex.NAP.Core.Web.ViewResources.Offline</title>
    @RazorHelper.RenderStyles("~/Views/Common/Styles/UnderMaintenance.less")
</head>
<body>
    <div class="container">
        <h1>
            @Fanex.NAP.Core.Web.ViewResources.Maintenance</h1>
        <p>
            CRM is currently unavailable due to scheduled maintenance.<br />
            This downtime will last from <span class="em">@(ViewBag.UmtFrom)</span> &rarr; <span
                class="em">@(ViewBag.UmtTo)</span> (GMT+8). Thanks for your patience!
        </p>
    </div>
</body>
</html>
