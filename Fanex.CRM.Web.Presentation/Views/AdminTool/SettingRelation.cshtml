<link href="@Url.Content("~/Scripts/FanexGrid/FanexGrid.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/site/customizeFanexGrid.less?ver=1")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Views/AdminTool/Styles/StyleSheet.less")" rel="stylesheet" type="text/css" />
<div class="container main">
    @*<div class="row">
        Setting Relation</div>*@
    <div class="row filter-frm one-row settingRelation">
        <div class="item afterButton">
            <script type="text/html" id="tplMainSetting">
                                        <option value='${Type}'>${Type}</option>
            </script>
            <select id="ddlMainSetting" name="ddlMainSetting" style="width: 120px;">
            </select>
        </div>
        <div class="item">
            <input type="button" id="btnSearch" name="btnSearch" class="btn" value="Search" onclick="settingRelation.loadSettingRelation();" />
        </div>
    </div>
    <div class="row">
        <div id="settingrelationgrid" class="freegrid hidden">
            <div class="grid-title">
                <div class="grid-title-lable" id="gridtitle">
                </div>
            </div>
            <div class="free-cell free-top-left">
                <table class="grid-fixed-table free-cell-top-left">
                    <thead>
                        <tr>
                            <th>
                                <div style="height: 30px; width: 400px;" class="table-cell">
                                    Setting</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="row_header_wrapper">
                <div class="row_header row-headers-background">
                    <table class="grid-fixed-table row_header_content" id="settingrelationbg">
                        <thead>
                            <tr>
                                <th>
                                    <div style="height: 30px; width: 400px;" class="table-cell">
                                        Setting</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col_header row-headers-background scroll-y">
                <div class="header-container">
                    <table class="grid-fixed-table col_header_content">
                        <thead>
                            <tr>
                                <th>
                                    <div style="height: 30px; width: 400px;" class="table-cell">
                                        Setting</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 60px;" class="table-cell">
                                        Relation</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 80px;" class="table-cell">
                                        SettingID</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 60px;" class="table-cell">
                                        Order</div>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            <div class="grid-container container">
                <table id="settingrelationbody" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div style="height: 30px; width: 400px;" class="table-cell">
                                    Setting</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 60px;" class="table-cell">
                                    Relation</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 80px;" class="table-cell">
                                    SettingID</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 60px;" class="table-cell">
                                    Order</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="userId" name="userId" value="@Fanex.CRM.Infrastructure.Common.AppSession.CurrentUser.Id" />
<script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery.tmpl.js")")
                    .js("@Url.Content("~/Scripts/common.js")")
                    .js("@Url.Content("~/Scripts/showhidepopup.js")")
                    .js("@Url.Content("~/Scripts/FanexGrid/FanexGrid.js")")
                    .js("@Url.Content("~/Views/AdminTool/Scripts/SettingRelationManage.js?ver=1")");
            });   
</script>
