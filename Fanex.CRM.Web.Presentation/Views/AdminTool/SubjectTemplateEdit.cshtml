<link href="@Url.Content("~/Views/AdminTool/Styles/StyleSheet.less")" rel="stylesheet" type="text/css" />
<div class="container main popup">

    <div class="row">
        <div id="errMsg" class="col-xs-12 col-sm-12 col-md-5 errMsg">
        </div>
    </div>

    <div id="dvSettingIns" class="row">
        <form class="form-horizontal frm" role="form" id="tblSetting">
        <div class="form-group">
            <label class="col-xs-2 col-sm-2 col-md-2 control-label">
                Template ID</label>
            <div id="txtTemplateID" class="col-xs-9 col-sm-9 col-md-10">
            </div>
        </div>
        <div class="form-group">
            <label for="txtTemplateContent" class="col-xs-2 col-sm-2 col-md-2 control-label">
                Template Content</label>
            <div class="col-xs-9 col-sm-9 col-md-10">
                <input type="text" id="txtTemplateContent" name="txtTemplateContent" class="form-control textbox" />
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-9 col-sm-9 col-md-10">
                <button type="button" class="btn" onclick="udpFeedbackSubjectTemplate();">
                    Save</button>
            </div>
        </div>
        </form>
    </div>
</div>

<script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/common.js")")
                    .js("@Url.Content("~/Scripts/showhidepopup.js")")
                    .js("@Url.Content("~/Views/AdminTool/Scripts/SubjectTemplateEdit.js?ver=1")");
            });   
</script>
