<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link href="@Url.Content("~/Content/site/ui-darkness/jquery-ui-1.8.14.custom.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/Paging/pagination.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/FanexGrid/FanexGrid.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/AdminTool/Styles/StyleSheet.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
                <tr>
                    <td class="maincontent_headerL">
                        <img class="maincontent_iconLeft" alt="" src="../Content/site/Images/imgBg.png" />
                    </td>
                    <td class="maincontent_headerC">
                        Feedback Template Management
                    </td>
                    <td class="maincontent_headerR">
                    </td>
                </tr>
            </table>
            <div class="maincontent_box">
                <div class="filterContent" style="width: 100.4%">
                    <table>
                        <tr>
                            <td style="width: 55%">
                                <input id="txtTemplateSubject" name="txtTemplateSubject" type="text" onchange=""
                                    style="width: 430px; height:18px;" />
                            </td>
                            <td style="width: 10%">
                                <input type="button" id="btnSearch" name="btnSearch" class="btn" value="Search" onclick="fbSubjectTemplate.searchSubjectTemplate();" />
                            </td>
                            <td style="width: 35%">
                                <input type="button" id="btnInsertSetting" name="btnInsertTemplate" class="btn" value="Insert New Feedback Subject"
                                    onclick="ShowPopupAddSubjectTemplate(0);" style="width: 100%;" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <div id="errMsg">
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="bg_table" style="margin-top: 2px">
                    <div id="errmsg"></div>
                    <div id="feedbackTemplateManagementgrid" class="freegrid hidden">
                        <div class="free-cell free-top-left">
                            <table class="grid-fixed-table free-cell-top-left">
                                <thead>
                                    <tr>
                                        <th>
                                            <div style="height: 30px; width: 80px;" class="table-cell">
                                                Template Id</div>
                                        </th>
                                </thead>
                            </table>
                        </div>
                        <div class="row_header_wrapper">
                            <div class="row_header row-headers-background">
                                <table class="grid-fixed-table row_header_content" id="feedbackTemplateManagementbg">
                                    <thead>
                                        <tr>
                                            <th>
                                                <div style="height: 30px; width: 80px;" class="table-cell">
                                                    Template Id</div>
                                            </th>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col_header row-headers-background scroll-y">
                            <div class="header-container">
                                <table class="grid-fixed-table col_header_content">
                                    <thead>
                                        <tr>
                                            <th>
                                                <div style="height: 30px; width: 80px;" class="table-cell">
                                                    Template Id</div>
                                            </th>
                                            <th>
                                                <div style="height: 30px; width: 470px;" class="table-cell">
                                                    Feedback Subject Template Content</div>
                                            </th>                                        
                                            <th>
                                                <div style="height: 30px; width: 60px;" class="table-cell">
                                                    Edit</div>
                                            </th>
                                            <th>
                                                <div style="height: 30px; width: 60px;" class="table-cell">
                                                    Delete</div>
                                            </th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                        <div class="grid-container container">
                            <table id="feedbackTemplateManagementbody" class="grid-fixed-table col_header_content">
                                <thead>
                                    <tr>
                                        <th>
                                            <div style="height: 30px; width: 80px;" class="table-cell">
                                                Template Id</div>
                                        </th>
                                        <th>
                                            <div style="height: 30px; width: 470px;" class="table-cell">
                                                Feedback Subject Template Content</div>
                                        </th>                                        
                                        <th>
                                            <div style="height: 30px; width: 60px;" class="table-cell">
                                                Edit</div>
                                        </th>
                                        <th>
                                            <div style="height: 30px; width: 60px;" class="table-cell">
                                                Delete</div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="userId" name="userId" value="@Fanex.CRM.Infrastructure.Common.AppSession.CurrentUser.Id" />
    <div id="divPopup" class="selector" style="display: none;"></div>

    <script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.min.js")")
                    .js("@Url.Content("~/Scripts/common.js")")
                    .js("@Url.Content("~/Scripts/showhidepopup.js")")
                    .js("@Url.Content("~/Scripts/Paging/jpager.js")")
                    .js("@Url.Content("~/Scripts/FanexGrid/FanexGrid.js?ver=4")")
                    .js("@Url.Content("~/Scripts/autocomplete/jquery.autocomplete.client.js")",
                        "@Url.Content("~/Scripts/autocomplete/jquery.highlight-3.js")")
                    .js("@Url.Content("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")")
                    .js("@Url.Content("~/Views/AdminTool/Scripts/SubjectTemplateManagement.js?ver=3")");
            });   
    </script>
</body>
</html>
