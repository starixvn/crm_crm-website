<link href="@Url.Content("~/Views/AdminTool/Styles/StyleSheet.less")" rel="stylesheet" type="text/css" />
<div class="container main popup">
    <div class="row">
        <div id="errMsg" class="col-xs-7 col-sm-7 col-md-5 errMsg">
        </div>
    </div>
    <div class="row">
        <form class="form-horizontal frm" role="form">
        <div class="form-group">
            <label for="txtSettingName" class="col-xs-3 col-sm-3 col-md-2 control-label">
                Setting Name</label>
            <div class="col-xs-9 col-sm-9 col-md-10">
                <input type="text" id="txtSettingName" name="txtSettingName" class="form-control textbox" />
            </div>
        </div>
        <div class="form-group">
            <label for="txtSettingValue" class="col-xs-3 col-sm-3 col-md-2 control-label">
                Setting Value</label>
            <div class="col-xs-9 col-sm-9 col-md-10">
                <input type="text" id="txtSettingValue" name="txtSettingValue" class="form-control textbox" />
            </div>
        </div>
        <div class="form-group">
            <label for="txtDisplayOrder" class="col-xs-3 col-sm-3 col-md-2 control-label">
                Display Order</label>
            <div class="col-xs-9 col-sm-9 col-md-10">
                <input type="text" id="txtDisplayOrder" name="txtDisplayOrder" class="form-control textbox"
                    onkeypress="return CheckDecNumber(event);" />
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-offset-3 col-sm-offset-3 col-md-offset-2 col-xs-9 col-sm-9 col-md-10">
                <button type="submit" class="btn" onclick="udpSetting();">
                    <span class="hotkey">S</span>ave</button>
            </div>
        </div>
        </form>
    </div>
</div>
<input type="hidden" id="userId" name="userId" value="@Fanex.CRM.Infrastructure.Common.AppSession.CurrentUser.Id" />
<script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/common.js")")
                    .js("@Url.Content("~/Scripts/showhidepopup.js")")
                    .js("@Url.Content("~/Views/AdminTool/Scripts/SettingEdit.js?ver=1")");
            });   
</script>
