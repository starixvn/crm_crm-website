<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link href="@Url.Content("~/Content/site/ui-darkness/jquery-ui-1.8.14.custom.css")" rel="stylesheet" type="text/css" />    
    <link href="@Url.Content("~/Scripts/FanexGrid/FanexGrid.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/site/customizeFanexGrid.less?ver=1")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/AdminTool/Styles/StyleSheet.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
                <tr>
                    <td class="maincontent_headerL">
                        <img class="maincontent_iconLeft" alt="" src="../Content/site/Images/imgBg.png" />
                    </td>
                    <td class="maincontent_headerC">
                        Setting Management
                    </td>
                    <td class="maincontent_headerR">
                    </td>
                </tr>
            </table>
            <div class="maincontent_box">
                <div class="filterContent" style="width: 100.4%">
                    <table>
                        <tr>
                            <td>
                                <script type="text/html" id="tplMainSetting">
                                    <option value='${Type}'>${Type}</option>
                                </script>
                                <select id="ddlMainSetting" name="ddlMainSetting" onchange="settingManagement.loadSettingManagement();"
                                    style="width: 120px;">
                                </select>
                            </td>
                            <td>
                                <input type="button" id="btnSearch" name="btnSearch" class="btn" value="Search" onclick="settingManagement.loadSettingManagement();" />
                            </td>
                            <td>
                                <input type="button" id="btnInsertSetting" name="btnInsertSetting" class="btn" value="Insert New Setting"
                                    onclick="ShowPopupAddSetting(0);" />
                            </td>
                            <td>
                                <input type="button" id="btnInsertSubSetting" name="btnInsertSubSetting" class="btn"
                                    value="Insert Setting value for " onclick="ShowPopupAddSetting(1);" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <div id="errMsg">
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="bg_table" style="margin-top: 2px">
                    
                    <div id="settingManagementgrid" class="freegrid hidden">
                        <div class="grid-title">
                            <div class="grid-title-lable" id="gridtitle">
                            </div>                            
                        </div>
                        <div class="free-cell free-top-left">
                            <table class="grid-fixed-table free-cell-top-left">
                                <thead>
                                    <tr>
                                        <th>
                                            <div style="height: 30px; width: 400px;" class="table-cell">
                                                Setting</div>
                                        </th>
                                    </tr>
                                </thead>
                            </table>
                        </div>       
                        <div class="row_header_wrapper">                 
                            <div class="row_header row-headers-background">
                                <table class="grid-fixed-table row_header_content" id="settingManagementheader">
                                    <thead>
                                        <tr>
                                            <th>
                                                <div style="height: 30px; width: 400px;" class="table-cell">
                                                    Setting</div>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col_header row-headers-background scroll-y">
                            <div class="header-container">
                                <table class="grid-fixed-table col_header_content">
                                    <thead>
                                        <tr>
                                            <th>
                                                <div style="height: 30px; width: 400px;" class="table-cell">
                                                    Setting</div>
                                            </th>
                                            <th>
                                                <div style="height: 30px; width: 80px;" class="table-cell">
                                                    SettingID</div>
                                            </th>
                                            <th>
                                                <div style="height: 30px; width: 60px;" class="table-cell">
                                                    Order</div>
                                            </th>
                                            <th>
                                                <div style="height: 30px; width: 60px;" class="table-cell">
                                                    Edit</div>
                                            </th>
                                            <th>
                                                <div style="height: 30px; width: 60px;" class="table-cell">
                                                    Delete</div>
                                            </th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                        <div class="grid-container container">
                            <table id="settingManagementbody" class="grid-fixed-table col_header_content">
                                <thead>
                                    <tr>
                                        <th>
                                            <div style="height: 30px; width: 400px;" class="table-cell">
                                                Setting</div>
                                        </th>
                                        <th>
                                            <div style="height: 30px; width: 80px;" class="table-cell">
                                                SettingID</div>
                                        </th>
                                        <th>
                                            <div style="height: 30px; width: 60px;" class="table-cell">
                                                Order</div>
                                        </th>
                                        <th>
                                            <div style="height: 30px; width: 60px;" class="table-cell">
                                                Edit</div>
                                        </th>
                                        <th>
                                            <div style="height: 30px; width: 60px;" class="table-cell">
                                                Delete</div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="userId" name="userId" value="@Fanex.CRM.Infrastructure.Common.AppSession.CurrentUser.Id" />
    <div id="divPopup" class="selector" style="display: none;"></div>

    <script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.min.js")",
                        "@Url.Content("~/Scripts/jquery.tmpl.js")")
                    .js("@Url.Content("~/Scripts/FanexGrid/FanexGrid.js")")
                    .js("@Url.Content("~/Scripts/common.js")")
                    .js("@Url.Content("~/Scripts/showhidepopup.js")")
                    .js("@Url.Content("~/Views/AdminTool/Scripts/SettingManage.js?ver=1")");
            });   
    </script>
</body>
</html>
