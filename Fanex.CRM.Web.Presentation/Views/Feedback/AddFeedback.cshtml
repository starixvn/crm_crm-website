    <div class="row panel-group">
        <div class="row title">
            <div class="pull-left hand" onclick="showHideDetailBox(isShowDescriptionBox, 'FeedbackDescription'); isShowDescriptionBox = !isShowDescriptionBox;">
                Description<span class="hidden error errormsg" id="deseditererror"></span>
            </div>
            <div class="pull-right">
                <input type="button" class="btnreview " value="Preview" id="btndesreview" onclick="initReview('des');" />
                <input type="button" class="btnedit hidden" value="Edit" id="btndesedit" onclick="initEdit('des');" />
            </div>
        </div>
        <div class="FeedbackDescription row content">
            <div class="editerwrapper" id="descriptionwrapper">
                <div id="previewboxdes" class="hidden">
                </div>
                <div id="editboxdes">
                </div>
            </div>
        </div>
    </div>

    <div class="row panel-group">
        <div class="row title">
            <div class="pull-left hand" onclick="showHideDetailBox(isShowSolutionBox, 'FeedbackSolution'); isShowSolutionBox = !isShowSolutionBox;">
                Solution<span class="hidden error errormsg" id="soleditererror"></span>
            </div>
            <div class="pull-right">
                <input type="button" class="btnreview " value="Preview" id="btnsolreview" onclick="initReview('sol');" />
                <input type="button" class="btnedit hidden" value="Edit" id="btnsoledit" onclick="initEdit('sol');" />
            </div>
        </div>
        <div class="FeedbackSolution row content">
            <div class="editerwrapper" id="solutionwrapper">
                <div id="previewboxsol" class="hidden">
                </div>
                <div id="editboxsol">
                </div>
            </div>
        </div>
    </div>

    <div class="row panel-group">
        <div class="row title hidden">
            <div class="pull-left hand" id="reviewtitle" onclick="showHideDetailBox(isShowReviewBox, 'FeedbackReview'); isShowReviewBox = !isShowReviewBox;">
                Review <span id="divisreview" class="">
                    <input type="checkbox" id="chkisreview" onclick="EnableUpdateReview(this);" style="float: left;
                        display: block;" />
                </span>
            </div>
            <div class="pull-right" id="editreview" style="display: none;">
                <input type="button" class="btnreview  hidden" value="Preview" id="btnrevreview"
                    onclick="initReview('rev');" />
                <input type="button" class="btnedit " value="Edit" id="btnrevedit" onclick="initEdit('rev');" />
            </div>
        </div>
        <div class="row content hidden FeedbackReview" id="reviewbox">
            <div class="editerwrapper" id="reviewwrapper">
                <div id="previewboxrev">
                </div>
                <div id="editboxrev" class="hidden">
                </div>
            </div>
        </div>
    </div>

    <div class="row btn-group">
        <button class="btn" onclick="AddFeedback();">
            Save</button>
    </div>
</div>

