@using Fanex.CRM.Infrastructure.Common
@using Fanex.NAP.Core.Business

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/Tipsy-Tooltip/tipsy.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/InputBox/style.css")" rel="stylesheet" type="text/css" />
    
    <link href="@Url.Content("~/Content/site/ui-darkness/jquery-ui-1.8.14.custom.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/Feedback/Styles/StyleSheet.css?ver=1")" rel="stylesheet" type="text/css" />    
</head>
<body>
   
    <!--Template area-->
    <script id="tmplOption" type="text/x-jquery-tmpl">
        <option value="${Id}">${Value}</option>
    </script>
    <script id="tmplCountry" type="text/x-jquery-tmpl">
        <option value="${Id}">${CountryName}</option>
    </script>
    <!--/Template area-->
    <div class="main">
        <div class="maincontent">
            <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
                <tr>
                    <td class="maincontent_headerL">
                        <img class="maincontent_iconLeft" alt="" src="../Content/site/Images/imgBg.png" />
                    </td>
                    <td class="maincontent_headerC">
                        Add Customer Feedback
                    </td>
                    <td class="maincontent_headerR">
                    </td>
                </tr>
            </table>
            <div class="bg_table">
                <div class="errmsg" id="errmsg">
                </div>
                <div id="sContent" style="">
                    <table class="tblcollapse" style="width: 100%; text-align: left">
                        <tr>
                            <td colspan="4">
                                <input type="button" onclick="AddFeedback();" class="btn" id="btnsubmit" value="Submit"
                                    disabled />
                            </td>
                        </tr>
                        <tr class="title">
                            <td colspan="4" class="c">
                                <input type="button" id="btnShowHideCustInfo" class="updown" value="" onclick="downup('btnShowHideCustInfo', 'CustInfo')" />
                                <b><span id="lblUserName" value="">
                                    <!--UserName-->
                                </span></b>
                            </td>
                        </tr>
                        <tr class="CustInfo solid_bottom">
                            <td style="border-right: 0px; width: 25%" class="b">
                                Title
                            </td>
                            <td style="border-left: 0px; width: 75%" colspan="3">
                                <select id="ddltitle">
                                </select>
                            </td>
                        </tr>
                        <tr class="CustInfo solid_bottom">
                            <td class="b" style="border-right: 0px">
                                First Name
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <input type="text" id="txtfirstname" />
                            </td>
                            <td class="b" style="border-right: 0px">
                                Last Name
                            </td>
                            <td style="border-left: 0px">
                                <input type="text" id="txtlastname" />
                            </td>
                        </tr>
                        <tr class="CustInfo solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Phone
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <input type="text" id="txtphone" />
                            </td>
                            <td class="b" style="border-right: 0px">
                                Mobile Phone
                            </td>
                            <td style="border-left: 0px">
                                <input type="text" id="txtmobilephone" />
                            </td>
                        </tr>
                        <tr class="CustInfo solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Fax
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <input type="text" id="txtfax" />
                            </td>
                            <td class="b" style="border-right: 0px">
                                Email
                            </td>
                            <td style="border-left: 0px">
                                <input type="text" id="txtEmail" />
                            </td>
                        </tr>
                        <tr class="CustInfo solid_bottom">
                            <td class="b" style="border-right: 0px">
                                PIC1
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <input type="text" id="txtPIC1" />
                            </td>
                            <td class="b" style="border-right: 0px">
                                MSN
                            </td>
                            <td style="border-left: 0px">
                                <input type="text" id="txtMSN" />
                            </td>
                        </tr>
                        <tr class="CustInfo solid_bottom">
                            <td class="b" style="border-right: 0px">
                                PIC2
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <input type="text" id="txtPIC2" />
                            </td>
                            <td class="b" style="border-right: 0px">
                                Skype
                            </td>
                            <td style="border-left: 0px">
                                <input type="text" id="txtSkype" />
                            </td>
                        </tr>
                        <tr class="CustInfo solid_bottom">
                            <td class="b" style="border-right: 0px">
                                PIC3
                            </td>
                            <td colspan="3" style="border-left: 0px;">
                                <input type="text" id="txtPIC3" />
                            </td>
                        </tr>
                        <tr class="CustInfo solid_bottom">
                            <td colspan="4" class="b" style="border-right: 0px">
                                <input type="checkbox" id="chkIsOverrideCrmInfo" style="float:left; display:block;" />
                                &nbsp; Overwrite current CRM Info
                            </td>
                        </tr>
                        <tr class="title">
                            <td colspan="4">
                                <input type="button" id="btnShowHideDetail" class="updown" value="" onclick="downup('btnShowHideDetail', 'FeedbackDetail')" />
                                <b>Details</b>
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Feedback Date
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <input type="text" id="txtdate" class="txtcalendar" readonly />
                            </td>
                            <td class="b" style="border-right: 0px">
                                CS Extension/Station
                            </td>
                            <td style="border-left: 0px">
                                <select id="ddlcsextension">
                                </select>
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Resolution Time
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <input type="text" id="txtResolutionTime" class="txtcalendar" readonly />
                            </td>
                            <td class="b" style="border-right: 0px">
                                Country
                            </td>
                            <td style="border-left: 0px">
                                <select id="ddlcountry" name="D1">
                                </select>
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Communication
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <select id="ddlcommunication">
                                </select>
                                <span class="hidden error errormsg" id="errorcommunication"></span>
                            </td>
                            <td class="b" style="border-right: 0px">
                                Language
                            </td>
                            <td style="border-left: 0px">
                                <select id="ddllanguage">
                                </select>
                                <span class="hidden error errormsg" id="errorlanguage"></span>
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Category
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <select id="ddlcategory" onchange="bindingChildByParentId('ddlsubcategory', AllSetting.Category, $('#ddlcategory').val());  ">
                                </select>
                            </td>
                            <td class="b" style="border-right: 0px">
                                SubCategory
                            </td>
                            <td style="border-left: 0px">
                                <select id="ddlsubcategory">
                                </select>
                                <input type="hidden" id="hIsNotChild" value="0" />
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Product
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <select id="ddlproduct" onchange="bindingChildByParentId('ddlbettype', AllSetting.Product, $('#ddlproduct').val());">
                                </select>
                            </td>
                            <td class="b" style="border-right: 0px">
                                Bet Type
                            </td>
                            <td style="border-left: 0px">
                                <select id="ddlbettype">
                                </select>
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Status
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <select id="ddlstatus" name="D2">
                                </select>
                            </td>
                            <td class="b" style="border-right: 0px">
                                Site
                            </td>
                            <td style="border-left: 0px">
                                <select id="ddlsite">
                                </select>
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right: 0px">
                                Role
                            </td>
                            <td style="border-left: 0px; border-right:1px solid #E5E5E5;">
                                <select id="ddlrole" name="D3">
                                </select>
                                <span id="errorrole" class="error errormsg hidden"></span>
                            </td>
                            <td class="b" style="border-right: 0px">
                                Response
                            </td>
                            <td style="width: 30%" style="border-left: 0px">
                                <select id="ddlresponse">
                                </select>
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right:1px solid #E5E5E5;">
                                <input type="checkbox" id="chkisrelated" onclick="checkIsRelated(this);" style="float:left; display:block;" />
                                Is Related to Customer
                            </td>
                            <td colspan="3">
                                <table>
                                    <tr>
                                        <td style="border: 0px">
                                            <input type="button" value="  " id="btnRelatedHelp" class="btnHelp" title="Related Help" />
                                        </td>
                                        <td style="border: 0px">
                                            <select id="txtrelatedcustomer" name="txtrelatedcustomer" disabled>
                                            </select>
                                        </td>
                                        <td style="border: 0px">
                                            <input type="button" onclick="verifyUserName();" class="btn" id="btnverify" value="Verify"
                                                disabled />
                                        </td>
                                    </tr>
                                    <tr class="hidden">
                                        <td style="border: 0px">
                                        </td>
                                        <td colspan='2' style="border: 0px">
                                            <span class="" id="lblverify" value="0"></span>
                                        </td>
                                    </tr>
                                    <tr id="ColorGuide" class="hidden">
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px" colspan='2'>
                                            <table style="width:100%">
                                                <tr>
                                                <td style="border: 0px; width:5%"><div style="border:1 solid green ; background-color:green; width:30px; height:10px"></div></td>
                                                <td style="border: 0px; width:25%">Customer</td>
                                                <td style="border: 0px; width:5%"><div style="border:1 solid #0066CC ; background-color:#0066CC; width:30px; height:10px"></div></td>
                                                <td style="border: 0px; width:25%">Guest</td>
                                                <td style="border: 0px; width:5%"><div style="border:1 solid red ; background-color:red; width:30px; height:10px"></div></td>
                                                <td style="border: 0px; width:25%">Invalid</td>
                                                </tr>
                                            </table>
                                        </td>     
                                    </tr>
                                    <tr id="trRelatedInfo" class="hidden">
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px">
                                            <table id="related">
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr class="FeedbackDetail solid_bottom">
                            <td class="b" style="border-right:1px solid #E5E5E5;">
                                Subject
                            </td>
                            <td colspan="3">
                                <input type="text" id="txtsubject" style="width: 500px;" /><span class="hidden error errormsg"
                                    id="errorsubject"></span>
                            </td>
                        </tr>
                        <tr class="title">
                            <td colspan="4">
                                <div class="lblediter">
                                    <input type="button" id="btnShowHideDescription" class="updown" value="" onclick="downup('btnShowHideDescription', 'FeedbackDescription')" />
                                    Description <span class="hidden error errormsg" id="deseditererror"></span>
                                </div>
                                <div class="editreview">
                                    <input type="button" class="btnreview " value="Preview" id="btndesreview" onclick="initReview('des');" /><input
                                        type="button" class="btnedit hidden" value="Edit" id="btndesedit" onclick="initEdit('des');" /></div>
                            </td>
                        </tr>
                        <tr class="FeedbackDescription">
                            <td colspan="4">
                                <div class="editerwrapper" id="descriptionwrapper">
                                    <div id="previewboxdes" class="hidden">
                                    </div>
                                    <div id="editboxdes">
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="title">
                            <td colspan="4">
                                <div class="lblediter">
                                    <input type="button" id="btnShowHideSolution" class="updown" value="" onclick="downup('btnShowHideSolution', 'FeedbackSolution')" />
                                    Solution <span class="hidden error errormsg" id="soleditererror"></span>
                                </div>
                                <div class="editreview">
                                    <input type="button" class="btnreview " value="Preview" id="btnsolreview" onclick="initReview('sol');" /><input
                                        type="button" class="btnedit hidden" value="Edit" id="btnsoledit" onclick="initEdit('sol');" /></div>
                            </td>
                        </tr>
                        <tr class="FeedbackSolution">
                            <td colspan="4">
                                <div class="editerwrapper" id="solutionwrapper">
                                    <div id="previewboxsol" class="hidden">
                                    </div>
                                    <div id="editboxsol">
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="title hidden" id="reviewtitle">
                            <td colspan="4">
                                <div class="lblediter">
                                    Review
                                    <input type="checkbox" id="chkisreview" onclick="EnableUpdateReview(this);" />
                                    <span id="lblUpdateReview"></span>
                                </div>
                                <div class="editreview" id="editreview" style="display: none;">
                                    <input type="button" class="btnreview hidden" value="Preview" id="btnrevreview" onclick="initReview('rev');" />
                                    <input type="button" class="btnedit " value="Edit" id="btnrevedit" onclick="initEdit('rev');" /></div>
                            </td>
                        </tr>
                        <tr id="reviewbox" class="hidden">
                            <td colspan="4">
                                <div class="editerwrapper" id="reviewwrapper">
                                    <div id="previewboxrev">
                                    </div>
                                    <div id="editboxrev" class="hidden">
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4">
                                <input type="button" class="btn" id="btnsubmitbottom" onclick="AddFeedback();" value="Submit" disabled />
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="hServerTime" />

    <div id="divOverrideCRMInfo" class="selector" style="display: none;">
    </div>    
       @{
           Fanex.CRM.Service.Interface.IPermissionService permission = new Fanex.CRM.Service.Impl.PermissionService();
           var getClientTime = Fanex.CRM.Infrastructure.Core.DateTimeUtilize.ChangeTimeZoneToClient(DateTime.Now);
           }
    <script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var accname = "@AppSession.CurrentUser.Username";
         var accId = @AppSession.CurrentUser.Id;
         var errorMsg = "@Resources.ErrorMsg.lblErrorInputRequiredDate";
         var errorMsgInvalidUser="@Resources.ErrorMsg.lblInvalidUserName";
         var successMsg="@Resources.ErrorMsg.lblAddFeedbackSuccess";
         var desvalue = "";
         var solvalue = "";
         var revvalue = "";
         var allowUpdateReview='@(false).ToString().ToLower()';
         var inputMultipleRelatedNote="@Resources.Language.lblInputMultipleRealteFeedbackCustomerNote";
         var errMsgFeedbackDateGreatter='@Resources.ErrorMsg.lblFeedbacDateShouldBeSmallerThanCurrentDate';
         var errMsgResolutionDateGreatter='@Resources.ErrorMsg.lblFeedbackDateShouldBeSmallerThanResolutionTime';
         var allowDeleteFeedback = @permission.HasPermission(FunctionPermission.DeleteFeedback, Constant.Policy.Host).ToString().ToLower();
         var clientTime = '@getClientTime';

        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.min.js")",
                        "@Url.Content("~/Scripts/jquery-ui-timepicker-addon.js")")
                    .js("@Url.Content("~/Scripts/jquery.tmpl.js")")
                    .js("@Url.Content("~/Scripts/autocomplete/jquery.autocomplete.client.js")")
                    .js("@Url.Content("~/Scripts/autocomplete/jquery.highlight-3.js")")
                    .js("@Url.Content("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")")
                    .js("@Url.Content("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")",
                        "@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")")
                    .js("@Url.Content("~/Scripts/stdlib.js")")
                    .js("@Url.Content("~/Scripts/dialogbox.js")")
                    .js("@Url.Content("~/Scripts/common.js")")
                    .js("@Url.Content("~/Scripts/Tipsy-Tooltip/jquery.tipsy.js")")
                    .js("@Url.Content("~/Scripts/InputBox/jquery.fcbkcomplete.js?ver=4")")
                    .js("@Url.Content("~/Views/Feedback/Scripts/FeedbackCommon.js?ver=2")")
                    .js("@Url.Content("~/Views/Feedback/Scripts/addfeedback.js?ver=1")");
            });   
    </script>
</body>
</html>
