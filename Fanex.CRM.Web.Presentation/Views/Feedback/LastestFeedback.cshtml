@using Fanex.CRM.Infrastructure.Common

<link href="@Url.Content("~/Scripts/Tipsy-Tooltip/tipsy.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Scripts/FanexGrid/FanexGrid.css?ver=1")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/site/customizeFanexGrid.less?ver=1")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Views/Feedback/Styles/StyleSheet.less?ver=1")" rel="stylesheet" type="text/css" />

<div class="main container">
    <div class="row topSelected">
        <label for="selectTopFeedback">
            Top
        </label>
        <select id="selectTopFeedback" class="selectTopFeedback" onchange="topFeedback.loadLastedFeedback(false);HideTooltip(0);">
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="30">30</option>
            <option value="40">40</option>
            <option value="50">50</option>
        </select>
    </div>
    
    <div class="row">
        <div class="col-xs-7 col-sm-7 col-md-5 errmsg" id="errmsg">
        </div>
    </div>

    <div class="row">
        <div id="lastedfeedbackgrid" class="freegrid hidden hasTopSelected">
            <div class="grid-title">
                <div class="grid-title-lable" id="gridtitle">
                    Title</div>
                <div class="grid-toolbox">
                </div>
            </div>
            <div class="free-cell free-top-left">
                <table class="grid-fixed-table free-cell-top-left">
                    <thead>
                        <tr>
                            <th>
                                <div style="height: 30px; width: 450px;" class="table-cell">
                                    Feedback</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="row_header_wrapper">
                <div class="row_header row-headers-background">
                    <table class="grid-fixed-table row_header_content" id="latestfeedbackbodyHeader">
                        <thead>
                            <tr>
                                <th>
                                    <div style="height: 30px; width: 450px;" class="table-cell">
                                        Feedback</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col_header row-headers-background scroll-y">
                <div class="header-container">
                    <table class="grid-fixed-table col_header_content">
                        <thead>
                            <tr>
                                <th>
                                    <div style="height: 30px; width: 450px;" class="table-cell">
                                        Feedback</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 270px;" class="table-cell">
                                        Category</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 50px;" class="table-cell">
                                        Status</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 160px;" class="table-cell">
                                        Related Customer</div>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            <div class="grid-container container">
                <table id="latestfeedbackbody" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div style="height: 30px; width: 450px;" class="table-cell">
                                    Feedback</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 270px;" class="table-cell">
                                    Category</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 50px;" class="table-cell">
                                    Status</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 160px;" class="table-cell">
                                    Related Customer</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>    
</div>
<div class="hidden" id="divDescriptions">
</div>
@{string userName = Request["custName"];}
<script language="javascript" type="text/javascript">
        parent.document.title = '@Resources.Language.Title_LatestFeedback';
        window.rootUrl = '@Url.Content("~")';
        var accname = '@AppSession.CurrentUser.Username';
        var accId = @AppSession.CurrentUser.Id;
        var custName = '@userName';

        head.js("@Url.Content("~/Scripts/jquery.js?ver=2")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.js")",
                        "@Url.Content("~/Scripts/stdlib.js")")
                    .js("@Url.Content("~/Scripts/common.js?ver=2")")
                    .js("@Url.Content("~/Scripts/Tipsy-Tooltip/jquery.tipsy.js")")
                    .js("@Url.Content("~/Scripts/FanexGrid/FanexGrid.js?ver=1")")
                    .js("@Url.Content("~/Views/Feedback/Scripts/FeedbackCommon.js?ver=2")")
                    .js("@Url.Content("~/Views/Feedback/Scripts/LastestFeedback.js?ver=6")");
            });   
</script>
