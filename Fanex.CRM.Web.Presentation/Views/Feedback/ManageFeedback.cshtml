@using Fanex.CRM.Infrastructure.Common
<link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Scripts/Paging/pagination.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Scripts/FanexGrid/FanexGrid.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/site/customizeFanexGrid.less?ver=1")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Views/Feedback/Styles/StyleSheet.less?ver=1")" rel="stylesheet" type="text/css" />
<script id="tmplOption" type="text/x-jquery-tmpl">
        <option value="${Id}">${Value}</option>
</script>
<div class="main container">
    <div class="row filter-frm one-row redemption-filter">
        <div class="row row-item">
            <div class="item">
                <label for="txtusername" class="width-80">
                    Username</label>
                <input type="text" id="txtusername" class="textbox txtUsername" />
                &nbsp;
                <select id="ddlguest">
                    <option value="-1">All</option>
                    <option value="0">Customer</option>
                    <option value="1">Guest</option>
                </select>
            </div>
            <div class="item">
                <label for="txtfromdate" class="width-80">
                    From date</label>
                <input type="text" id="txtfromdate" readonly="readonly" class="textbox txtcalendar" />
            </div>
            <div class="item">
                <label for="txttodate">
                    To date</label>
                <input type="text" id="txttodate" readonly="readonly" class="textbox txtcalendar" />
            </div>
            <div class="item">
                <button class="btn" onclick="lastedFeedback.loadLastedFeedback(false);">
                    <span class="hotkey">S</span>ubmit</button>
            </div>
        </div>
        <div class="row row-item">
            <div class="item">
                <label for="ddlcategory" class="width-80">
                    Main Category</label>
                <select id="ddlcategory" class="selMainCategory" onchange="bindingManageChildByParentId('ddlsubcategory', AllSetting.Category, $('#ddlcategory').val());">
                    <option value="0">All</option>
                </select>
            </div>
            <div class="item">
                <label for="ddlsubcategory" class="width-80">
                    SubCategory</label>
                <select id="ddlsubcategory" class="selSubCategory">
                    <option value="0">All</option>
                </select>
            </div>
        </div>
        <div class="row row-item">
            <div class="item">
                <label for="ddlcommunication" class="width-80">
                    Communication</label>
                <select id="ddlcommunication" class="selCommunication">
                    <option value="0">All</option>
                </select>
            </div>
            <div class="item">
                <label for="ddlstatus">
                    Status</label>
                <select id="ddlstatus" class="selStatus">
                    <option value="0">All</option>
                </select>
            </div>
            <div class="item">
                <label for="ddlIsReviewed" class="width-80">
                    IsReviewed</label>
                <select id="ddlIsReviewed" class="selReviewed">
                    <option value="0">All</option>
                    <option value="-1">Not reviewed</option>
                    <option value="1">Reviewed</option>
                </select>
            </div>
            <div class="item">
                <label for="ddlCustomerReponse">
                    Customer Response</label>
                <select id="ddlCustomerReponse" class="selResponse">
                    <option value="0">All</option>
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-7 col-sm-7 col-md-5 errmsg" id="errmsg">
        </div>
    </div>
    <div class="row">
        <div id="lastedfeedbackgrid" class="freegrid hidden">
            <div class="free-cell free-top-left">
                <table class="grid-fixed-table free-cell-top-left">
                    <thead>
                        <tr>
                            <th>
                                <div style="height: 30px; width: 380px;" class="table-cell">
                                    Feedback</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="row_header_wrapper">
                <div class="row_header row-headers-background">
                    <table class="grid-fixed-table row_header_content" id="latestfeedbackbodyHeader">
                        <thead>
                            <tr>
                                <th>
                                    <div style="height: 30px; width: 380px;" class="table-cell">
                                        Feedback</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col_header row-headers-background scroll-y">
                <div class="header-container">
                    <table class="grid-fixed-table col_header_content">
                        <thead>
                            <tr>
                                <th>
                                    <div style="height: 30px; width: 380px;" class="table-cell">
                                        Feedback</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 130px;" class="table-cell">
                                        Customer</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 200px;" class="table-cell">
                                        Category</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 50px;" class="table-cell">
                                        Status</div>
                                </th>
                                <th>
                                    <div style="height: 30px; width: 200px;" class="table-cell">
                                        Related Customer</div>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            <div class="grid-container container">
                <table id="latestfeedbackbody" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div style="height: 30px; width: 380px;" class="table-cell">
                                    Feedback</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 130px;" class="table-cell">
                                    Customer</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 200px;" class="table-cell">
                                    Category</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 50px;" class="table-cell">
                                    Status</div>
                            </th>
                            <th>
                                <div style="height: 30px; width: 200px;" class="table-cell">
                                    Related Customer</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var accname = "@AppSession.CurrentUser.Username";
        var accId = @AppSession.CurrentUser.Id;

        head.js("@Url.Content("~/Scripts/jquery.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.js")",
                        "@Url.Content("~/Scripts/jquery-ui-timepicker-addon.js")",
                        "@Url.Content("~/Scripts/jquery.tmpl.js")",
                        "@Url.Content("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")",
                        "@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")",
                        "@Url.Content("~/Scripts/stdlib.js")")                    
                    .js("@Url.Content("~/Scripts/common.js?ver=1")")
                    .js("@Url.Content("~/Scripts/Paging/jpager.js")")
                    .js("@Url.Content("~/Scripts/FanexGrid/FanexGrid.js")")
                    .js("@Url.Content("~/Views/Feedback/Scripts/FeedbackCommon.js?ver=1")",
                        "@Url.Content("~/Views/Feedback/Scripts/ManageFeedback.js?ver=5")");
            });   
</script>
