@using Fanex.CRM.Infrastructure.Common
@using Fanex.NAP.Core.Business
<link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Scripts/Tipsy-Tooltip/tipsy.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Scripts/InputBox/style.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Scripts/MultipleSelect/fanex.multiSelect.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Views/Feedback/Styles/StyleSheet.less")" rel="stylesheet" type="text/css" />
<!--Template area-->
<script id="tmplOption" type="text/x-jquery-tmpl">
        <option value="${Id}">${Value}</option>
</script>
<script id="tmplCountry" type="text/x-jquery-tmpl">
        <option value="${Id}">${CountryName}</option>
</script>
<!--/Template area-->
<div class="main container popup">
    <div class="row">
        <div class="errmsg" id="errmsg">
        </div>
    </div>
    
    <div class="row panel-group">
        <div class="row title hand" onclick="showHideDetailBox(isShowCustinfoBox, 'CustInfo'); isShowCustinfoBox = !isShowCustinfoBox;">
            <b><span id="lblUserName" value=""></span></b>
        </div>
        <div class="CustInfo row content">
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="ddltitle">
                        Title</label></div>
                <div class="col-xs-3 col-sm-1 col-md-1">
                    <select id="ddltitle">
                    </select>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtfirstname">
                        First Name</label></div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtfirstname" class="textbox" />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="txtlastname">
                        Last Name
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtlastname" class="textbox" />
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtphone">
                        Phone</label></div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtphone" class="textbox" />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="txtmobilephone">
                        Mobile Phone
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtmobilephone" class="textbox" />
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtfax">
                        Fax
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtfax" class="textbox" />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="txtEmail">
                        Email
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtEmail" class="textbox" />
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtPIC1">
                        PIC1
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtPIC1" class="textbox" />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="txtMSN">
                        MSN
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtMSN" class="textbox" />
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtPIC2">
                        PIC2
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtPIC2" class="textbox" />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="txtSkype">
                        Skype
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtSkype" class="textbox" />
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtPIC3">
                        PIC3
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtPIC3" class="textbox" />
                </div>
            </div>
            <div class="row item">
                <lable class="checkbox">
                    <input type="checkbox" id="chkIsOverrideCrmInfo" style="float: left; display: block;" />
                Overwrite current CRM Info
            </div>
        </div>
    </div>

    <div class="row panel-group">
        <div class="row title hand" onclick="showHideDetailBox(isShowFeedbackDetailBox, 'FeedbackDetail'); isShowFeedbackDetailBox = !isShowFeedbackDetailBox;">
            Details
        </div>
        <div class="FeedbackDetail row content">
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtdate">
                        Feedback Date
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtdate" class="txtcalendar textbox" readonly />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="ddlcsextension">
                        CS Extension/Station
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlcsextension">
                    </select>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtResolutionTime">
                        Resolution Time
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="txtResolutionTime" class="txtcalendar textbox" readonly />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="ddlcountry">
                        Country
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlcountry" name="D1">
                    </select>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="ddlcommunication">
                        Communication
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlcommunication">
                    </select>
                    <span class="hidden error errormsg" id="errorcommunication"></span>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="ddllanguage">
                        Language
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddllanguage">
                    </select>
                    <span class="hidden error errormsg" id="errorlanguage"></span>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="ddlcategory">
                        Category
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlcategory">
                    </select>
                    <input type="hidden" id="hIsNotChild" value="0" />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="ddlsubcategory">
                        SubCategory
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlsubcategory">
                    </select>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="ddlproduct">
                        Product
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlproduct">
                    </select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="ddlbettype">
                        Bet Type
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlbettype">
                    </select>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="ddlstatus">
                        Status
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlstatus" name="D2">
                    </select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="ddlsite">
                        Site
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlsite">
                    </select>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="ddlrole">
                        Role
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlrole" name="D3">
                    </select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                    <label for="ddlresponse">
                        Response
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="ddlresponse">
                    </select>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label class="checkbox">
                        <input type="checkbox" id="chkisrelated" onclick="checkIsRelated(this);" />
                        Is Related to Customer
                    </label>
                </div>
                <div class="col-xs-8 col-sm-9 col-md-9">
                    <div class="row">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <input type="button" value="  " id="btnRelatedHelp" class="btnHelp pull-left" title="Related Help" />
                            <select id="txtrelatedcustomer" name="txtrelatedcustomer" disabled>
                            </select>
                        </div>
                        <div class="col-xs-1 col-sm-1 col-md-1">
                            <button class="btn pull-right" onclick="verifyUserName();" class="btn" id="btnverify"
                                disabled>
                                Verify</button>
                        </div>
                    </div>
                    <div id="ColorGuide" class="row hidden colorGuide">
                        <div class="col-xs-2 col-sm-2 col-md-2 relate-customer">
                            Customer</div>
                        <div class="col-xs-2 col-sm-2 col-md-2 relate-guest">
                            Guest</div>
                        <div class="col-xs-2 col-sm-2 col-md-2 relate-invalid">
                            Invalid</div>
                    </div>
                    <div id="trRelatedInfo" class="row hidden">
                        <table id="related">
                        </table>
                    </div>
                </div>
            </div>
            <div class="row item">
                <div class="col-xs-3 col-sm-2 col-md-1">
                    <label for="txtsubject">
                        Subject
                    </label>
                </div>
                <div class="col-xs-8 col-sm-9 col-md-9">
                    <input type="text" id="txtsubject" class="textbox" /><span class="hidden error errormsg"
                        id="errorsubject"></span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row panel-group">
        <div class="row title">
            <div class="pull-left hand" onclick="showHideDetailBox(isShowDescriptionBox, 'FeedbackDescription'); isShowDescriptionBox = !isShowDescriptionBox;">
                Description<span class="hidden error errormsg" id="deseditererror"></span>
            </div>
            <div class="pull-right">
                <input type="button" class="btnreview hidden" value="Preview" id="btndesreview" onclick="initReview('des');" />
                <input type="button" class="btnedit" value="Edit" id="btndesedit" onclick="initEdit('des');" />
            </div>
        </div>
        <div class="FeedbackDescription row content">
            <div class="editerwrapper" id="descriptionwrapper">
                <div id="previewboxdes">
                </div>
                <div id="editboxdes" class="hidden">
                </div>
            </div>
        </div>
    </div>

    <div class="row panel-group">
        <div class="row title">
            <div class="pull-left hand" onclick="showHideDetailBox(isShowSolutionBox, 'FeedbackSolution'); isShowSolutionBox = !isShowSolutionBox;">
                <span class="icon-expand" id="btnShowHideSolution" onclick="downup('btnShowHideSolution', 'FeedbackSolution')">
                </span>Solution<span class="hidden error errormsg" id="soleditererror"></span>
            </div>
            <div class="pull-right">
                <input type="button" class="btnreview hidden" value="Preview" id="btnsolreview" onclick="initReview('sol');" />
                <input type="button" class="btnedit " value="Edit" id="btnsoledit" onclick="initEdit('sol');" />
            </div>
        </div>
        <div class="FeedbackSolution row content">
            <div class="editerwrapper" id="solutionwrapper">
                <div id="previewboxsol">
                </div>
                <div id="editboxsol" class="hidden">
                </div>
            </div>
        </div>
    </div>

    <div class="row panel-group">
        <div class="row title" id="reviewtitle">
            <div class="pull-left hand" onclick="showHideDetailBox(isShowReviewBox, 'FeedbackReview'); isShowReviewBox = !isShowReviewBox;">
                Review
                    <input type="checkbox" id="chkisreview" onclick="updateFeedback.reviewCheckBox();" class="hidden" style="float: left; display: block;" />
                    <span id="lblUpdateReview" class="hidden"></span><span id="lblEditedBy"><!--Reviewed--></span>
                    <span class="hidden error errormsg" id="revieweditererror"></span>
            </div>
            <div class="pull-right" id="editreview">
                <input type="button" class="btnrecover hidden" value="Remove" id="btnUnReview" onclick="updateFeedback.unReview();" />
            </div>
        </div>
        <div class="row content FeedbackReview" id="reviewbox">
            <div class="editerwrapper" id="reviewwrapper">
                <div id="previewboxrev">
                </div>
                <div id="editboxrev" class="hidden">
                </div>
            </div>
        </div>
    </div>
    <div class="row btn-group">
        <input type="button" class="btn updateFeedback" onclick="EditFeedback();" id="btnsubmitbottom" value="Save" />
    </div>
</div>
<div id="divPopup" class="selector" style="display: none;">
</div>
@{
    Fanex.CRM.Service.Interface.IPermissionService permission = new Fanex.CRM.Service.Impl.PermissionService();
    var getClientTime = Fanex.CRM.Infrastructure.Core.DateTimeUtilize.ChangeTimeZoneToClient(DateTime.Now);
}
<script language="javascript" type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var accId = @AppSession.CurrentUser.Id;
        var errorMsg = "@Resources.ErrorMsg.lblErrorInputRequiredDate";
        var errorMsgInvalidUser="@Resources.ErrorMsg.lblInvalidUserName";
        var errMsgNotPermissionUpdReviewedFB="@Resources.ErrorMsg.lblNoUpdateReviewFeedbackPermission";
        var successMsg="@Resources.ErrorMsg.lblUpdateFeedbackSuccess";
        var lblConfrimRemoveRelated="Are you sure to remove this related customer.";
        var desvalue = "";
        var solvalue = "";
        var revvalue = "";
        var allowUpdateReview=@permission.HasPermission(Fanex.CRM.Infrastructure.Common.FunctionPermission.ReviewFeedback, Constant.Policy.Host).ToString().ToLower();
        var inputMultipleRelatedNote="@Resources.Language.lblInputMultipleRealteFeedbackCustomerNote";
        var errMsgFeedbackDateGreatter='@Resources.ErrorMsg.lblFeedbacDateShouldBeSmallerThanCurrentDate';
        var errMsgResolutionDateGreatter='@Resources.ErrorMsg.lblFeedbackDateShouldBeSmallerThanResolutionTime';
        var allowDeleteFeedback = @permission.HasPermission(Fanex.CRM.Infrastructure.Common.FunctionPermission.DeleteFeedback, Constant.Policy.Host).ToString().ToLower();
        var clientTime = '@getClientTime';

        head.js("@Url.Content("~/Scripts/JQuery/jquery-1.8.2.js")", function () {
                head.js("@Url.Content("~/Scripts/json2.js")")
                    .js("@Url.Content("~/Scripts/jquery-ui-1.8.14.custom.js")",
                        "@Url.Content("~/Scripts/jquery-ui-timepicker-addon.js")")
                    .js("@Url.Content("~/Scripts/jquery.tmpl.js")")
                    .js("@Url.Content("~/Scripts/autocomplete/jquery.autocomplete.client.js")")
                    .js("@Url.Content("~/Scripts/autocomplete/jquery.highlight-3.js")")
                    .js("@Url.Content("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")")
                    .js("@Url.Content("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")",
                        "@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")")
                    .js("@Url.Content("~/Scripts/stdlib.js")")
                    .js("@Url.Content("~/Scripts/dialogbox.js")")
                    .js("@Url.Content("~/Scripts/common.js")")
                    .js("@Url.Content("~/Scripts/Tipsy-Tooltip/jquery.tipsy.js")")
                    .js("@Url.Content("~/Scripts/InputBox/jquery.fcbkcomplete.js")")
                    .js("@Url.Content("~/Views/Feedback/Scripts/FeedbackCommon.js?ver=2")")
                    .js("@Url.Content("~/Views/Feedback/Scripts/editfeedback.js?ver=1")");
            });   
</script>
