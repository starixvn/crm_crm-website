@using Fanex.CRM.Communication.Resources;
@using Newtonsoft.Json;
@using Fanex.CRM.Communication.Models;
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@using Fanex.NAP.Core.Business;
@using CommonLabels = Fanex.CRM.Common.Resources.Labels;
@model int
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Edit_Communication_Log;

    var customerId = JsonConvert.SerializeObject(Model);
    var customerInfoPolicy = (Constant.Policy)ViewBag.CustomerInfoPolicy;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/FanexGridV2/Fanex.Grid.css")
    @RazorHelper.RenderStyles("~/Scripts/FanexGridV2/Fanex.Pagination.css")
    @RazorHelper.RenderStyles("~/Content/site/customizeFanexGridV2.less")
    @RazorHelper.RenderStyles("~/Areas/Communication/ViewLogStyles")
}
<div data-ng-app="communication-application">
    <div id="communicationcontroller" class="container main" data-ng-controller="communicationController">
        <div class="row filter-frm one-row communication-filter">
            <div class="item" default-focus data-ng-model="isSetFocus">
                <label for="handler">@Labels.Handler</label>
                <input type="text" class="textbox search-by-enter" id="handler" data-ng-model="searchCriteria.Handler" />
            </div>
            <div class="item">
                <label for="fromDate">
                    @Labels.From_date</label>
                <div class="display-inline-block" data-ng-model="searchCriteria.MaxFromDate" date-picker-from-date-container>
                    <input id="fromDate" type="text" class="textbox txtcalendar" />
                </div>
            </div>
            <div class="item">
                <label for="toDate">
                    @Labels.To_date</label>
                <div class="display-inline-block" data-ng-model="searchCriteria.MinToDate" date-picker-to-date-container>
                    <input id="toDate" type="text" class="textbox txtcalendar" />
                </div>
            </div>
            <div class="item afterButton" data-ng-model="statusList" dropdown-status-container>
                <label for="status">
                    @Labels.Status</label>
                <select id="status">
                </select>
            </div>
            <div class="item">
                <button class="btn" data-ng-click="searchCommunicationLogs()">
                    @Html.Raw(@CommonLabels.Btn_HotKey_Submit)</button>
            </div>
        </div>
        <div class="row row-item" data-ng-show="isShowResultMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ isSuccess ? 'scc' : 'err' }}" class="alertbox{{ isSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="resultMessage">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div data-ng-model="logs" table-communication-logs-container>
                <div id="table-communication-logs" class="freegrid display-none">
                </div>
            </div>
        </div>
        @if (customerInfoPolicy == Constant.Policy.Host)
        {
            <div class="row btn-group">
                <button id="buttoninsert" class="btn" data-ng-click="insertCommunicationLog();">
                    @Html.Raw(@CommonLabels.Btn_HotKey_InsertCase)</button>
            </div>
        }
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/PopUp")
    @RazorHelper.RenderScripts("~/Scripts/Paging/jpager.js")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/Fanex.Pagination.js")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/Fanex.Grid.js")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/moment.js")
    @RazorHelper.RenderScripts("~/Areas/Communication/ViewLogScripts")
    <script type="text/javascript">
        parent.document.title = document.title;
        window.rootUrl = '@Url.Content("~")';
        var customerId = @customerId;
        var currentDate = '@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()';
        var initFromDate = '@DateTimeUtilize.CurrentClientTime().FirstDayOfMonth().ToShortFormatedDate()';
        var viewResources = {
            Customer_Communication_Logs: '@Labels.Customer_Communication_Logs',
            Running_No: '@Labels.Running_No',
            Feedback_Date: '@Labels.Feedback_Date',
            Main_Category: '@Labels.Main_Category',
            Sub_Category: '@Labels.Sub_Category',
            Subject: '@Labels.Subject',
            Status: '@Labels.Status',
            Duration: '@Labels.Duration',
            Handler: '@Labels.Handler',
            Reviewer: '@Labels.Reviewer',
            Edit_Communication_Log: '@Labels.Edit_Communication_Log',
            Insert_Communication_Log: '@Labels.Insert_Communication_Log',
            All: '@Labels.All'
        };
    </script>
}