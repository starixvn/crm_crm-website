@using Fanex.CRM.Communication.Resources;
@using Fanex.CRM.Communication.Models;
@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Edit_Communication_Log;

    var customerId = Model;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/autocomplete/autocomplete.css")
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
    @RazorHelper.RenderStyles("~/Areas/Communication/InsertLogStyles")
}
<div data-ng-app="communicationlog-insert-application">
    <div class="main popup container insertlogcontroller" data-ng-controller="insertLogController">
        <div class="row form-group">
            <div class="row row-item" data-ng-show="isShowResultMessage">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div data-ng-class="alertbox{{ isSuccess ? 'scc' : 'err' }}" class="alertbox{{ isSuccess ? 'scc' : 'err' }}">
                        <div data-ng-bind="resultMessage">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="startTime">
                        @Labels.Start_Time
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="startTime" class="txtcalendar textbox timepicker" readonly
                           onselect="onStartTimeChanged();" data-ng-model="communicationLog.StartTime" datetimepicker />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="ext">
                        @Labels.Ext
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-extension data-ng-model="extensionList">
                    <select id="ext"></select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="endTime">
                        @Labels.End_Time
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <input type="text" id="endTime" class="txtcalendar textbox timepicker" readonly data-ng-model="communicationLog.EndTime"
                           datetimepicker />
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="country">
                        @Labels.Country
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-country data-ng-model="countryList">
                    <select id="country"></select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="communicationTool">
                        @Labels.Communication_Tool
                        @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-communication-tool data-ng-model="communicationToolList">
                    <select id="communicationTool"></select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="language">
                        @Labels.Language
                        @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-language data-ng-model="languageList">
                    <select id="language" class="languageoptions"></select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="mainCategory">
                        @Labels.Main_Category
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-main-category data-ng-model="mainCategoryList">
                    <select id="mainCategory"></select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="subcategory">
                        @Labels.Sub_Category
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-sub-category data-ng-model="subCategoryList">
                    <select id="subCategory"></select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="product">
                        @Labels.Product
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-product data-ng-model="productOptions.DataList">
                    <select id="product"></select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="subproduct">
                        @Labels.SubProduct
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-sub-product data-ng-model="subProductOptions.DataList">
                    <select id="subProduct"></select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="status">
                        @Labels.Status
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-status data-ng-model="statusList">
                    <select id="status"></select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="betType">
                        @Labels.Bet_Type
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-bet-type data-ng-model="betTypeList">
                    <select id="betType"></select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="role">
                        @Labels.Role
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-role data-ng-model="roleList">
                    <select id="role"></select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="site">
                        @Labels.Site
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-site data-ng-model="siteList">
                    <select id="site"></select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="licensee-type">
                        @Labels.Licensee_Type
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <select id="licensee-type" data-ng-model="communicationLog.LicenseeType" data-ng-options="s.Name for s in licenseeTypes track by s.Id"></select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="response">
                        @Labels.Response
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-response data-ng-model="responseList">
                    <select id="response"></select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="relatedTo">
                        @Labels.Related_To
                    </label>
                </div>
                <div class="col-xs-8 col-sm-8 col-md-8">
                    <input id="txtrelatedcustomer" name="txtrelatedcustomer" class="related-customer"
                           data-ng-model="customersInput" />
                </div>
                <div class="col-xs-1 col-sm-1 col-md-1">
                    <button class="btn pull-right" data-ng-click="verifyRelatedCustomer()" data-ng-disabled="customersInput === ''">
                        V<span class="hotkey">e</span>rify
                    </button>
                </div>
            </div>
            <div class="row row-item">
                <div id="ColorGuide" class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-8 col-sm-8 col-md-8"
                     data-ng-show="relatedCustomerResultDirective.relatedCustomers.length > 0">
                    <div class="col-xs-2 col-sm-2 col-md-2 relate-customer">
                        @Labels.Customer
                    </div>
                    <div class="col-xs-2 col-sm-2 col-md-2 relate-guest">
                        @Labels.Guest
                    </div>
                    <div class="col-xs-2 col-sm-2 col-md-2 relate-invalid">
                        @Labels.Invalid
                    </div>
                </div>
                <div id="related-container" class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-8 col-sm-8 col-md-8 related"
                     data-ng-show="relatedCustomerResultDirective.relatedCustomers.length > 0">
                    <table id="related" data-ng-model="relatedCustomerResultDirective.relatedCustomers" relatedcustomerresult>
                    </table>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="subject">
                        @Labels.Subject
                        @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </label>
                </div>
                <div class="col-xs-8 col-sm-8 col-md-8 subject-container">
                    <input type="text" class="textbox " id="subject" data-ng-model="communicationLog.Subject"
                           subject-auto-complete />
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title">
                <div class="pull-left hand">
                    Auto-generated
                </div>
            </div>
            <div class="FeedbackDescription row content">
                <div class="" id="">
                    <textarea rows="3" class="auto-generated-text" data-ng-model="autoGeneratedText"></textarea>
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title remarktitle" data-ng-class="isShowRemarkBox ? '' : 'border-bottom-none'"
                 data-ng-click="isShowRemarkBox = !isShowRemarkBox">
                @Labels.Remark
                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
            </div>
            <div class="row content multi-text" data-ng-show="isShowRemarkBox">
                <div id="remarkeditorboxcontainer" data-ng-model="communicationLog.Remark" remark-editor-container>
                </div>
            </div>
        </div>
        <div class="row panel-group last">
            <div class="row title solutiontitle" data-ng-class="isShowSolutionBox ? '' : 'border-bottom-none'"
                 data-ng-click="isShowSolutionBox = !isShowSolutionBox">
                @Labels.Solution
                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
            </div>
            <div class="row content multi-text" data-ng-show="isShowSolutionBox">
                <div id="solutionkeditorboxcontainer" data-ng-model="communicationLog.Solution" solution-editor-container>
                </div>
            </div>
        </div>
        <div class="row">
            <button class="btn btn-save" data-ng-click="insertLog();">
                <span class="hotkey">S</span>ave
            </button>
        </div>
        <input type="text" class="textbox default-focus-element" default-focus data-ng-model="isSetFocus" />
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/TimePicker")
    @RazorHelper.RenderScripts("~/Scripts/FanexMultipleSelect")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/moment.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.highlight-3.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.autocomplete.client.js")
    @RazorHelper.RenderScripts("~/Scripts/common.js")
    @RazorHelper.RenderScripts("~/Areas/Communication/InsertLogScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentTime = '@DateTimeUtilize.CurrentClientTime()';
        var customerId = '@customerId';
        var currentUsername = "@AppSession.CurrentUser.Username";
        var viewResources = {
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            Select: '@Labels.Select',
            Insert_Edit_Block: '@Labels.Insert_Edit_Block',
            Warning: '@Labels.Warning',
            OK: '@Labels.OK',
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            CustomerNameLengthErrorMessage: '@Labels.RelatedCustomerNameLengthErrorMessage',
            Communication_Logs_VerifyRelatedCustomer: '@Labels.Communication_Logs_VerifyRelatedCustomer',
            Communication_Log_NACommmunicationTool: '@Labels.Communication_Log_NACommmunicationTool',

            Communication_Log_ErrorEndTime: '@Labels.Communication_Log_ErrorEndTime',
            Communication_Log_NACountry: '@Labels.Communication_Log_NACountry',
            Communication_Log_NALanguage: '@Labels.Communication_Log_NALanguage',
            Communication_Log_NAProduct: '@Labels.Communication_Log_NAProduct',
            Communication_Log_NABetType: '@Labels.Communication_Log_NABetType',
            Communication_Log_NASite: '@Labels.Communication_Log_NASite',

            Communication_Log_EmptySubject: '@Labels.Communication_Log_EmptySubject',
            Communication_Log_EmptyRemark: '@Labels.Communication_Log_EmptyRemark',
            Communication_Log_EmptyReview: '@Labels.Communication_Log_EmptyReview',
            Communication_Log_EmptySolution: '@Labels.Communication_Log_EmptySolution',
            Confirm_Ignore_InsertCommunication_Changes: '@Html.Raw(Labels.Confirm_Ignore_InsertCommunication_Changes)'
        };
    </script>
}