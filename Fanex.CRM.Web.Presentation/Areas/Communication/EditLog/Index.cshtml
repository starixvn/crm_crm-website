@using Fanex.CRM.Communication.Resources;
@using Newtonsoft.Json;
@using Fanex.CRM.Communication.Models;
@using Fanex.CRM.Infrastructure.Core;
@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Service.Interface;
@using Fanex.CRM.Service.Impl;
@using Fanex.CRM.Infrastructure.Common;
@{
    var jsonLogInfo = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="communicationlog-edit-application">
<head>
    <title>@Labels.Edit_Communication_Log </title>
    @Styles.Render("~/site/common")
    <link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/autocomplete/styles.css")" rel="stylesheet" type="text/css" />
    @Styles.Render("~/Styles/FanexMultipleSelect")
    @Styles.Render("~/Areas/Communication/EditLogStyles")
</head>
<body>
    <div class="main popup container editlogcontroller" data-ng-controller="editLogController">
        <div class="row form-group">
            <div class="row row-item" data-ng-show="isShowResultMessage">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div data-ng-class="alertbox{{ isSuccess ? 'scc' : 'err' }}" class="alertbox{{ isSuccess ? 'scc' : 'err' }}">
                        <div data-ng-bind="resultMessage">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="startTime">
                        @Labels.Start_Time</label></div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div data-ng-model="communicationLog.StartTime" time-picker-start-time-container>
                        <input id="startTime" type="text" class="textbox timepicker txtcalendar" />
                    </div>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="ext">
                        @Labels.Ext</label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-extension data-ng-model="extensionList">
                    <select id="ext">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="endTime">
                        @Labels.End_Time</label></div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div data-ng-model="communicationLog.EndTime" time-picker-end-time-container>
                        <input id="endTime" type="text" class="textbox timepicker txtcalendar" />
                    </div>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="country">
                        @Labels.Country
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-country data-ng-model="countryList">
                    <select id="country">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="communicationTool">
                        @Labels.Communication_Tool
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-communication-tool data-ng-model="communicationToolList">
                    <select id="communicationTool">
                    </select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="language">
                        @Labels.Language
                        @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-language data-ng-model="languageList">
                    <select id="language" class="languageoptions">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="mainCategory">
                        @Labels.Main_Category</label></div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-main-category data-ng-model="mainCategoryList">
                    <select id="mainCategory">
                    </select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="subcategory">
                        @Labels.Sub_Category</label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-sub-category data-ng-model="subCategoryList">
                    <select id="subCategory">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="product">
                        @Labels.Product
                        @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-product data-ng-model="productList">
                    <select id="product">
                    </select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="betType">
                        @Labels.Bet_Type
                        @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-bet-type data-ng-model="betTypeList">
                    <select id="betType">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="status">
                        @Labels.Status</label></div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-status data-ng-model="statusList">
                    <select id="status">
                    </select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="site">
                        @Labels.Site
                    </label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-site data-ng-model="siteList">
                    <select id="site">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="role">
                        @Labels.Role</label></div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-role data-ng-model="roleList">
                    <select id="role">
                    </select>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                    <label for="response">
                        @Labels.Response</label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" dropdown-response data-ng-model="responseList">
                    <select id="response">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="relatedTo">
                        @Labels.Related_To</label></div>
                <input id="chkisrelated" type="checkbox" ng-class="display-none" class="display-none"
                    checked="checked" />
                <div class="col-xs-8 col-sm-8 col-md-8 related-customer-container" data-ng-class="related-customer-container"
                    related-customer-container>
                    <select type="text" class="textbox" id="txtrelatedcustomer" name="relatedTo" disabled>
                    </select>
                </div>
                <div class="col-xs-1 col-sm-1 col-md-1">
                    <button class="btn pull-right" data-ng-click="verifyRelatedCustomer();">
                        V<span class="hotkey">e</span>rify</button>
                </div>
            </div>
            <div class="row row-item">
                <div id="ColorGuide" class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-9 col-sm-10 col-md-10 display-none">
                    <div class="col-xs-2 col-sm-2 col-md-2 relate-customer">
                        @Labels.Customer</div>
                    <div class="col-xs-2 col-sm-2 col-md-2 relate-guest">
                        @Labels.Guest</div>
                    <div class="col-xs-2 col-sm-2 col-md-2 relate-invalid">
                        @Labels.Invalid</div>
                </div>
                <table id="related" class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-10 col-sm-10 col-md-10 related">
                </table>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                    <label for="subject">
                        @Labels.Subject
                        @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </label>
                </div>
                <div class="col-xs-8 col-sm-8 col-md-8 subject-container">
                    <input type="text" class="textbox" id="subject" data-ng-model="communicationLog.Subject"
                        subject-auto-complete />
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title">
                @Labels.Remark
                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
            </div>
            <div class="row content multi-text">
                <div id="remarkeditorboxcontainer" data-ng-model="communicationLog.Remark" remark-editor-container>
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title">
                @Labels.Solution
                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
            </div>
            <div class="row content multi-text">
                <div id="solutionkeditorboxcontainer" data-ng-model="communicationLog.Solution" solution-editor-container>
                </div>
            </div>
        </div>
        <div class="row panel-group last">
            <div class="row title">
                <label for="review">
                    @Labels.Reviewed</label>
                <input id="review" type="checkbox" class="review" data-ng-click="communicationLog.IsReviewed=!communicationLog.IsReviewed;"
                    data-ng-model="communicationLog.IsReviewed" data-ng-disabled="!hasReviewPermission" />
            </div>
            <div data-ng-class="{'display-none': hasReviewPermission}">
                @Html.Raw(Model.Review)
            </div>
            <div class="row content multi-text" data-ng-class="{'display-none': !hasReviewPermission || !communicationLog.IsReviewed}">
                <div id="revieweditorboxcontainer" data-ng-model="communicationLog.Review" review-editor-container>
                </div>
            </div>
        </div>
        <div class="row">
            <button class="btn btn-save" data-ng-click="preupdateLog();" default-focus data-ng-model="isSetFocus"
                data-ng-show="!oldCommunicationLog.IsReviewed || !communicationLog.IsReviewed">
                <span class="hotkey">S</span>ave</button>
        </div>
    </div>
    @{
        IPermissionService permission = new PermissionService();
        var hasReviewPermission = permission.HasPermission(FunctionPermission.ReviewFeedback, Constant.Policy.Host).ToString().ToLower();
    }
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/TimePicker")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    @Scripts.Render("~/Scripts/FanexMultipleSelect")
    <script type="text/javascript" src="~/Scripts/FanexGridV2/moment.js"></script>
    <script type="text/javascript" src="~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js"></script>
    <script type="text/javascript" src="~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js"></script>
    <script type="text/javascript" src="~/Scripts/Jlinq/jlinq/jlinq.jquery.js"></script>
    <script type="text/javascript" src="~/Scripts/autocomplete/jquery.highlight-3.js"></script>
    <script type="text/javascript" src="~/Scripts/autocomplete/jquery.autocomplete.client.js"></script>
    <script type="text/javascript" src="~/Scripts/common.js"></script>
    <script type="text/javascript" src="~/Scripts/InputBox/jquery.fcbkcomplete.js"></script>
    @Scripts.Render("~/Areas/Communication/EditLogScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")'; 
        var currentTime = '@DateTimeUtilize.GetCurrentClientTime()'; 
        var communicationLog = @Html.Raw(jsonLogInfo); 
        var hasReviewPermission = @hasReviewPermission;
        var viewResources = {
            Symbol_NotApply: '@Labels.Symbol_NotApply', 
            Select:'@Labels.Select', 
            Insert_Edit_Block: '@Labels.Insert_Edit_Block', 
            Warning: '@Labels.Warning', 
            OK: '@Labels.OK',
            Communication_Logs_VerifyRelatedCustomer:'@Labels.Communication_Logs_VerifyRelatedCustomer',
            Communication_Log_EmptySubject: '@Labels.Communication_Log_EmptySubject',
            Communication_Log_EmptyRemark: '@Labels.Communication_Log_EmptyRemark',
            Communication_Log_EmptyReview: '@Labels.Communication_Log_EmptyReview',
            Communication_Log_EmptySolution: '@Labels.Communication_Log_EmptySolution',            
            Confirm_Ignore_EditCommunication_Changes: '@Html.Raw(Labels.Confirm_Ignore_EditCommunication_Changes)',
    
            Communication_Log_NACommmunicationTool:'@Labels.Communication_Log_NACommmunicationTool',
            Communication_Log_NACountry:'@Labels.Communication_Log_NACountry',
            Communication_Log_NALanguage:'@Labels.Communication_Log_NALanguage',
            Communication_Log_NAProduct:'@Labels.Communication_Log_NAProduct',
            Communication_Log_NABetType:'@Labels.Communication_Log_NABetType',
            Communication_Log_NASite:'@Labels.Communication_Log_NASite'
  }; 
    </script>
</body>
</html>
