@using Fanex.CRM.Communication.Resources;
@using Newtonsoft.Json;
@using Fanex.CRM.Communication.Models;
@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Common.Constants;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Edit_Communication_Log;

    var jsonLogInfo = JsonConvert.SerializeObject(Model);

    IPermissionService permission = new PermissionService();
    var hasReviewPermission = permission.HasPermission(FunctionPermissions.ReviewFeedback, Constant.Policy.Host).ToString().ToLower();
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/autocomplete/autocomplete.css")
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
    @RazorHelper.RenderStyles("~/Scripts/Directives/multileveldropdown/multileveldropdown.css")
    @RazorHelper.RenderStyles("~/Areas/Communication/ViewDetailByIdStyles")
}
<div data-ng-app="communicationlog-viewdetailbyid-application">
    <div class="main popup container editlogcontroller" data-ng-controller="viewDetailByIdController">
        <div class="row panel-group">
            <div class="row title">
                <b>
                    <span id="label-customername" data-ng-bind="communicationLog.CustomerName"></span>
                </b>
            </div>
            <div class="row content">
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="startTime">
                            @Labels.Start_Time
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <div data-ng-model="startTimeOptions" class="time-picker-start-time-container">
                            <input id="startTime" type="text" class="textbox timepicker txtcalendar" disabled="disabled" />
                        </div>
                    </div>
                    <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                        <label for="ext">
                            @Labels.Ext
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <multileveldropdowntree text-settings="TextSettings"
                                                data-ng-model="selectedExtensions"
                                                data-settings="extensionDropdownSettings"></multileveldropdowntree>
                    </div>
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="endTime">
                            @Labels.End_Time
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <div data-ng-model="endTimeOptions" class="time-picker-end-time-container">
                            <input id="endTime" type="text" class="textbox timepicker txtcalendar" disabled="disabled" />
                        </div>
                    </div>
                    <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                        <label for="country">
                            @Labels.Country
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3 country-picker-container" data-ng-model="countryOptions.DataList">
                        <select id="country" disabled="disabled"></select>
                    </div>
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="communicationTool">
                            @Labels.Communication_Tool
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <multileveldropdowntree text-settings="TextSettings"
                                                data-ng-model="selectedCommunications"
                                                data-settings="communicationDropdownSettings"></multileveldropdowntree>
                    </div>
                    <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                        <label for="language">
                            @Labels.Language
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3 language-picker-container" data-ng-model="languageOptions.DataList">
                        <select id="language" class="languageoptions" disabled="disabled"></select>
                    </div>
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="mainCategory">
                            @Labels.Main_Category
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <multileveldropdowntree text-settings="TextSettings"
                                                data-ng-model="selectedCategories"
                                                data-ng-change="categoryChangedHandler()"
                                                data-settings="categoryDropdownSettings"></multileveldropdowntree>
                    </div>
                    <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                        <label for="subCategory">
                            @Labels.Sub_Category
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <multileveldropdowntree text-settings="TextSettings"
                                                data-ng-model="selectedSubCategories"
                                                data-ng-change="subCategoryChangedHandler()"
                                                data-settings="subCategoryDropdownSettings"></multileveldropdowntree>
                    </div>
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="product">
                            @Labels.Product
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <multileveldropdowntree text-settings="TextSettings"
                                                data-ng-model="selectedProducts"
                                                data-ng-change="productChangedHandler()"
                                                data-settings="productDropdownSettings"></multileveldropdowntree>
                    </div>
                    <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                        <label for="subProduct">
                            @Labels.SubProduct
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <multileveldropdowntree text-settings="TextSettings"
                                                data-ng-model="selectedSubProducts"
                                                data-ng-change="subProductChangedHandler()"
                                                data-settings="subProductDropdownSettings"></multileveldropdowntree>
                    </div>
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="status">
                            @Labels.Status
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3 status-picker-container" data-ng-model="statusOptions.DataList">
                        <select id="status" disabled="disabled"></select>
                    </div>
                    <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                        <label for="betType">
                            @Labels.Bet_Type
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <multileveldropdowntree text-settings="TextSettings"
                                                data-ng-model="selectedBettypes"
                                                data-ng-change="bettypeChangeHandler()"
                                                data-settings="bettypeDropdownSettings"></multileveldropdowntree>
                    </div>
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="role">
                            @Labels.Role
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3 role-picker-container" data-ng-model="roleOptions.DataList">
                        <select id="role" disabled="disabled"></select>
                    </div>
                    <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                        <label for="site">
                            @Labels.Site
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <select id="site" disabled="disabled" data-ng-model="communicationLog.SiteInfo"
                                data-ng-options="s.Name group by s.AliasName for s in siteList track by s.Id">
                            <option value="">-- @Labels.Select --</option>
                        </select>
                    </div>
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="licensee-type">
                            @Labels.Licensee_Type
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3 licensee-type-picker-container" data-ng-model="licenseeTypeOptions.DataList">
                        <select id="licensee-type" disabled="disabled"></select>
                    </div>
                    <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                        <label for="response">
                            @Labels.Response
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3  response-picker-container" data-ng-model="responseOptions.DataList">
                        <select id="response" disabled="disabled"></select>
                    </div>
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="inquiries">
                            @Labels.NoOfInquiries
                        </label>
                    </div>
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <input disabled class="textbox" type="number" name="input" oninput="validity.valid||value < 1 && (value=1)||value > 32000 && (value=32000);" min="1" max="32000" data-ng-model="communicationLog.NoInquiries" />
                    </div>                   
                </div>
                <div class="row row-item item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="relatedTo">
                            @Labels.Related_To
                        </label>
                    </div>
                    <div class="col-xs-9 col-sm-9 col-md-9">
                        <div id="related-container" class="related">
                            <table id="related" data-ng-model="relatedCustomerResultDirective.relatedCustomers" relatedcustomerresult></table>
                        </div>
                    </div>
                </div>
                <div class="row item">
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                        <label for="subject">
                            @Labels.Subject
                        </label>
                    </div>
                    <div class="col-xs-9 col-sm-9 col-md-9 subject-container">
                        <input id="subject" type="text" class="textbox subject-auto-complete" data-ng-model="subjectOptions.Subject"
                               disabled="disabled" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title">
                @Labels.Remark
            </div>
            <div class="row content multi-text">
                <div class="lastRemarkPrefixPreview" ng-bind-html="communicationLog.AutoField">
                </div>
                <div class="item">
                    @Html.Raw(Model.Remark)
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title">
                @Labels.Solution
            </div>
            <div class="row content multi-text">
                <div class="item">
                    @Html.Raw(Model.Solution)
                </div>
            </div>
        </div>
        <div class="row panel-group last">
            <div class="row title" data-ng-class="!communicationLog.IsReviewed ? 'border-bottom-none' : ''">
                <label for="review">
                    @Labels.Reviewed
                </label>
                <input id="review" type="checkbox" class="review" ng-model="communicationLog.IsReviewed" disabled="disabled" />
                <label class="label-reivewedbyinfo" ng-class="{'display-none': !communicationLog.IsReviewed }"
                       ng-bind="getReviewedInfo();">
                </label>
            </div>
            <div class="row content multi-text" data-ng-show="communicationLog.IsReviewed">
                <div class="item">
                    @Html.Raw(Model.Review)
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/TimePicker")
    @RazorHelper.RenderScripts("~/Scripts/FanexMultipleSelect")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/moment.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.highlight-3.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.autocomplete.client.js")
    @RazorHelper.RenderScripts("~/Scripts/common.js")
    @RazorHelper.RenderScripts("~/Areas/Communication/ViewDetailByIdScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentTime = '@DateTimeUtilize.CurrentClientTime()';
        var communicationLog = @Html.Raw(jsonLogInfo);
        if(communicationLog.AutoField){
            communicationLog.AutoField = communicationLog.AutoField.replace(/\n/g, "<br>") + "<br><br>";
        }
        var hasReviewPermission = @hasReviewPermission;
        var viewResources = {
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            Select:'@Labels.Select',
            Insert_Edit_Block: '@Labels.Insert_Edit_Block',
            Communication_Logs_VerifyRelatedCustomer:'@Labels.Communication_Logs_VerifyRelatedCustomer',
            ReviewedInformation: '@Labels.ReviewedInformation'
        };
    </script>
}
