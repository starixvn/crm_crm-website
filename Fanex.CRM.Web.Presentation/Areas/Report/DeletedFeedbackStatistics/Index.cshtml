@using Fanex.CRM.Report.Resources
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Report.Helpers;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var clientDate = DateTimeUtilize.CurrentClientTime().ToShortFormatedDate();
    
    var year = DateTime.Now.Year;
    var month = DateTime.Today.Month;
    var fromDate = new DateTime(year, month, 1).AddMonths(-1).ToShortDateString();
    var toDate = new DateTime(year, month, 1).AddDays(-1).ToShortDateString();
}
@section Styles{
    @RazorHelper.RenderStyles("~/site/common",
                            "~/bundles/Report/DeletedFeedbackStatisticsStyles")
}
<div data-ng-app="deleted-feedback-statistics-application">
    <div class="main container" data-ng-controller="deletedFeedbackStatisticsController">
        <div class="filter-frm one-row">
            <form novalidate>
            <div class="row row-item">
                <div class="item">
                    <label for="handler">@Labels.Handler</label>
                    <input type="text" class="textbox" id="handler" data-ng-model="searchCriteria.Handler"/>
                </div>
                <div class="item">
                    <label for="fromDate">@Labels.From</label>
                    <div class="display-inline-block date-picker-from-date-container" data-ng-model="fromDateOptions.IsRerenderPicker">
                        <input id="fromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                    </div>
                </div>
                <div class="item">
                    <label for="toDate">@Labels.To</label>
                    <div class="display-inline-block date-picker-to-date-container" data-ng-model="toDateOptions.IsRerenderPicker">
                        <input id="toDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="row row-item">
                <div class="item">
                    <label for="deletedBy">@Labels.DeletedBy</label>
                    <input type="text" class="textbox" id="deletedBy" data-ng-model="searchCriteria.DeletedBy"/>
                </div>
                <div class="item">
                    <button class="btn" data-ng-click="getReport();">
                        <span class="hotkey">S</span>ubmit</button>
                </div>
            </div>
            </form>
        </div>
        <div>
            <div data-ng-model="reportOptions.IsUpdateGrid" class="table-deleted-feedback-statistics-report-container">
                <div id="deleted-feedback-statistics-report" class="freegrid display-none">
                </div>
            </div>
        </div>
        <div class="download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
    </div>
</div>
@section Scripts {
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';

        var currentDate = new Date('@clientDate');
        var fromDateDefault = '@fromDate';
        var toDateDefault = '@toDate';

        var viewResources = {
            All: '@Labels.All',
            Grand_Total: '@Labels.Grand_Total',

            Date: '@Labels.Date',
            Handler: '@Labels.Handler',
            DeletedBy: '@Labels.DeletedBy',
            Feedback: '@Labels.Feedback',
            Category: '@Labels.Category',
            Customer: '@Labels.Customer',
            RelatedCustomer: '@Labels.RelatedCustomer'
        };
    </script>
    @RazorHelper.RenderScripts("~/Scripts/FanexGridScripts",
        "~/Scripts/FanexGridV2/NumeralScripts",
        "~/CRM/DownLoadFile/Scripts",
        "~/bundles/Report/DeletedFeedbackStatisticsScripts")
}