@using Fanex.CRM.Report.Resources
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.CasinoWeeklyStatistics_Report;

    DateTime clientDate = DateTimeUtilize.CurrentClientTime();
    string fromDate = DateTimeExtension.FirstDayOfWeek(clientDate).ToShortFormatedDate();
    string toDate = clientDate.ToShortFormatedDate();
}
@section Styles{
    @RazorHelper.RenderStyles("~/bundles/Report/CasinoWeeklyStyles")
}
<div data-ng-app="report-casinoweekly-application">
    <div class="main container" data-ng-controller="casinoweeklyController">
        <div class="row filter-frm one-row">
            <div class="row row-item">
                <form data-ng-submit="getCasinoWeeklySummary()" novalidate>
                <div class="item fromDate">
                    <label for="fromDate" class="width-80">@Labels.From_Date</label>
                    <input type="text" class="textbox timepicker txtcalendar disabled" data-ng-model="fromDate"
                        readonly />
                </div>
                <div class="item toDate">
                    <label for="toDate">@Labels.To_Date</label>
                    <input type="text" class="textbox timepicker txtcalendar disabled" data-ng-model="toDate"
                        readonly />
                </div>
                <div class="item">
                    <button class="btn">
                        <span class="hotkey">S</span>ubmit</button>
                </div>
                </form>
            </div>
            <div class="row">
                <div class="icon-filter">
                </div>
                <span class="warning">@Labels.CasinoDailyStatisticsHint</span>
            </div>
        </div>
        <div class="row">
            <div table-weekly-summary-container data-ng-model="weeklySummary" data-ng-show="showSummary">
                <div id="table-weekly-summary" class="freegrid hide">
                </div>
            </div>
            <div table-weekly-detail-container data-ng-model="weeklyDetail" data-ng-show="!showSummary">
                <div id="table-weekly-detail" class="freegrid hide">
                </div>
            </div>
        </div>
        <div class="download-file-container hide" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0"></iframe>
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/FanexGridScripts",
        "~/Scripts/FanexGridV2/NumeralScripts",
        "~/CRM/DownLoadFile/Scripts",
        "~/bundles/Report/CasinoWeeklyScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        parent.document.title = '@Resources.Language.Title_Report_CasinoWeeklyStatistics';
        var fromDate = '@fromDate';
        var toDate = '@toDate';
        var casinoWeeklyResources = {
            Category: '@Labels.Category',
            GrandTotal: '@Labels.GrandTotal',
            ViewChart: '@Labels.ViewChart',
            ViewDetail: '@Labels.ViewDetail',
            Date: '@Labels.Date',
            StartTime: '@Labels.StartTime',
            EndTime: '@Labels.EndTime',
            Duration: '@Labels.Duration',
            Customer: '@Labels.Customer',
            Site: '@Labels.Site',
            TypeOfContact: '@Labels.TypeOfContact',
            ProductName: '@Labels.ProductName',
            Ext: '@Labels.Ext',
            Role: '@Labels.Role',
            Contact: '@Labels.ContactInfo',
            Country: '@Labels.Country',
            SubCategory: '@Labels.SubCategory',
            Description: '@Labels.Description',
            Solution: '@Labels.Solution',
            Status: '@Labels.Status',
            Response: '@Labels.Response',
            HandleBy: '@Labels.HandleBy',
            CreationTime: '@Labels.CreationTime',
            GoBack: '@Labels.GoBack',
            Feedbacks: '@Labels.Feedbacks',
            MSN: '@Labels.MSN',
            Skype: '@Labels.Skype',
            Email: '@Labels.Email',
            Phone: '@Labels.Phone',
            Mobile: '@Labels.Mobile'
        };
    </script>
}