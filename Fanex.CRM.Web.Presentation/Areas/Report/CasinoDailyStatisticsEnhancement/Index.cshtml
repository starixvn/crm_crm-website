@using Fanex.CRM.Report.Resources
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@{ string clientDate = DateTimeUtilize.CurrentClientTime().ToShortFormatedDate(); }
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="report-casinodaily-enhancement-application">
<head>
    <title>@Labels.CasinoDailyStatistics_Report</title>
    @RazorHelper.RenderStyles("~/site/common", 
                            "~/bundles/Report/CasinoDailyEnhancementStyles",
                            "~/Styles/FanexMultipleSelect")
</head>
<body>
    <div class="main container" data-ng-controller="casinoDailyEnhancementController">
        <div class="filter-frm one-row">
            <form data-ng-submit="getCasinoDailySummary()" novalidate>
                <div class="row row-item">
                    <div class="item col-xs-5 col-sm-5 col-md-5">
                        <label class="col-xs-2 col-sm-2 col-md-2" for="products">@Labels.Product</label>
                        <div class="product-Picker-Container display-inline-block" data-ng-model="productOptions.DataList" style="min-width: 160px;">
                            <select id="product">
                            </select>
                        </div>
                    </div>
                    <div class="item item col-xs-2 col-sm-2 col-md-2">
                        <label for="fromDate">@Labels.From</label>
                        <div class="display-inline-block date-picker-from-date-container" data-ng-model="fromDateOptions.IsRerenderPicker">
                            <input id="fromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                        </div>
                    </div>
                    <div class="item item col-xs-2 col-sm-2 col-md-2">
                        <label for="toDate">@Labels.To</label>
                        <div class="display-inline-block date-picker-to-date-container" data-ng-model="toDateOptions.IsRerenderPicker">
                            <input id="toDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item col-xs-5 col-sm-5 col-md-5">
                        <label class="col-xs-2 col-sm-2 col-md-2" for="main-category">@Labels.Main_Category</label>
                        <div class="display-inline-block" category-picker-container data-ng-model="categoryOptions.DataList" style="min-width: 300px;">
                            <select id="category">
                            </select>
                        </div>
                    </div>
                    <div class="item col-xs-4 col-sm-4 col-md-4">
                        <label for="communication-tool">@Labels.Communication_Tool</label>
                        <div class="display-inline-block communication-tool-picker-container" data-ng-model="communicationToolOptions.DataList"  style="min-width: 235px;">
                            <select id="communication-tool">
                            </select>
                        </div>
                    </div>
                    <div class="item">
                        <button class="btn" data-ng-click="getCasinoDailyEnhancementStatisticsReport();">
                            <span class="hotkey">S</span>ubmit</button>
                    </div>
                </div>
            </form>
        </div>

        <div>
            <div data-ng-model="ibcReportOptions.IsUpdateGrid" class="display-none table-ibc-report-container">
                <div id="table-ibc-report" class="freegrid  table-ibc-report">
                </div>
            </div>
            <div data-ng-model="licenseeReportOptions.IsUpdateGrid" class="display-none table-licensee-report-container">
                <div id="table-licensee-report" class="freegrid table-licensee-report">
                </div>
            </div>
            <div data-ng-model="detailReportOptions.IsUpdateGrid" class="display-none table-detail-report-container">
                <div id="table-detail-report" class="freegrid table-detail-report">
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        parent.document.title = '@Resources.Language.Title_Report_CasinoDailyStatistics';
        window.rootUrl = '@Url.Content("~")';
        var currentDate = new Date('@clientDate');
        var casinoDailyEnhancementResources = {
            All: '@Labels.All',
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            Grand_Total: '@Labels.Grand_Total',
            Complaints_Enquiries: '@Labels.Complaints_Enquiries',
            ViewDetail: '@Labels.ViewDetail',
            ViewChart: '@Labels.ViewChart',
            DailyStatisticsReport_ChartSuffix: '@Labels.DailyStatisticsReport_ChartSuffix',
        };
    </script>
    @RazorHelper.RenderScripts("~/Scripts/CommomScripts",
        "~/Scripts/FanexGridScripts",
        "~/Scripts/FanexGridV2/NumeralScripts",
        "~/Scripts/AngularJSLibrary",      
        "~/Scripts/FanexMultipleSelect",
        "~/CRM/DownLoadFile/Scripts",
        "~/bundles/Report/CasinoDailyEnhancementScripts")
</body>
</html>