@using Fanex.CRM.Report.Resources;
@using Fanex.CRM.Report.Models;
@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Common.Helpers;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.DocumentTitle_DynamicReport;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
    @RazorHelper.RenderStyles("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.css")
    @RazorHelper.RenderStyles("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.css")
    @RazorHelper.RenderStyles("~/Content/site/customizeFanexGridV2.less")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/autocomplete/autocomplete.css")
    @RazorHelper.RenderStyles("~/Areas/Report/RedemptionStatisticsStyles")
}
<div data-ng-app="report-redemption-statistics-application">
    <div class="dynamicReportController" data-ng-controller="redemptionStatisticsController">
        <div class="main container">
            <div class="row" alert-box-container>
            </div>
            <div class="row filter-frm one-row expand-filter" data-ng-class="{ 'display-none': !isShowFilter }">
                <div class="row row-item">
                    <div class="pull-left">
                        <div class="item">
                            <label for="fromDate" class="width-80">
                                @Labels.From_Date</label>
                            <div class="display-inline-block date-picker-from-date-container" data-ng-model="fromDateOptions.IsRerenderPicker">
                                <input id="fromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                            </div>
                        </div>
                        <div class="item">
                            <label for="toDate" class="width-70">
                                @Labels.To_Date</label>
                            <div class="display-inline-block date-picker-to-date-container" data-ng-model="toDateOptions.IsRerenderPicker">
                                <input id="toDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item" status-multi-container data-ng-model="statusOptions.DataList">
                        <label for="status" class="width-80">
                            @Labels.Status</label>
                        <div class="selStatus">
                            <select id="status" class="selStatus">
                            </select>
                        </div>
                    </div>
                    <div class="item currency-picker-container" data-ng-model="currencyOptions.DataList">
                        <label for="currency" class="width-70">
                            @Labels.Currency</label>
                        <select id="currency" class="selCurrency">
                        </select>
                    </div>
                    <div class="item report-by-picker-container" data-ng-model="reportByOptions.DataList">
                        <label for="reportby" class="width-70">
                            @Labels.Report_by</label>
                        <select id="reportby" class="selReportBy">
                        </select>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item">
                        <label for="subject" class="width-80">
                            @Labels.Subject</label>
                        <input type="text" class="textbox search-by-enter txtSubject" id="subject" data-ng-model="searchCriteria.Subject" />
                    </div>
                    <div class="item">
                        <button id="button-submit" class="btn" data-ng-click="getRedemptionStatisticsReport()">
                            <span class="hotkey">S</span>ubmit</button>
                        <input type="text" class="textbox default-focus default-focus-element" data-ng-model="defaultFocusOptions.IsSetFocus" />
                    </div>
                </div>
                <div class="icon-collapse" data-ng-click="showHideFilterBox();">
                </div>
            </div>
            <div class="row filter-frm one-row collapse-filter display-none" data-ng-class="{ 'display-none': isShowFilter }">
                <div class="icon-expand" data-ng-click="showHideFilterBox();">
                </div>
            </div>
            <div>
                <div data-ng-model="redemptionStatisticsOptions.SummaryDataList" class="table-redemption-statistics-container"
                    id="summary-container" data-ng-class="{ 'display-none': !isShowSummary, '': isShowSummary }">
                    <div id="table-redemption-statistics-report" class="freegrid hide">
                    </div>
                </div>
                <div data-ng-model="redemptionStatisticsOptions.DetailDataList" class="table-redemption-statistics-detail-container"
                    id="summary-detail" data-ng-class="{ 'display-none': isShowSummary, '': !isShowSummary }">
                    <div id="table-redemption-statistics-detail-report" class="freegrid hide">
                    </div>
                </div>
            </div>
        </div>
        <div class="download-file-container" data-ng-model="downloadFileOptions">
            @*<iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>*@
        </div>
        <input type="text" class="textbox default-focus default-focus-element" data-ng-model="defaultFocusOptions.IsSetFocus" />
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/NumeralScripts")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.js")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.js")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/moment.js")
    @RazorHelper.RenderScripts("~/Scripts/common.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.highlight-3.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.autocomplete.client.js")
    @RazorHelper.RenderScripts("~/CRM/DownLoadFile/Scripts")
    @RazorHelper.RenderScripts("~/Areas/Report/RedemptionStatisticsScripts")
    <script type="text/javascript">
        parent.document.title = '@Resources.Language.Title_Report_RedemptionStatistics';
        parent.document.title = document.title;
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()';
        var currentTime = new Date(currentDate);
        var initFromDate = '@DateTimeUtilize.CurrentClientTime().FirstDayOfMonth().ToShortFormatedDate()';
        var viewResources = {
            All: '@Labels.All',
            AllStatus: 'All',
            Symbol_NotApply: '@Labels.No_status',
            No_status_found: '@Labels.No_status_found',
        };
    </script>
}