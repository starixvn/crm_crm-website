@using Fanex.CRM.Report.Resources
@model Fanex.CRM.Report.Criteria.FeedbackStatisticReport.GetFeedbackStatisticDetailCriteria
@{
    var criteria = Newtonsoft.Json.JsonConvert.SerializeObject(Model);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="feedback-statistic-detail-application">
<head>
    <title>@Resources.Language.Title_Report_FeedbackStatistics</title>
    @Styles.Render("~/site/common", "~/bundles/Report/FeedbackStatisticDetailStyles")
</head>
<body>
    <div class="main container" data-ng-controller="feedbackStatisticDetailController">
        <div class="row">
            <div table-feedback-statistic-detail-container data-ng-model="feedbackStatisticDetail">
                <div id="table-feedback-statistic-detail" class="freegrid hide"></div>
            </div>
        </div>
        <div class="download-file-container hide" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0"></iframe>
        </div>
    </div>
   
   <script type="text/javascript">
       window.rootUrl = '@Url.Content("~")';
       var criteria = @Html.Raw(criteria);
       var feedbackStatisticDetailResources = {
            Feedback: '@Labels.Feedback',
            Customer: '@Labels.Customer',
            Category: '@Labels.Category',
            SubCategory: '@Labels.SubCategory',
            Status: '@Labels.Status',
            RelatedCustomer: '@Labels.RelatedCustomer'
        };
   </script>
   @Scripts.Render("~/Scripts/CommomScripts",
        "~/Scripts/FanexGridScripts",
        "~/Scripts/AngularJSLibrary",
        "~/CRM/DownLoadFile/Scripts",
        "~/bundles/Report/FeedbackStatisticDetailScripts")
</body>
</html>