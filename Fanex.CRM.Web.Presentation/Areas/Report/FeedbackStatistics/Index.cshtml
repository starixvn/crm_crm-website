@using Fanex.CRM.Report.Resources
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@model Fanex.CRM.Infrastructure.Models.BaseModel[]
@{
    DateTime currentClientTime = DateTimeUtilize.GetCurrentClientTime();
    string currentClientTimeString = currentClientTime.ToShortFormatedDate();
    string previousWeekTimeString = currentClientTime.AddDays(-7).ToShortFormatedDate();
    var settings = Newtonsoft.Json.JsonConvert.SerializeObject(Model);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="feedback-statistic-application">
<head>
    <title>@Resources.Language.Title_Report_FeedbackStatistics</title>
    @Styles.Render("~/site/common", "~/bundles/Report/FeedbackStatisticStyles")
</head>
<body>
    <div class="main container" data-ng-controller="feedbackStatisticController">
        <div class="row filter-frm one-row">
            <form data-ng-submit="getFeedbackStatistic()" novalidate>
            <div class="row row-item">
                <div class="item">
                    <select class="ddlType" data-ng-model="setting" ng-options="s.Name for s in settings">
                    </select>
                </div>
                <div class="item">
                    <label for="fromDate">@Labels.From_Date</label>
                    <div class="display-inline-block date-picker-from-date-container" data-ng-model="fromDateOptions.IsRerenderPicker">
                        <input id="fromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                    </div>
                </div>
                <div class="item">
                    <label for="toDate">@Labels.To_Date</label>
                    <div class="display-inline-block date-picker-to-date-container" data-ng-model="toDateOptions.IsRerenderPicker">
                        <input id="toDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                    </div>
                </div>
                <div class="item">
                    <button class="btn"><span class="hotkey">S</span>ubmit</button>
                </div>
            </div>
            <div class="row row-item">
                <div class="item width-78">@Labels.FromDuration</div>
                <div class="item day" number-only-input 
                    input-class="textbox"
                    input-value="fromDuration.Day"
                    input-label="@Labels.Day">
                </div>
                <div class="item day" number-only-input 
                    input-class="textbox"
                    input-value="fromDuration.Hour"
                    input-label="@Labels.Hour">
                </div>
                <div class="item day" number-only-input 
                    input-class="textbox"
                    input-value="fromDuration.Minute"
                    input-label="@Labels.Minute">
                </div>
                <div class="item day" number-only-input 
                    input-class="textbox"
                    input-value="fromDuration.Second"
                    input-label="@Labels.Second">
                </div>
            </div>
            <div class="row">
                <div class="item width-78">@Labels.ToDuration</div>
                <div class="item day" number-only-input 
                    input-class="textbox"
                    input-value="toDuration.Day"
                    input-label="@Labels.Day">
                </div>
                <div class="item day" number-only-input 
                    input-class="textbox"
                    input-value="toDuration.Hour"
                    input-label="@Labels.Hour">
                </div>
                <div class="item day" number-only-input 
                    input-class="textbox"
                    input-value="toDuration.Minute"
                    input-label="@Labels.Minute">
                </div>
                <div class="item day" number-only-input 
                    input-class="textbox"
                    input-value="toDuration.Second"
                    input-label="@Labels.Second">
                </div>
            </div>
            </form>
        </div>
        <div class="row" alert-box-container></div>
        <div class="row">
            <div table-feedback-statistic-container data-ng-model="feedbackStatistic">
                <div id="table-feedback-statistic" class="freegrid hide"></div>
            </div>
        </div>
        <div class="download-file-container hide" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0"></iframe>
        </div>
    </div>
   
   <script type="text/javascript">
       parent.document.title = '@Resources.Language.Title_Report_FeedbackStatistics';
       window.rootUrl = '@Url.Content("~")';
       var currentDate = new Date('@currentClientTimeString');
       var previousWeek = new Date('@previousWeekTimeString');
       var settings = @Html.Raw(settings);
       var feedbackStatisticResources = {
           InvalidDuration: '@Labels.FeedbackStatistics_InvalidDuration',
           ViewChart: '@Labels.ViewChart',
           ViewDetail: '@Labels.ViewDetail',
           SubCategory: '@Labels.SubCategory',
           SubTotal: '@Labels.SubTotal',
           GrandTotal: '@Labels.GrandTotal',
           Feedbacks: '@Labels.Feedbacks',
           Items: '@Labels.Items',
           GoBack: '@Labels.GoBack',
           NoDataFound: '@Labels.NoDataFound',
           FeedbackStatisticDetailReport: '@Labels.FeedbackStatisticDetailReport'
       };
   </script>
   @Scripts.Render("~/Scripts/CommomScripts",
        "~/Scripts/FanexGridScripts",
        "~/Scripts/FanexGridV2/NumeralScripts",
        "~/Scripts/AngularJSLibrary",
        "~/CRM/DownLoadFile/Scripts",
        "~/bundles/Report/FeedbackStatisticScripts")
</body>
</html>