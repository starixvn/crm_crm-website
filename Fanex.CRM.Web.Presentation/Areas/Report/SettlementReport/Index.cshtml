@using Fanex.CRM.Report.Resources;
@using Fanex.CRM.Report.Models;
@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Common.Services;
@using Fanex.CRM.Common.Helpers;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@section Styles{
    @RazorHelper.RenderStyles("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.css")
    @RazorHelper.RenderStyles("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.css")
    @RazorHelper.RenderStyles("~/Content/site/customizeFanexGridV2.less")
    @RazorHelper.RenderStyles("~/Content/site/ResultMessageStyles")
    @RazorHelper.RenderStyles("~/Areas/Report/SettlementReportStyles")
}
<div data-ng-app="report-settlementreport-application">
    <div class="settlementReportController" data-ng-controller="settlementReportController">
        <div class="result-message-container display-none">
        </div>
        <div class="main container">
            <div>
                <div class="row filter-frm one-row">
                    <div class="pull-left">
                        <div class="item year-picker-from-date-container" data-ng-model="fromYearOptions">
                            <label for="fromdate_year" class="width-80">
                                @Labels.Year
                            </label>
                            <select id="fromdate_year" class="selYear"></select>
                        </div>
                    </div>
                    <div class="item">
                        <button id="button-submit" class="btn" data-ng-click="getSettlementReport()">
                            <span class="hotkey">S</span>ubmit
                        </button>
                    </div>
                </div>
                <div data-ng-model="settlementReportOptions.IsUpdateGrid" class="table-settlement-report-container">
                    <div id="table-settlement-report" class="freegrid display-none table-settlement-report">
                    </div>
                </div>
            </div>
        </div>
        <div class="download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
        <input type="text" class="textbox default-focus default-focus-element" data-ng-model="defaultFocusOptions.IsSetFocus" />
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/NumeralScripts")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridScripts")
    @RazorHelper.RenderScripts("~/Scripts/ShareScripts/Applications/ResultMessageScripts")
    @RazorHelper.RenderScripts("~/CRM/DownLoadFile/Scripts")
    @RazorHelper.RenderScripts("~/Areas/Report/SettlementReportScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentDate = new Date('@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()');
        var minReportDate = new Date('@AppSetting.MinReportDate.ToShortFormatedDate()');
        var viewResources = {
            Month: '@Labels.Month',
            Country: '@Labels.Country',
            Amount: '@Labels.Amount',
            Total: '@Labels.Total',
            SettlementReport_ChartSuffix: '@Labels.SettlementReport_ChartSuffix'
        };
    </script>
}