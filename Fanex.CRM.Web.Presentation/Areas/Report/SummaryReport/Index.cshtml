@using Fanex.CRM.Report.Resources;
@using Fanex.CRM.Report.Models;
@using Fanex.CRM.Infrastructure.Extension;
@using Fanex.CRM.Infrastructure.Core;
@using Fanex.CRM.Infrastructure.Common;
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="report-summaryreport-application">
<head>
    <title>@Labels.SummaryReport</title>
    @Styles.Render("~/site/common")
    <link href="@Url.Content("~/Scripts/FanexGridV2/Fanex.Grid.css?ver=1")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/FanexGridV2/Fanex.Pagination.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/site/customizeFanexGridV2.less?ver=1")" rel="stylesheet" type="text/css" />
    @Styles.Render("~/Areas/Report/SummaryReportStyles", "~/Content/site/ResultMessageStyles")
</head>
<body>
    <div class="container main" data-ng-controller="summaryReportController">
    <div class="result-message-container display-none">
    </div>
        <div class="row filter-frm one-row summary-filter">
            <form data-ng-submit="getSummaryReport()">
                <div class="item">
                    <label for="year">@Labels.Year</label>
                    <select id="year" class="sel-year" data-ng-model="year" data-ng-options="y.value for y in years"></select>
                </div>
                <div class="item">
                    <button class="btn default-focus"
                        data-ng-model="defaultFocusOptions.IsSetFocus"><span class="hotkey">S</span>ubmit</button>
                </div>
            </form>
        </div>
        <div class="row">
            <div data-ng-model="summaryReport" table-summary-report-container>
                <div id="table-summary-report" class="freegrid display-none">
                </div>
            </div>
        </div>
        <div class="row download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
    </div>

    @Scripts.Render("~/Scripts/CommomScripts", "~/Scripts/FanexGridV2/NumeralScripts")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    <script type="text/javascript" src="~/Scripts/FanexGridV2/Fanex.Pagination.js"></script>
    <script type="text/javascript" src="~/Scripts/FanexGridV2/Fanex.Grid.js"></script>
    @Scripts.Render("~/Areas/Report/SummaryReportScripts", "~/Scripts/ShareScripts/Applications/ResultMessageScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentDate = new Date('@DateTimeUtilize.GetCurrentClientTime().ToShortFormatedDate()');
        var minReportDate = new Date('@AppSetting.MinReportDate.ToShortFormatedDate()');
        var summaryReportResources = {
            Year: '@Labels.Year',
            Categories: '@Labels.Categories',
            GrandTotal: '@Labels.GrandTotal',
            Jan: '@Labels.JAN',
            Feb: '@Labels.FEB',
            Mar: '@Labels.MAR',
            Apr: '@Labels.APR',
            May: '@Labels.MAY',
            Jun: '@Labels.JUN',
            Jul: '@Labels.JUL',
            Aug: '@Labels.AUG',
            Sep: '@Labels.SEP',
            Oct: '@Labels.OCT',
            Nov: '@Labels.NOV',
            Dec: '@Labels.DEC'
        }; 
    </script>
</body>
</html>
