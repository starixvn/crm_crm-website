﻿@using Fanex.CRM.Report.Resources;
@using Fanex.CRM.Report.Models;
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isCn88 = (ViewBag.UserRole == Fanex.CRM.Common.Enumerations.UserRole.CN88Staff);
    var hideSiteClass = isCn88 ? "hide-item" : "";

    ViewBag.Title = Labels.Customer_Report;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/FanexGridV2/Fanex.Grid.css")
    @RazorHelper.RenderStyles("~/Scripts/FanexGridV2/Fanex.Pagination.css")
    @RazorHelper.RenderStyles("~/Content/site/customizeFanexGridV2.less")
    @RazorHelper.RenderStyles("~/Areas/Report/CustomerReportStyles")
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
}
<div data-ng-app="report-customerreport-application">
    <div class="customerReportController" data-ng-controller="customerReportController">
        <div class="main container">
            <div class="row" data-ng-show="errorMessage !== ''">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="alertboxerr">
                        <div data-ng-bind="errorMessage">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row filter-frm one-row expand-filter" data-ng-class="{ 'display-none': !isShowFilter }">
                <div class="row row-item">
                    <div class="item default-focus" data-ng-model="defaultFocusOptions.IsSetFocus">
                        <label for="username" class="width-70">
                            @Labels.Username
                        </label>
                        <input type="text" class="textbox search-by-enter" id="username" data-ng-model="searchCriteria.Username" />
                    </div>
                    <div class="item">
                        <label for="viptype" class="width-50 pull-left">
                            @Labels.VIP
                        </label>
                        <div class="vip-type-picker-container pull-left" data-ng-model="vipTypeOptions.DataList">
                            <select id="viptype" class="selVipType"></select>
                        </div>
                    </div>
                    <div class="item default-focus">
                        <label for="headline" class="width-50">
                            @Labels.Headline
                        </label>
                        <input type="text" class="textbox search-by-enter" id="headline" data-ng-model="searchCriteria.Headline" />
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item">
                        <label for="language" class="width-70 pull-left">
                            @Labels.Language
                        </label>
                        <div class="language-picker-container selCustomerType pull-left" data-ng-model="languageOptions.DataList">
                            <select id="language"></select>
                        </div>
                    </div>
                    <div class="item @hideSiteClass">
                        <label for="site" class="width-50 pull-left">
                            @Labels.Site
                        </label>
                        <div class="site-picker-container pull-left" data-ng-model="siteOptions.DataList">
                            <select id="site"></select>
                        </div>
                    </div>
                    <div class="item">
                        <label for="position" class="width-50 pull-left">
                            @Labels.Position
                        </label>
                        <div class="position-picker-container pull-left position-div" data-ng-model="positionOptions.DataList">
                            <select id="position"></select>
                        </div>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item">
                        <label for="excludeIgnoredAccounts" class="labelforcheckbox checkbox">
                            <input id="excludeIgnoredAccounts" type="checkbox" data-ng-model="searchCriteria.ExcludeIgnoredAccounts">
                            @Labels.ExcludeIgnoredAccounts
                        </label>
                    </div>
                    <div class="item">
                        <button id="button-submit" class="btn" data-ng-click="getCustomerReport();">
                            <span class="hotkey">S</span>ubmit
                        </button>
                    </div>
                </div>
                <div class="icon-collapse" data-ng-click="showHideFilterBox();">
                </div>
            </div>
            <div class="row filter-frm one-row collapse-filter display-none" data-ng-class="{ 'display-none': isShowFilter }">
                <div class="icon-expand" data-ng-click="showHideFilterBox();">
                </div>
            </div>
            <div class="row">
                <div data-ng-model="customerReportOptions.IsUpdateGrid" class="table-customer-report-container">
                    <div id="table-customer-report" class="freegrid display-none table-customer-report">
                    </div>
                </div>
            </div>
        </div>
        <div class="download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
        <input type="text" class="textbox default-focus default-focus-element" data-ng-model="defaultFocusOptions.IsSetFocus" />
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/FanexMultipleSelect")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/Fanex.Pagination.js")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/Fanex.Grid.js")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/moment.js")
    @RazorHelper.RenderScripts("~/CRM/DownLoadFile/Scripts")
    @RazorHelper.RenderScripts("~/Areas/Report/CustomerReportScripts")
    <script type="text/javascript">
        parent.document.title = '@Resources.Language.Title_Report_CustomerReport';
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()';
        var initFromDate = '@DateTimeUtilize.CurrentClientTime().FirstDayOfMonth().ToShortFormatedDate()';
        var isCN88 = '@isCn88' == 'True';

        var viewResources = {
            All: '@Labels.All',
            All_Languages: '@Labels.All_Languages',
            No_language_found: '@Labels.No_language_found',
            Symbol_NotApply: '@Labels.Symbol_NotApply',

            All_Countries: '@Labels.All_Countries',
            No_country_found: '@Labels.No_country_found',
            All_Sites: '@Labels.All_Sites',
            No_site_found: '@Labels.No_site_found',

            VIP: '@Labels.VIP',
            Title: '@Labels.Title',
            First_Name: '@Labels.First_Name',
            Last_Name: '@Labels.Last_Name',
            Country: '@Labels.Country',
            Languages: '@Labels.Languages',
            Birthday: '@Labels.Birthday',
            CustomerReport_Title: '@Labels.CustomerReport_Title',
            Contact_Number: '@Labels.Contact_Number',
            Mobile: '@Labels.Mobile',
            Fax: '@Labels.Fax',
            Skype: '@Labels.Skype',
            Email: '@Labels.Email',
            MSN: '@Labels.MSN',
            WhatsApp: '@Labels.WhatsApp',
            Line: '@Labels.Line',
            WeChat: '@Labels.WeChat',
            Yahoo: '@Labels.Yahoo',
            BBM: '@Labels.BBM',
            QQ: '@Labels.QQ',
            Line_1: '@Labels.Line_1',
            Line_2: '@Labels.Line_2',
            Line_3: '@Labels.Line_3',
            City: '@Labels.City',
            State: '@Labels.State',
            Post_Code: '@Labels.Post_Code',
            Username: '@Labels.Username',
            PIC1: '@Labels.PIC1',
            PIC2: '@Labels.PIC2',
            PIC3: '@Labels.PIC3',
            PIC4: '@Labels.PIC4',
            Headline: '@Labels.Headline',
            Checker: '@Labels.Checker',
            FirstName: '@Labels.First_Name',
            LastName: '@Labels.Last_Name',
            Phone1: '@Labels.Phone 1',
            Phone2: '@Labels.Phone 2',
            Phone3: '@Labels.Phone 3',
            Passport: '@Labels.Passport',
            SiteName: '@Labels.SiteName',
            Position: '@Labels.Position',
            Status: '@Labels.Status',
            Province: '@Labels.Province'
        };
    </script>
}