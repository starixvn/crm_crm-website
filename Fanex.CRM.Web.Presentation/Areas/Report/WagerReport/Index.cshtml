@using Fanex.CRM.Report.Resources;
@using Fanex.CRM.Report.Models;
@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Common.Services;
@using Fanex.CRM.Common.Helpers;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.WagerReport;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Areas/Report/WagerReportStyles", "~/Content/site/ResultMessageStyles")
}
<div data-ng-app="report-wagerreport-application">
    <div class="container main" data-ng-controller="wagerReportController">
        <div class="result-message-container display-none">
        </div>
        <div class="row filter-frm one-row wager-filter">
            <form data-ng-submit="getWagerReport()">
            <div class="item">
                <label for="year">@Labels.Year</label>
                <select id="year" data-ng-model="year" data-ng-options="y.value for y in years">
                </select>
            </div>
            <div class="item">
                <button class="btn default-focus" data-ng-model="defaultFocusOptions.IsSetFocus">
                    <span class="hotkey">S</span>ubmit</button>
            </div>
            </form>
        </div>
        <div class="row">
            <div data-ng-model="wagerReport" table-wager-report-container>
                <div id="table-wager-report" class="freegrid display-none">
                </div>
            </div>
        </div>
        <div class="row download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/NumeralScripts")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.js")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.js")
    @RazorHelper.RenderScripts("~/CRM/DownLoadFile/Scripts",
        "~/Areas/Report/WagerReportScripts",
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        parent.document.title = '@Resources.Language.Title_Report_WagerReport';
        var currentDate = new Date('@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()');
        var minReportDate = new Date('@AppSetting.MinReportDate.ToShortFormatedDate()');
        var wagerReportResources = {
            Year: '@Labels.Year',
            Month: '@Labels.Month',
            Wagers: '@Labels.Wagers',
            Amount: '@Labels.Amount',
            Total: '@Labels.Total',
            GrandTotal: '@Labels.GrandTotal'
        };
    </script>
}