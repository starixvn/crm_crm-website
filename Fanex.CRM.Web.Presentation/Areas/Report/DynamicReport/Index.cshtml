@using Fanex.CRM.Report.Resources;
@using Fanex.CRM.Report.Models;
@using Fanex.CRM.Infrastructure.Extension;
@using Fanex.CRM.Infrastructure.Core;
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="report-dynamicreport-application">
<head>
    <title>@Labels.Dynamic_Report </title>
    @Styles.Render("~/site/common")
    <link href="@Url.Content("~/Scripts/FanexGridV2/Fanex.Grid.css?ver=1")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/FanexGridV2/Fanex.Pagination.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/site/customizeFanexGridV2.less?ver=1")" rel="stylesheet" type="text/css" />
    @Styles.Render("~/Areas/Report/DynamicReportStyles")
</head>
<body class="dynamicReportController" data-ng-controller="dynamicReportController">
    <div class="main container">
        <div class="row filter-frm one-row expand-filter" data-ng-class="{ 'display-none': !isShowFilter }">
            <div class="row row-item">
                <div class="item">
                    <label for="reporttype" class="width-70 pull-left">
                        @Labels.Group_By</label>
                    <div class="report-type-container pull-left" data-ng-model="reportTypeOptions.DataList">
                        <select id="reporttype" class="selReportType">
                        </select>
                    </div>
                </div>
                <div class="pull-left display-none" data-ng-class="{'display-none': searchCriteria.ReportType.Id !== crmConstants.Enums.PeriodType.Daily}">
                    <div class="item">
                        <label for="fromDate" class="width-80">
                            @Labels.From_Date</label>
                        <div class="display-inline-block date-picker-from-date-container" data-ng-model="fromDateOptions.IsRerenderPicker">
                            <input id="fromDate" type="text" class="textbox txtcalendar" />
                        </div>
                    </div>
                    <div class="item">
                        <label for="toDate" class="width-50">
                            @Labels.To_Date</label>
                        <div class="display-inline-block date-picker-to-date-container" data-ng-model="toDateOptions.IsRerenderPicker">
                            <input id="toDate" type="text" class="textbox txtcalendar" />
                        </div>
                    </div>
                </div>
                <div class="pull-left display-none" data-ng-class="{'display-none': searchCriteria.ReportType.Id !== crmConstants.Enums.PeriodType.Weekly}">
                    <div class="item">
                        <label for="fromweek" class="width-80">
                            @Labels.From_Week</label>
                        <div class="display-inline-block week-picker-from-week-container" data-ng-model="fromWeekOptions.IsRerenderPicker">
                            <input id="fromweek" type="text" readonly="readonly" class="textbox txtcalendar weekpicker ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate hasDatepicker"
                                data-maxdate="@DateTimeUtilize.GetCurrentClientTime().ToShortFormatedDate()"
                                data-value="@DateTimeUtilize.GetCurrentClientTime().ToShortFormatedDate()"
                                data-isendweek="false" />
                        </div>
                    </div>
                    <div class="item">
                        <label for="toDate">
                            @Labels.To_Week</label>
                        <div class="display-inline-block week-picker-to-week-container" data-ng-model="toWeekOptions.IsRerenderPicker">
                            <input id="toweek" type="text" readonly="readonly" class="textbox txtcalendar weekpicker ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate hasDatepicker"
                                 data-maxdate="@DateTimeUtilize.GetCurrentClientTime().ToShortFormatedDate()"
                                 data-value="@DateTimeUtilize.GetCurrentClientTime().ToShortFormatedDate()"
                                 data-isendweek="true" />
                        </div>
                    </div>
                </div>
                <div class="pull-left display-none" data-ng-class="{'display-none': searchCriteria.ReportType.Id !== crmConstants.Enums.PeriodType.Monthly}">
                    <div class="item month-picker-from-month-container" data-ng-model="fromMonthOptions.IsRerenderPicker">
                        <label for="frommonth" class="width-80">
                            @Labels.From_Month</label>
                        <select id="frommonth_month">
                        </select>
                        <select id="frommonth_year">
                        </select>
                    </div>
                    <div class="item month-picker-to-month-container" data-ng-model="toMonthOptions.IsRerenderPicker">
                        <label for="tomonth">
                            @Labels.To_Month</label>
                        <select id="tomonth_month">
                        </select>
                        <select id="tomonth_year">
                        </select>
                    </div>
                </div>
                <div class="pull-left display-none" data-ng-class="{'display-none': searchCriteria.ReportType.Id !== crmConstants.Enums.PeriodType.Yearly}">
                    <div class="item year-picker-from-date-container" data-ng-model="fromYearOptions.IsRerenderPicker">
                        <label for="frommonth" class="width-80">
                            @Labels.From_Year</label>
                        <select id="fromdate_year" class="selYear">
                        </select>
                    </div>
                    <div class="item year-picker-to-date-container" data-ng-model="toYearOptions.IsRerenderPicker">
                        <label for="tomonth" class="width-50">
                            @Labels.To_Year</label>
                        <select id="todate_year" class="selYear toYear">
                        </select>
                    </div>
                </div>
            </div>
            <div class="row row-item">
                <div class="item status-picker-container" data-ng-model="statusOptions.DataList">
                    <label for="status" class="width-70">
                        @Labels.Status</label>
                    <select id="status" class="selStatus">
                    </select>
                </div>
                <div class="item response-picker-container" data-ng-model="responseOptions.DataList">
                    <label for="response" class="width-80">
                        @Labels.Response</label>
                    <select id="response" class="selReponse">
                    </select>
                </div>
                <div class="item product-picker-container" data-ng-model="productOptions.DataList">
                    <label for="product" class="width-50">
                        @Labels.Product</label>
                    <select id="product" class="selProduct">
                    </select>
                </div>
                <div class="item site-picker-container" data-ng-model="siteOptions.DataList">
                    <label for="site" class="width-110">
                        @Labels.Site</label>
                    <select id="site" class="selSite">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="item">
                    <label for="handler" class="width-70">
                        @Labels.Handled_By</label>
                    <input type="text" class="textbox search-by-enter txtHandle" id="handler" data-ng-model="searchCriteria.Handler" />
                </div>
                <div class="item">
                    <label for="reviewer" class="width-80">
                        @Labels.Reviewed_By</label>
                    <input type="text" class="textbox search-by-enter txtReview" id="reviewer" data-ng-model="searchCriteria.Reviewer" />
                </div>
                <div class="item role-picker-container" data-ng-model="roleOptions.DataList">
                    <label for="role" class="width-50">
                        @Labels.Role</label>
                    <select id="role" class="selRole">
                    </select>
                </div>
                <div class="item communication-tool-picker-container" data-ng-model="communicationToolOptions.DataList">
                    <label for="communication-tool" class="width-110">
                        @Labels.Communication_Tool</label>
                    <select id="communication-tool" class="selCommunication">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="item extension-picker-container" data-ng-model="extensionOptions.DataList">
                    <label for="extension" class="lblExtension width-70">
                        @Labels.Extension</label>
                    <select id="extension" class="selExtension">
                    </select>
                </div>
                <div class="item main-category-picker-container" data-ng-model="mainCategoryOptions.DataList">
                    <label for="main-category">
                        @Labels.Main_Category</label>
                    <select id="main-category" class="selCategory">
                    </select>
                </div>
                <div class="item sub-category-picker-container" data-ng-model="subCategoryOptions.DataList">
                    <label for="sub-category" class="width-110">
                        @Labels.Sub_Category</label>
                    <select id="sub-category" class="selSubCategory">
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="item">
                    <button id="button-submit" class="btn default-focus" data-ng-click="getDynamicReport()"
                        data-ng-model="defaultFocusOptions.IsSetFocus">
                        <span class="hotkey">S</span>ubmit</button>
                </div>
            </div>
            <div class="icon-collapse" data-ng-click="showHideFilterBox();">
            </div>
        </div>
        <div class="row filter-frm one-row collapse-filter display-none" data-ng-class="{ 'display-none': isShowFilter }">
            <div class="icon-expand" data-ng-click="showHideFilterBox();">
            </div>
        </div>
        <div>
            <div data-ng-model="dynamicReportOptions.IsUpdateGrid" class="table-dynamic-report-container">
                <div id="table-dynamic-report" class="freegrid display-none table-dynamic-report">
                </div>
            </div>
        </div>
    </div>
    <div class="download-file-container" data-ng-model="downloadFileOptions">
        <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
    </div>
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    <script type="text/javascript" src="~/Scripts/FanexGridV2/Fanex.Pagination.js"></script>
    <script type="text/javascript" src="~/Scripts/FanexGridV2/Fanex.Grid.js"></script>
    <script type="text/javascript" src="~/Scripts/FanexGridV2/moment.js"></script>
    @Scripts.Render("~/Areas/Report/DynamicReportScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTimeUtilize.GetCurrentClientTime().ToShortFormatedDate()';
        var initFromDate = '@DateTimeUtilize.GetCurrentClientTime().FirstDayOfMonth().ToShortFormatedDate()';
        var viewResources = {
            All: '@Labels.All',
            Running_No: '@Labels.Running_No',
            Feedback_Date: '@Labels.Feedback_Date',
            Main_Category: '@Labels.Main_Category',
            Sub_Category: '@Labels.Sub_Category',
            Subject: '@Labels.Subject',
            Status: '@Labels.Status',
            Duration: '@Labels.Duration',
            Handled_By: '@Labels.Handled_By',
            Reviewed_By: '@Labels.Reviewed_By',
            Symbol_No: '@Labels.Symbol_No'
        }; 
    </script>
</body>
</html>
