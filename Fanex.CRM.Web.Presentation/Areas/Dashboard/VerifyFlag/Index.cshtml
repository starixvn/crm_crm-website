@using Fanex.CRM.Dashboard.Resources;
@using Newtonsoft.Json;
@using Fanex.CRM.Dashboard.Models;
@using Fanex.CRM.Common.Extensions;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.Verify_Customer_Info;

    var jsonCustomerInfo = JsonConvert.SerializeObject(Model);
    var hasCreateUpdateFeedbackPermission = (bool)ViewBag.HasCreateUpdateFeedbackPermission;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/autocomplete/autocomplete.css")
    @RazorHelper.RenderStyles("~/Areas/Dashboard/VerifyFlagStyles")
}
<div data-ng-app="dashboard-verifyflag-application">
    <div class="main popup container" data-ng-controller="verifyFlagController">
        <div class="row row-item" data-ng-show="isShowResultMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ isSuccess ? 'scc' : 'err' }}" class="alertbox{{ isSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="resultMessage">
                    </div>
                </div>
            </div>
        </div>
        <div class="row form-group">
            <div class="row row-item">
                <div class="col-xs-4 col-sm-3 col-md-3">
                    <label for="email" class="labelforcheckbox checkbox">
                        <input id="email" type="checkbox" data-ng-model="customerInfo.IsVerifyEmail" />
                        @Labels.Email</label></div>
                <div class="col-xs-8 col-sm-9 col-md-9 txtValue link labelemail">
                    <span data-ng-bind="customerInfo.Email"></span>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-4 col-sm-3 col-md-3">
                    <label for="passportnumber" class="labelforcheckbox checkbox">
                        <input id="passportnumber" type="checkbox" data-ng-model="customerInfo.IsVerifyPassport" />
                        @Labels.Passport_Number</label></div>
                <div class="col-xs-8 col-sm-9 col-md-9 txtValue">
                    <span data-ng-bind="customerInfo.Passport"></span>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-4 col-sm-3 col-md-3">
                    <label for="birthday" class="labelforcheckbox checkbox">
                        <input id="birthday" type="checkbox" data-ng-model="customerInfo.IsVerifyBirthday" />
                        @Labels.Birthday</label></div>
                <div class="col-xs-8 col-sm-9 col-md-9 txtValue">
                    <span data-ng-bind="customerInfo.BirthDay"></span>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-4 col-sm-3 col-md-3">
                    <label for="secretcode" class="labelforcheckbox checkbox">
                        <input id="secretcode" type="checkbox" data-ng-model="customerInfo.IsVerifySecretCode" />
                        @Labels.Secret_Code</label></div>
                <div class="col-xs-8 col-sm-9 col-md-9 txtValue">
                    <span data-ng-bind="customerInfo.SecretCode"></span>
                </div>
            </div>
            <div class="row row-item" data-ng-show="isShowBetCredit();">
                <div class="col-xs-4 col-sm-3 col-md-3">
                    <label for="betcredit" class="labelforcheckbox checkbox">
                        <input id="betcredit" type="checkbox" data-ng-model="customerInfo.IsVerifyBetCredit" />
                        @Labels.Bet_Credit</label></div>
                <div class="col-xs-8 col-sm-9 col-md-9 txtValue">
                    <span data-ng-bind="getFormatedCredit(customerInfo.BetCredit)"></span>
                </div>
            </div>
            <div class="row row-item" data-ng-show="isShowGivenCredit();">
                <div class="col-xs-4 col-sm-3 col-md-3">
                    <label for="givencredit" class="labelforcheckbox checkbox">
                        <input id="givencredit" type="checkbox" data-ng-model="customerInfo.IsVerifyGivenCredit" />
                        @Labels.Given_Credit</label></div>
                <div class="col-xs-8 col-sm-9 col-md-9 txtValue">
                    <span data-ng-bind="getFormatedCredit(customerInfo.GivenCredit)"></span>
                </div>
            </div>
        </div>
        @if (hasCreateUpdateFeedbackPermission)
        {
            <div class="row">
                <button class="btn" data-ng-click="updateCustomerVerifyFlag();">
                    <span class="hotkey">S</span>ave</button>
            </div>
        }
        <input type="text" class="textbox default-focus-element" default-focus data-ng-model="isSetFocus" />
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Areas/Dashboard/VerifyFlagScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTime.Now';
        var viewResources = {
        Confirm_Ignore_EditVerifyFlag_Changes: '@Html.Raw(Labels.Confirm_Ignore_EditVerifyFlag_Changes)'
        };

        angular.module('dashboard-verifyflag-application').factory('$bootstrappedData', function () {
            return {
                customerInfo: @Html.Raw(jsonCustomerInfo)
            };
        });
    </script>
}
