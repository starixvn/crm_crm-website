@using Fanex.CRM.Dashboard.Resources;
<div class="row panel-group last specialRemark">
    <div class="row title">
        @Labels.Last_5_Special_Remark
    </div>
    <div class="nodata-message" data-ng-class="{ 'display-none': customerRemarks !== undefined && customerRemarks !== null && customerRemarks.length !== 0 }">@Labels.There_is_no_data</div>
    <ul class="custinfo row content list-unstyled">
        <li data-ng-repeat="remark in customerRemarks track by $index" data-ng-bind="$index + 1 + '. ' + customerRemarks[$index]">
        </li>
    </ul>
</div>
