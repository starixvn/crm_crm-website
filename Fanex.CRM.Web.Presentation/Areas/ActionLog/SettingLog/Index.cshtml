@using Fanex.CRM.ActionLog.Resources;
@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Common.Helpers;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Setting_Logs;

    var currentDate = DateTimeUtilize.CurrentClientTime();
}
@section Styles{
    @RazorHelper.RenderStyles("~/Areas/ActionLog/SettingLogStyles")
}
<div data-ng-app="settinglog-application">
    <div class="container main" data-ng-controller="settingLogController">
        <div class="row filter-frm one-row redemption-filter">
            <form data-ng-submit="searchSettingLogs()">
            <div class="item">
                <label for="username">@Labels.Handler</label>
                <input type="text" class="textbox" id="username" data-ng-model="searchCriteria.Username" />
            </div>
            <div class="item">
                <label for="fromDate">@Labels.FromDate</label>
                <div class="display-inline-block" data-ng-model="searchCriteria.MaxFromDate" date-picker-from-date-container>
                    <input id="fromDate" type="text" class="textbox txtcalendar" />
                </div>
            </div>
            <div class="item">
                <label for="toDate">@Labels.ToDate</label>
                <div class="display-inline-block" data-ng-model="searchCriteria.MinToDate" date-picker-to-date-container>
                    <input id="toDate" type="text" class="textbox txtcalendar" />
                </div>
            </div>
            <div class="item afterButton">
                <label for="action">@Labels.Action</label>
                <select id="action" class="sel-action" data-ng-model="searchCriteria.Action" ng-options="a.Name for a in actions">
                </select>
            </div>
            <div class="item">
                <button class="btn">
                    <span class="hotkey">S</span>ubmit</button>
            </div>
            </form>
        </div>
        <div class="row">
            <div data-ng-model="settingLogs" table-setting-logs-container>
                <div id="table-setting-logs" class="freegrid display-none">
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
        @RazorHelper.RenderScripts("~/Areas/ActionLog/SettingLogScripts")
        <script type="text/javascript">
            parent.document.title = '@Resources.Language.Title_AdminTool_SettingLog';
            window.rootUrl = '@Url.Content("~")';
            var currentDate = '@currentDate.ToShortFormatedDate()';
            var initFromDate = '@currentDate.FirstDayOfMonth().ToShortFormatedDate()';
            var settingLogResources = {
                All: '@Labels.All',
                LogTime: '@Labels.LogTime',
                EditedBy: '@Labels.EditedBy',
                Action: '@Labels.Action',
                Entity: '@Labels.Entity',
                EntityId: '@Labels.EntityId',
                FieldName: '@Labels.FieldName',
                OldValue: '@Labels.OldValue',
                NewValue: '@Labels.NewValue',
                Setting_Logs: '@Labels.Setting_Logs'
            };
            $('#username').focus();
        </script>
    }