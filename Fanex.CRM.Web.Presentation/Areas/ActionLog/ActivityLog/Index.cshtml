@using Fanex.CRM.ActionLog.Resources;
@using Newtonsoft.Json;
@using Fanex.CRM.Infrastructure.Extension;

@model int
@{
    var customerId = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="activitylog-application">
<head>
    <title>@Labels.ActivityLog </title>
    @Styles.Render("~/site/common")
    @Styles.Render("~/Areas/ActionLog/ActivityLogStyles")
</head>
<body>
<div class="container main" data-ng-controller="activityLogController">
    <div class="row filter-frm one-row redemption-filter">
        <div class="item">
            <label for="username">@Labels.CSDUsername</label>
            <input type="text" class="textbox" id="username" data-ng-model="searchCriteria.Username" />
        </div>
        <div class="item">
            <label for="fromDate">@Labels.FromDate</label>
            <div class="display-inline-block"
                date-picker-from-date-container="fromDate"
                data-dateFormat="M dd, yy"
                data-initValue="@DateTime.Today.FirstDayOfMonth().ToShortFormatedDate()"
                data-maxDate="@DateTime.Today.ToShortFormatedDate()"
                data-ng-model="searchCriteria.MaxFromDate">
                <input id="fromDate" type="text" class="textbox txtcalendar" />
            </div>
        </div>
        <div class="item">
            <label for="toDate">@Labels.ToDate</label>
            <div class="display-inline-block" data-ng-model="searchCriteria.MinToDate" date-picker-to-date-container>
                <input id="toDate" type="text" class="textbox txtcalendar" />
            </div>
        </div>
        <div class="item afterButton">
            <label for="action">@Labels.Action</label>
            <select id="action" class="sel-action" data-ng-model="searchCriteria.Action" ng-options="a.Name for a in actions">
            </select>
        </div>
        <div class="item">
            <button class="btn" data-ng-click="searchActivityLogs()"><span class="hotkey">S</span>ubmit</button>
        </div>
    </div>
    <div class="row">
        <div data-ng-model="activityLogs" table-activity-logs-container>
            <div id="table-activity-logs" class="freegrid display-none">
            </div>
        </div>
    </div>
</div>
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    @Scripts.Render("~/Areas/ActionLog/ActivityLogScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var customerId = @customerId; 
        var currentDate = '@DateTime.Today.ToShortFormatedDate()';
        var initFromDate = '@DateTime.Today.FirstDayOfMonth().ToShortFormatedDate()';
        var activityLogResources = {
            All: '@Labels.All',
            LogDate: '@Labels.LogDate',
            CSDUsername: '@Labels.CSDUsername',
            Action: '@Labels.Action',
            FieldName: '@Labels.FieldName',
            OldValue: '@Labels.OldValue',
            NewValue: '@Labels.NewValue',
            Customer_Activity_Logs: '@Labels.Customer_Activity_Logs'
        }; 
    </script>
</body>
</html>