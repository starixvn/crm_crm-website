@using Fanex.CRM.Feedback.Models;
@using Fanex.CRM.Feedback.Resources;
@using Resources;
@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
@model CustomerInfo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Resources.Language.Title_AddFeedback;
    var isCn88 = (ViewBag.UserRole == Fanex.CRM.Common.Enumerations.UserRole.CN88Staff);
    var hideLicenseeTypeClass = isCn88 ? "hide-item" : "";
    var customerId = Model.Id;
    var customerName = Model.Name;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/Tipsy-Tooltip/tipsy.css")
    @RazorHelper.RenderStyles("~/Scripts/Directives/multileveldropdown/multileveldropdown.css")
    @RazorHelper.RenderStyles("~/Areas/Feedbacks/AddCustomerFeedback/AddCustomerFeedbackStyles")
}
<div data-ng-app="feedbacks-addcustomerfeedback-application">
    <div data-ng-controller="addCustomerFeedbackController">
        <div class="container main">
            <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                        class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                        <div data-ng-bind="messageResultOptions.Message">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group" data-ng-class="{{isShowCustomerDetailBox ? '': 'consecutive-container-before'}}">
                <div class="row title hand" data-ng-click="showHideCustomerDetailBox();">
                    <b><span id="label-customername" data-ng-bind="customerInfo.Name"></span></b>
                </div>
                <div class="cust-info row content" data-ng-show="isShowCustomerDetailBox">
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddltitle">@Language.Title</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 title-picker-container" data-ng-model="titleOptions.DataList">
                                <select id="title" tabindex="2">
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="birthdayInfo">@Language.Birthday</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 date-picker-container" data-ng-model="birthdayOptions.IsRerenderPicker">
                                <input type="text" class="textbox timepicker txtcalendar" id="birthdayInfo" tabindex="5" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="refCodes2Info">@Language.RefCodes2</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="refCodes2Info" tabindex="8" data-ng-model="customerInfo.BettingCode[1]" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="isVIP" class="labelforcheckbox checkbox">
                                    <input id="isVIP" type="checkbox" tabindex="11" data-ng-model="customerInfo.IsVIP" />@Language.VIP</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <label for="chkIsOverrideCrmInfo" class="labelforcheckbox checkbox">
                                    <input type="checkbox" id="chkIsOverrideCrmInfo" tabindex="12" data-ng-model="addCustomerFeedbackParams.OverrideCRMInfo" />
                                    @Language.OverwriteCRMInfo</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="firstNameInfo">@Language.FirstName</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="firstNameInfo" tabindex="3" data-ng-model="customerInfo.FirstName" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="passportInfo">@Language.PassportNumber</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="passportInfo" tabindex="6" data-ng-model="customerInfo.Passport.Name" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="bettingCodeInfo">@Language.BettingCode</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="bettingCodeInfo" data-ng-model="customerInfo.BettingCode[0]"
                                    tabindex="9" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="lastNameInfo">@Language.LastName</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="lastNameInfo" tabindex="4" data-ng-model="customerInfo.LastName" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlsite">@Language.Site</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <select id="site" class="dropdown-siteinfo" tabindex="7" data-ng-model="customerInfo.SiteSetting"
                                        data-ng-options="s.Name group by s.AliasName for s in allSettings.SiteList track by s.Id"
                                        ng-change="updateSelectedSite();">
                                    @if (!isCn88)
                                    {
                                        <option value="">-- @Labels.Select --</option>
                                    }                                    
                                </select>
                            </div>
                        </div>
                        <div class="row item @hideLicenseeTypeClass">
                            <div class="col-xs-4 col-sm-4 col-md-4 ">
                                <label for="licensee-type">
                                    @Labels.Licensee_Type</label></div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <select id="licensee-type" tabindex="10" data-ng-model="customerInfo.LicenseeType"
                                    data-ng-options="s.Name for s in licenseeTypes track by s.Id">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="separate row" data-ng-show="isShowCustomerDetailBox">
                    <hr style="" />
                </div>
                <div class="communication row content" data-ng-show="isShowCustomerDetailBox">
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="contact1Info">@Language.ContactNumber1</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" id="contact1InfoCountry" tabindex="12"
                                    data-ng-model="customerInfo.PhoneInfo[0].CountryCode" />
                                <input type="text" class="textbox code-area" id="contact1InfoArea" tabindex="13"
                                    data-ng-model="customerInfo.PhoneInfo[0].AreaCode" />
                                <input type="text" class="textbox phone" id="contact1InfoPhone" tabindex="14" data-ng-model="customerInfo.PhoneInfo[0].PhoneNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="faxInfo">@Language.Fax</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" id="faxInfoCountry" tabindex="21"
                                    data-ng-model="customerInfo.FaxInfo.CountryCode" />
                                <input type="text" class="textbox code-area" id="faxInfoArea" tabindex="22" data-ng-model="customerInfo.FaxInfo.AreaCode" />
                                <input type="text" class="textbox phone" id="faxInfoFax" tabindex="23" data-ng-model="customerInfo.FaxInfo.FaxNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="pic2NameInfo">
                                    @Labels.PIC_2</label></div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox pic-name" id="pic2NameInfo" tabindex="29" data-ng-model="customerInfo.PersonalInfoContacts[1].Name" />
                                <input type="text" class="textbox phone" data-ng-model="customerInfo.PersonalInfoContacts[1].Phone"
                                    tabindex="30" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="skypeInfo">@Language.Skype</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="skypeInfo" tabindex="35" data-ng-model="customerInfo.Skype" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="weChatInfo">@Labels.WeChat</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="weChatInfo" tabindex="38" data-ng-model="customerInfo.WeChat" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="yahoo">@Labels.Yahoo</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="yahoo" tabindex="41" data-ng-model="customerInfo.Yahoo" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="contact2Info">@Language.ContactNumber2</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" id="contact2InfoCountry" tabindex="15"
                                    data-ng-model="customerInfo.PhoneInfo[1].CountryCode" />
                                <input type="text" class="textbox code-area" id="contact2InfoArea" tabindex="16"
                                    data-ng-model="customerInfo.PhoneInfo[1].AreaCode" />
                                <input type="text" class="textbox phone" id="contact2InfoPhone" tabindex="17" data-ng-model="customerInfo.PhoneInfo[1].PhoneNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="mobileInfo">@Language.Mobile</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" id="mobileInfoCountry" tabindex="24"
                                    data-ng-model="customerInfo.MobilePhone.CountryCode" />
                                <input type="text" class="textbox code-area" id="mobileInfoArea" tabindex="25" data-ng-model="customerInfo.MobilePhone.AreaCode" />
                                <input type="text" class="textbox phone" id="mobileInfoPhone" tabindex="26" data-ng-model="customerInfo.MobilePhone.PhoneNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="pic3NameInfo">
                                    @Labels.PIC_3</label></div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox pic-name" id="pic3NameInfo" tabindex="31" data-ng-model="customerInfo.PersonalInfoContacts[2].Name" />
                                <input type="text" class="textbox phone" data-ng-model="customerInfo.PersonalInfoContacts[2].Phone"
                                    tabindex="32" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="emailInfo">@Language.Email</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="emailInfo" tabindex="36" data-ng-model="customerInfo.Email" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="whatsAppInfo">@Labels.WhatsApp</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="whatsAppInfo" tabindex="39" data-ng-model="customerInfo.WhatsApp" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="qq">@Labels.QQ</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="qq" tabindex="42" data-ng-model="customerInfo.QQ" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="contact3Info">@Language.ContactNumber3</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" id="contact3InfoCountry" tabindex="18"
                                    data-ng-model="customerInfo.PhoneInfo[2].CountryCode" />
                                <input type="text" class="textbox code-area" id="contact3InfoArea" tabindex="19"
                                    data-ng-model="customerInfo.PhoneInfo[2].AreaCode" />
                                <input type="text" class="textbox phone" id="contact3InfoPhone" tabindex="20" data-ng-model="customerInfo.PhoneInfo[2].PhoneNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="pic1NameInfo">
                                    @Labels.PIC_1</label></div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox pic-name" id="pic1NameInfo" tabindex="27" data-ng-model="customerInfo.PersonalInfoContacts[0].Name" />
                                <input type="text" class="textbox phone" data-ng-model="customerInfo.PersonalInfoContacts[0].Phone"
                                    tabindex="28" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="pic4NameInfo">
                                    @Labels.PIC_4</label></div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox pic-name" id="pic4NameInfo" tabindex="33" data-ng-model="customerInfo.PersonalInfoContacts[3].Name" />
                                <input type="text" class="textbox phone" data-ng-model="customerInfo.PersonalInfoContacts[3].Phone"
                                    tabindex="34" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="msnInfo">@Language.MSN</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="msnInfo" tabindex="37" data-ng-model="customerInfo.MSN" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="lineInfo">@Labels.Line</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="lineInfo" tabindex="40" data-ng-model="customerInfo.Line" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="bbm">@Labels.BBM</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="bbm" tabindex="43" data-ng-model="customerInfo.BBM" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group" data-ng-class="isShowFeedbackDetailBox ? '': 'consecutive-container-before'">
                <div class="row title hand" data-ng-click="showHideFeedbackDetailBox();">
                    @Labels.Details
                </div>
                <div class="FeedbackDetail row content" data-ng-show="isShowFeedbackDetailBox">
                    <div class="row ">
                        <div class="col-md-4">
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="startTime">@Language.FeedbackDate</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <input type="text" id="startTime" class="txtcalendar textbox timepicker" tabindex="60"
                                        readonly onselect="onStartTimeChanged();" data-ng-model="addCustomerFeedbackParams.StartTime"
                                        datetimepicker />
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcommunication">@Language.Communication</label>
                                    @Html.Raw(Language.RequiredFieldTemplate)
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedCommunications"
                                                            data-settings="communicationDropdownSettings"
                                                            ng-change="communicationChangeHandler()"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="product">@Language.Product</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedProducts"
                                                            data-ng-change="productChangedHandler()"
                                                            data-settings="productDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>

                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcountry">@Language.country</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8 country-picker-container" data-ng-model="countryOptions.DataList">
                                    <select id="country" tabindex="68"></select>
                                </div>
                            </div>

                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlrole">@Language.Role</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8  role-picker-container" data-ng-model="roleOptions.DataList">
                                    <select id="role" name="D3" tabindex="71"></select>
                                </div>
                            </div>

                        </div>
                        <div class="col-md-4">
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="endTime">@Language.ResolutionTime</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <input type="text" id="endTime" class="txtcalendar textbox timepicker" tabindex="61"
                                        readonly data-ng-model="addCustomerFeedbackParams.EndTime" datetimepicker />
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcategory">@Language.Category</label>
                                    @Html.Raw(Language.RequiredFieldTemplate)
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-change="categoryChangedHandler()"
                                                            data-ng-model="selectedCategories"
                                                            data-settings="categoryDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlproduct">@Language.SubProduct</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedSubProducts"
                                                            data-ng-change="subProductChangedHandler()"
                                                            data-settings="subProductDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>

                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddllanguage">@Language._Language</label>
                                    @Html.Raw(Language.RequiredFieldTemplate)
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8 language-picker-container" data-ng-model="languageOptions.DataList">
                                    <select id="language" tabindex="69"></select>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlstatus">@Language.Status</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8 status-picker-container" data-ng-model="statusOptions.DataList">
                                    <select id="status" tabindex="70"></select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcsextension">@Language.CSExtension</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedExtensions"
                                                            data-settings="extensionDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcategory">@Language.SubCategory</label>
                                    @Html.Raw(Language.RequiredFieldTemplate)
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-change="subCategoryChangedHandler()"
                                                            data-ng-model="selectedSubCategories"
                                                            data-settings="subCategoryDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>                           
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="bettype">@Language.BetType</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8  ">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedBettypes"
                                                            data-settings="bettypeDropdownSettings"
                                                            data-ng-change="bettypeChangeHandler()"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlresponse">@Language.Response</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8 response-picker-container" data-ng-model="responseOptions.DataList">
                                    <select id="response" tabindex="72"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="row item">
                            <div class="col-xs-3 col-sm-2 col-md-2">
                                <label class="labelforcheckbox checkbox">
                                    <input type="checkbox" id="chkisrelated" data-ng-change="IsRelatedCustomerCheckboxChanged()" data-ng-model="addCustomerFeedbackParams.HasRelated"
                                        tabindex="78" />
                                    @Language.IsRelatedCustomer
                                </label>
                            </div>
                            <div class="col-xs-9 col-sm-10 col-md-10">
                                <div class="row">
                                    <div class="col-xs-11 col-sm-11 col-md-11 related-customer-directive-container">
                                        <input type="button" id="btnRelatedHelp"
                                        class="btnHelp pull-left tipsy-directive"
                                        title="@Labels.Related_Help"
                                        data-ng-model="tipsyOptions.IsUpdateTip" />
                                        <input id="txtrelatedcustomer" name="txtrelatedcustomer" class="related-customer"
                                               data-ng-model="customersInput"
                                               data-ng-disabled="!addCustomerFeedbackParams.HasRelated" />
                                    </div>
                                    <div class="col-xs-1 col-sm-1 col-md-1">
                                        <button id="btnverify" class="btn pull-right" data-ng-click="verifyRelatedCustomer()" 
                                            data-ng-disabled ="customersInput === ''"
                                            tabindex="79">
                                            V<span class="hotkey">e</span>rify</button>
                                    </div>
                                </div>
                                <div id="ColorGuide" class="row colorGuide" data-ng-show="addCustomerFeedbackParams.HasRelated && relatedCustomerResultDirective.relatedCustomers.length > 0">
                                    <div class="col-sm-2 col-md-2 relate-customer">
                                        @Language.Customer</div>
                                    <div class="col-sm-2 col-md-2 relate-guest">
                                        @Language.Guest</div>
                                    <div class="col-sm-2 col-md-2 relate-invalid">
                                        @Language.Invalid</div>
                                </div>
                                <div id="trRelatedInfo" class="row relatedFeedback" data-ng-show="addCustomerFeedbackParams.HasRelated && relatedCustomerResultDirective.relatedCustomers.length > 0">
                                    <table id="related" data-ng-model="relatedCustomerResultDirective.relatedCustomers" relatedcustomerresult></table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="row item">
                            <div class="col-xs-3 col-sm-2 col-md-2 lblSubject">
                                <label for="txtsubject">
                                    @Language.Subject
                                </label>
                                @Html.Raw(Language.RequiredFieldTemplate)
                            </div>
                            <div class="col-xs-9 col-sm-10 col-md-10 subject-auto-complete-container" data-ng-model="subjectOptions.IsUpdate">
                                <input type="text" id="subject" class="textbox subject-auto-complete txtSubject"
                                    autocomplete="off" tabindex="80" data-ng-model="subjectOptions.Subject" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group" data-ng-class="isShowDescriptionPreview ? 'hidden' : '' ">
                <div class="row title">
                    <div class="pull-left hand">
                        Auto-generated
                    </div>
                </div>
                <div class="FeedbackDescription row content">
                    <div class="" id="">
                        <textarea rows="3" class="auto-generated-text" data-ng-model="autoGeneratedText"></textarea>
                    </div>
                </div>
            </div>
            <div class="row panel-group" data-ng-class="isShowDescriptionBox ? '' : 'consecutive-container-before'">
                <div class="row title">
                    <div class="pull-left hand" data-ng-click="isShowDescriptionBox = !isShowDescriptionBox;">
                        @Labels.Description @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </div>
                    <div class="pull-right">
                        <input type="button" class="btnreview " value="@Language.Preview" id="btndesreview" data-ng-click="showDescriptionPreview();"
                        data-ng-class="isShowDescriptionPreview ? 'hidden' : '' " />
                        <input type="button" class="btnedit hidden" value="@Language.Edit" id="btndesedit" data-ng-click="showDescriptionEditor();"
                        data-ng-class="isShowDescriptionPreview ? '' : 'hidden' " />
                    </div>
                </div>
                <div class="FeedbackDescription row content" data-ng-class="isShowDescriptionBox ? '' : 'hide'">
                    <div class="editerwrapper" id="descriptionwrapper">
                        <div data-ng-class="isShowDescriptionPreview ? 'lastRemarkPrefixPreview' : 'hidden' " ng-bind-html="autoGeneratedTextPreview">
                        </div>
                        <div id="previewboxdes" class="preview raw-html-directive" data-ng-class="isShowDescriptionPreview ? '' : 'hidden' "
                            data-ng-model="descriptionOptions.SelectedText">
                        </div>
                        <div id="descriptioneditorboxcontainer" class="description-editor-container" data-ng-model="descriptionOptions.SelectedText"
                            data-ng-class="isShowDescriptionPreview ? 'hidden' : '' ">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group last" data-ng-class="isShowSolutionBox ? '' : 'consecutive-container-before'">
                <div class="row title">
                    <div class="pull-left hand" data-ng-click="isShowSolutionBox = !isShowSolutionBox;">
                        @Labels.Solution @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    </div>
                    <div class="pull-right">
                        <input type="button" class="btnreview " value="@Language.Preview" id="btnsolreview" data-ng-click="showSolutionPreview();"
                        data-ng-class="isShowSolutionPreview ? 'hidden' : '' " />
                        <input type="button" class="btnedit" value="@Language.Edit"
                        id="btnsoledit" data-ng-click="showSolutionEditor();"
                        data-ng-class="isShowSolutionPreview ? '' : 'hidden' " />
                    </div>
                </div>
                <div class="FeedbackSolution row content" data-ng-class="isShowSolutionBox ? '' : 'hide'">
                    <div class="editerwrapper" id="solutionwrapper">
                        <div id="previewboxsol" class="preview raw-html-directive" data-ng-class="isShowSolutionPreview ? '' : 'hidden' "
                            data-ng-model="solutionOptions.SelectedText">
                        </div>
                        <div id="solutioneditorboxcontainer" class="solution-editor-container" data-ng-model="solutionOptions.SelectedText"
                            data-ng-class="isShowSolutionPreview ? 'hidden' : '' ">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row btn-group">
                <button class="btn" data-ng-click="addFeedback();">
                    <span class="hotkey">S</span>ave</button>
            </div>
            <input type="text" class="textbox default-focus-element default-focus" data-ng-model="isSetFocus" />
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.highlight-3.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.autocomplete.client.js")
    @RazorHelper.RenderScripts("~/Scripts/Tipsy-Tooltip/jquery.tipsy.js")
    @RazorHelper.RenderScripts("~/Scripts/common.js")
    @RazorHelper.RenderScripts("~/Scripts/TimePicker",
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/Areas/Feedbacks/AddCustomerFeedback/AddCustomerFeedbackScripts")
    <script type="text/javascript">
        parent.document.title = '@Resources.Language.Title_AddFeedback';
        window.rootUrl = '@Url.Content("~")';
        var customerId = @customerId;
        var customerName = '@HttpUtility.JavaScriptStringEncode(@customerName)';
        var currentDate = '@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()';
        var currentTime = '@DateTimeUtilize.CurrentClientTime()';
        var currentUsername = "@AppSession.CurrentUser.Username";
        var viewResources = {
            All: '@Labels.All',
            Select: '@Labels.Select',
            Insert_Edit_Block: '@Labels.Insert_Edit_Block',
            Helper_RelatedInputMessage: '@Labels.Helper_RelatedInputMessage',
            Confirm_Ignore_Feedback_AddCustomerFeedback: '@Html.Raw(Resources.Language.Confirm_Ignore_Feedback_AddCustomerFeedback)',

            ErrorFeedbackResolutionTime: '@Labels.Error_FeedbackResolutionTime',
            NoSubcategoryError: '@Labels.NoSubcategoryError',
            Error_NACommmunicationTool: '@Labels.Error_NACommmunicationTool',
            Error_NAMainCategory: '@Labels.Error_NAMainCategory',
            Error_NASubCategory: '@Labels.Error_NASubCategory',
            Error_NA_MainSubCategory: '@Labels.Error_NA_MainSubCategory',
            Error_NALanguage: '@Labels.Error_NALanguage',
            Error_EmptySubject: '@Labels.Error_EmptySubject',
            Error_EmptyRemark: '@Labels.Error_EmptyRemark',
            Error_EmptySolution: '@Labels.Error_EmptySolution',
            Error_VerifyRelatedCustomer: '@Labels.Error_VerifyRelatedCustomer',
            CustomerNameLengthErrorMessage: '@Labels.RelatedCustomerNameLengthErrorMessage',
            InvalidCategoryError: '@Labels.InvalidCategoryError',
            DescriptionMaxLengthError: '@Labels.DescriptionMaxLengthError',
            SolutionMaxLengthError: '@Labels.SolutionMaxLengthError',
            FeedbackDuplicationError: '@Labels.FeedbackDuplicationError'
     };
    </script>
}