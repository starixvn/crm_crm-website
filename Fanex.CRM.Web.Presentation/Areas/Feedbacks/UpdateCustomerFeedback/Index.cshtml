@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Feedback.Resources;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
@using CommonLabels = Fanex.CRM.Common.Resources.Labels;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.UpdateFeedbackTitle;

    var hasReviewFeedbackPermission = (bool)ViewBag.HasReviewFeedbackPermission;
    var hasUpdateFeedbackPermission = (bool)ViewBag.HasUpdateFeedbackPermission;
    var isDeletedFeedbackView = ViewBag.IsDeletedFeedbackView as string;
    var isShowDeletedStatus = ViewBag.IsShowDeletedStatus as string;
    var isCn88 = (ViewBag.UserRole == Fanex.CRM.Common.Enumerations.UserRole.CN88Staff);
    var hideLicenseeTypeClass = isCn88 ? "hide-item" : "";
    var hideProvinceClass = isCn88 ? "" : "hide-item";
    var letsTalkLabel = isCn88 ? Labels.LetsTalk : Labels.BBM;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/Directives/multileveldropdown/multileveldropdown.css")
    @RazorHelper.RenderStyles("~/Areas/Feedbacks/UpdateCustomerFeedback/UpdateCustomerFeedbackStyles")
}
<div ng-app="feedbacks-updatecustomerfeedback-application">
    <div ng-controller="UpdateCustomerFeedbackController">
        <div class="main container popup update-customer-feedback">
            <div alert-box-container></div>
            <div class="row panel-group" data-ng-class="panelManager.customer ? '' : 'consecutive-container-before'">
                <div class="row title hand" data-ng-click="panelManager.customer = !panelManager.customer">
                    <b>
                        <span id="label-customername" data-ng-bind="feedback.CustomerInfo.Name"></span>
                    </b>
                </div>
                <div class="cust-info row content" ng-show="panelManager.customer">
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddltitle">@Labels.Title</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <select id="ddltitle" tabindex="2" data-ng-model="feedback.CustomerInfo.Title" data-ng-options="s.Value for s in settings.Titles track by s.Id"></select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="birthday">@Labels.Birthday</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input id="birthday" type="text" class="textbox timepicker txtcalendar" tabindex="5"
                                       data-ng-model="feedback.CustomerInfo.BirthDayString" datepicker />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="refCodes">@Labels.RefCodes</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="refCodes" tabindex="8" data-ng-model="feedback.CustomerInfo.BettingCode[1]" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <label for="chkIsOverrideCrmInfo" class="labelforcheckbox checkbox">
                                    <input type="checkbox" id="chkIsOverrideCrmInfo" tabindex="12" data-ng-model="feedback.OverrideCRMInfo" />@Labels.OverwriteCRMInfo
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="firstname">@Labels.FirstName</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="firstname" tabindex="3" data-ng-model="feedback.CustomerInfo.FirstName" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="passport">@Labels.PassportNumber</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="passport" tabindex="6" data-ng-model="feedback.CustomerInfo.Passport.Name" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="secretCode">@Labels.SecretCode</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="secretCode" data-ng-model="feedback.CustomerInfo.BettingCode[0]"
                                       tabindex="9" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="lastname">@Labels.LastName</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="lastname" tabindex="4" data-ng-model="feedback.CustomerInfo.LastName" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlsite">@Labels.Site</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <select id="ddlsite" class="dropdown-siteinfo" tabindex="7" data-ng-model="feedback.CustomerInfo.SiteSetting"
                                        data-ng-options="s.Name group by s.AliasName for s in settings.Sites track by s.Id"
                                        ng-change="updateSelectedSite();">
                                    @if (!isCn88)
                                    {
                                        <option value="">-- @Labels.Select --</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row item @hideLicenseeTypeClass">
                            <div class="col-xs-4 col-sm-4 col-md-4 ">
                                <label for="licensee-type">
                                    @Labels.Licensee_Type
                                </label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <select id="licensee-type" tabindex="10" data-ng-model="feedback.CustomerInfo.LicenseeType"
                                        data-ng-options="s.Name for s in settings.LicenseeTypes track by s.Id"></select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="separate row" data-ng-show="panelManager.customer">
                    <hr style="" />
                </div>
                <div class="communication row content" data-ng-show="panelManager.customer">
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label>@Labels.Phone1</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" tabindex="12" data-ng-model="feedback.CustomerInfo.PhoneInfo[0].CountryCode" />
                                <input type="text" class="textbox code-area" tabindex="13" data-ng-model="feedback.CustomerInfo.PhoneInfo[0].AreaCode" />
                                <input type="text" class="textbox phone" tabindex="14" data-ng-model="feedback.CustomerInfo.PhoneInfo[0].PhoneNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label>@Labels.Fax</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" tabindex="21" data-ng-model="feedback.CustomerInfo.FaxInfo.CountryCode" />
                                <input type="text" class="textbox code-area" tabindex="22" data-ng-model="feedback.CustomerInfo.FaxInfo.AreaCode" />
                                <input type="text" class="textbox phone" tabindex="23" data-ng-model="feedback.CustomerInfo.FaxInfo.FaxNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="pic2NameInfo">
                                    @Labels.PIC_2
                                </label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox pic-name" id="pic2NameInfo" tabindex="29" data-ng-model="feedback.CustomerInfo.PersonalInfoContacts[1].Name" />
                                <input type="text" class="textbox phone" id="pic2Info" data-ng-model="feedback.CustomerInfo.PersonalInfoContacts[1].Phone"
                                       tabindex="30" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="skype">@Labels.Skype</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="skype" tabindex="35" data-ng-model="feedback.CustomerInfo.Skype" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="wechat">@Labels.WeChat</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="wechat" tabindex="38" data-ng-model="feedback.CustomerInfo.WeChat" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="yahoo">@Labels.Yahoo</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="yahoo" tabindex="41" data-ng-model="feedback.CustomerInfo.Yahoo" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label>@Labels.Phone2</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" tabindex="15" data-ng-model="feedback.CustomerInfo.PhoneInfo[1].CountryCode" />
                                <input type="text" class="textbox code-area" tabindex="16" data-ng-model="feedback.CustomerInfo.PhoneInfo[1].AreaCode" />
                                <input type="text" class="textbox phone" tabindex="17" data-ng-model="feedback.CustomerInfo.PhoneInfo[1].PhoneNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label>@Labels.Mobile</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" tabindex="24" data-ng-model="feedback.CustomerInfo.MobilePhone.CountryCode" />
                                <input type="text" class="textbox code-area" tabindex="25" data-ng-model="feedback.CustomerInfo.MobilePhone.AreaCode" />
                                <input type="text" class="textbox phone" tabindex="26" data-ng-model="feedback.CustomerInfo.MobilePhone.PhoneNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="pic3NameInfo">
                                    @Labels.PIC_3
                                </label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox pic-name" id="pic3NameInfo" tabindex="31" data-ng-model="feedback.CustomerInfo.PersonalInfoContacts[2].Name" />
                                <input type="text" class="textbox phone" id="pic3Info" data-ng-model="feedback.CustomerInfo.PersonalInfoContacts[2].Phone"
                                       tabindex="32" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="email">@Labels.Email</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="email" tabindex="36" data-ng-model="feedback.CustomerInfo.Email" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="whatsapp">@Labels.WhatsApp</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="whatsapp" tabindex="39" data-ng-model="feedback.CustomerInfo.WhatsApp" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="qq">@Labels.QQ</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="qq" tabindex="42" data-ng-model="feedback.CustomerInfo.QQ" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label>@Labels.Phone3</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox code-country" tabindex="18" data-ng-model="feedback.CustomerInfo.PhoneInfo[2].CountryCode" />
                                <input type="text" class="textbox code-area" tabindex="19" data-ng-model="feedback.CustomerInfo.PhoneInfo[2].AreaCode" />
                                <input type="text" class="textbox phone" tabindex="20" data-ng-model="feedback.CustomerInfo.PhoneInfo[2].PhoneNumber" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="pic1NameInfo">
                                    @Labels.PIC_1
                                </label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox pic-name" id="pic1NameInfo" tabindex="27" data-ng-model="feedback.CustomerInfo.PersonalInfoContacts[0].Name" />
                                <input type="text" class="textbox phone" id="pic1Info" data-ng-model="feedback.CustomerInfo.PersonalInfoContacts[0].Phone"
                                       tabindex="28" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="pic4NameInfo">
                                    @Labels.PIC_4
                                </label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox pic-name" id="pic4NameInfo" tabindex="33" data-ng-model="feedback.CustomerInfo.PersonalInfoContacts[3].Name" />
                                <input type="text" class="textbox phone" id="pic4Info" tabindex="34" data-ng-model="feedback.CustomerInfo.PersonalInfoContacts[3].Phone" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="msn">@Labels.MSN</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="msn" tabindex="37" data-ng-model="feedback.CustomerInfo.MSN" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="line">@Labels.Line</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="line" tabindex="40" data-ng-model="feedback.CustomerInfo.Line" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="bbm">@letsTalkLabel</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input type="text" class="textbox" id="bbm" tabindex="43" data-ng-model="feedback.CustomerInfo.BBM" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group" data-ng-class="panelManager.detail ? '' : 'consecutive-container-before'">
                <div class="row title hand" data-ng-click="panelManager.detail = !panelManager.detail">
                    @Labels.Details
                </div>
                <div class="FeedbackDetail row content" data-ng-show="panelManager.detail">
                    <div class="row">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="startTime">@Labels.FeedbackDate</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <input type="text" id="startTime" class="txtcalendar textbox timepicker" tabindex="60"
                                           readonly data-ng-model="feedback.FeedbackTimeString" datetimepicker />
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcommunication">@Labels.Communication</label>
                                    @Html.Raw(Labels.RequiredFieldTemplate)
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedCommunications"
                                                            data-settings="communicationDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlProduct">@Labels.Product</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedProducts"
                                                            data-ng-change="productChangedHandler()"
                                                            data-settings="productDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlresponse">@Labels.Response</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <select id="ddlresponse" tabindex="72" data-ng-model="feedback.Response" data-ng-options="s.Value for s in settings.Responses track by s.Id"></select>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlrole">@Labels.Role</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <select id="ddlrole" tabindex="71" data-ng-model="feedback.Role" data-ng-options="s.Value for s in settings.Roles track by s.Id"></select>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="endTime">@Labels.ResolutionTime</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <input type="text" id="endTime" class="txtcalendar textbox timepicker" tabindex="61"
                                           readonly data-ng-model="feedback.ResolutionTimeString" datetimepicker />
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcategory">@Labels.Category</label>
                                    @Html.Raw(Labels.RequiredFieldTemplate)
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedCategories"
                                                            data-ng-change="categoryChangedHandler()"
                                                            data-settings="categoryDropdownSettings"
                                                            user-do-check="categoriesChangedByUser"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlSubProduct">@Labels.SubProduct</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedSubProducts"
                                                            data-ng-change="subProductChangedHandler()"
                                                            data-settings="subProductDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddllanguage">@Labels.Language</label>
                                    @Html.Raw(Labels.RequiredFieldTemplate)
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <select id="ddllanguage" tabindex="69" data-ng-model="feedback.Language" data-ng-options="s.Name for s in settings.Languages track by s.Id"></select>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcountry">@Labels.Country</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <select id="ddlcountry" tabindex="68" data-ng-model="feedback.Country" data-ng-options="s.Name for s in settings.Countries track by s.Id"></select>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlcsextension">@Labels.CSExtension</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedExtensions"
                                                            data-settings="extensionDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlsubcategory">@Labels.SubCategory</label>
                                    @Html.Raw(Labels.RequiredFieldTemplate)
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-change="subCategoryChangedHandler()"
                                                            data-ng-model="selectedSubCategories"
                                                            data-settings="subCategoryDropdownSettings"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlbettype">@Labels.BetType</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <multileveldropdowntree text-settings="TextSettings"
                                                            data-ng-model="selectedBettypes"
                                                            data-settings="bettypeDropdownSettings"
                                                            data-ng-change="bettypeChangeHandler()"></multileveldropdowntree>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlstatus">@Labels.Status</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <select id="ddlstatus" tabindex="70" data-ng-model="feedback.Status" data-ng-options="s.Name for s in settings.StatusList track by s.Id"></select>
                                </div>
                            </div>
                            <div class="row item">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlinquiries">@Labels.NoOfInquiries</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <input class="textbox" type="number" name="input" ng-keydown="validateInquiriesInput($event);" oninput="validity.valid||value < 1 && (value=1)||value > 32000 && (value=32000);" min="1" max="32000" data-ng-model="feedback.NoInquiries" />
                                </div>
                            </div>
                            <div class="row item @hideProvinceClass">
                                <div class="col-xs-4 col-sm-4 col-md-4">
                                    <label for="ddlprovince">@Labels.Province</label>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <select id="ddlprovince" tabindex="68" data-ng-model="feedback.Province" data-ng-options="s.Name for s in settings.Provinces track by s.Id"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="row item">
                            <div class="col-xs-3 col-sm-2 col-md-2">
                                <label class="labelforcheckbox checkbox">
                                    <input type="checkbox" id="chkisrelated" data-ng-change="IsRelatedCustomerCheckboxChanged()" data-ng-model="feedback.HasRelated"
                                           tabindex="78" />
                                    @Labels.IsRelatedCustomer
                                </label>
                            </div>
                            <div class="col-xs-9 col-sm-10 col-md-10">
                                <div class="row">
                                    <div class="col-xs-11 col-sm-11 col-md-11">
                                        <span type="button" id="btnRelatedHelp" class="btnHelp pull-left"
                                              tooltip-class="helper-tooltip"
                                              tooltip-placement="bottom-left"
                                              uib-tooltip="@Labels.Helper_RelatedInputMessage"></span>
                                        <input id="txtrelatedcustomer" name="txtrelatedcustomer" class="related-customer" autocomplete="off"
                                               ng-disabled="!feedback.HasRelated" ng-model="customersInput"
                                               ng-paste="pasteRelatedCustomerHandler($event)" />
                                    </div>
                                    <div class="col-xs-1 col-sm-1 col-md-1">
                                        <button id="btnverify" class="btn pull-right" data-ng-click="verifyRelatedCustomer()"
                                                data-ng-disabled="customersInput === ''" tabindex="79">
                                            @Html.Raw(@CommonLabels.Btn_HotKey_Verify)
                                        </button>
                                    </div>
                                </div>
                                <div id="ColorGuide" class="row colorGuide" data-ng-show="feedback.HasRelated && relatedCustomerResultDirective.relatedCustomers.length > 0">
                                    <div class="col-sm-2 col-md-2 relate-customer">
                                        @Labels.Customer
                                    </div>
                                    <div class="col-sm-2 col-md-2 relate-guest">
                                        @Labels.Guest
                                    </div>
                                    <div class="col-sm-2 col-md-2 relate-invalid">
                                        @Labels.Invalid
                                    </div>
                                </div>
                                <div id="trRelatedInfo" class="row relatedFeedback" data-ng-show="feedback.HasRelated && relatedCustomerResultDirective.relatedCustomers.length > 0">
                                    <table id="related" data-ng-model="relatedCustomerResultDirective.relatedCustomers" relatedcustomerresult></table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="row item">
                            <div class="col-xs-3 col-sm-2 col-md-2 lblSubject">
                                <label for="txtsubject">
                                    @Labels.Subject
                                </label>
                                @Html.Raw(Labels.RequiredFieldTemplate)
                            </div>
                            <div class="col-xs-9 col-sm-10 col-md-10 subject-auto-complete-container" data-ng-model="subjectOptions.IsUpdate">
                                <input type="text" id="subject" class="textbox subject-auto-complete txtSubject"
                                       autocomplete="off" tabindex="80" data-ng-model="feedback.Subject" />
                                <span class="errormsg" data-ng-hide="requiredManager.subject">@Labels.RequiredInformation</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group" data-ng-class="panelManager.showDescriptionPreview ? 'hidden' : '' ">
                <div class="row title">
                    <div class="pull-left hand">
                        @Labels.Auto_Generated
                    </div>
                </div>
                <div class="FeedbackDescription row content">
                    <div class="" id="">
                        <textarea rows="3" class="auto-generated-text" data-ng-model="autoGeneratedText"></textarea>
                    </div>
                </div>
            </div>
            <div class="row panel-group" data-ng-class="panelManager.description ? '' : 'consecutive-container-before'">
                <div class="row title">
                    <div class="pull-left hand" data-ng-click="panelManager.description = !panelManager.description">
                        @Labels.Description @Html.Raw(Labels.RequiredFieldTemplate)
                        <span class="errormsg" data-ng-hide="requiredManager.description">@Labels.RequiredInformation</span>
                    </div>
                    <div class="pull-right">
                        <input type="button" data-ng-show="@hasUpdateFeedbackPermission.ToString().ToLower()"
                               data-ng-value="panelManager.showDescriptionPreview ? '@Labels.Edit' : '@Labels.Preview'"
                               data-ng-class="panelManager.showDescriptionPreview ? 'btnedit' : 'btnreview'"
                               data-ng-click="showHideDescriptionPreview();" />
                    </div>
                </div>
                <div class="row content" ng-show="panelManager.description">
                    <div class="editerwrapper" id="descriptionwrapper">
                        <div data-ng-class="panelManager.showDescriptionPreview ? 'lastRemarkPrefixPreview' : 'hidden' " ng-bind-html="autoGeneratedTextPreview">
                        </div>
                        <div id="previewboxdes" class="preview raw-html-directive" data-ng-show="panelManager.showDescriptionPreview"
                             data-ng-model="feedback.Description">
                        </div>
                        <div id="descriptioneditorboxcontainer" class="description-editor-container" data-ng-show="!panelManager.showDescriptionPreview"
                             data-ng-model="feedback.Description">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group" data-ng-class="panelManager.solution ? '' : 'consecutive-container-before'">
                <div class="row title">
                    <div class="pull-left hand" data-ng-click="panelManager.solution = !panelManager.solution">
                        @Labels.Solution @Html.Raw(Labels.RequiredFieldTemplate)
                        <span class="errormsg" data-ng-hide="requiredManager.solution">@Labels.RequiredInformation</span>
                    </div>
                    <div class="pull-right">
                        <input type="button" data-ng-show="@hasUpdateFeedbackPermission.ToString().ToLower()"
                               data-ng-value="panelManager.showSolutionPreview ? '@Labels.Edit' : '@Labels.Preview'"
                               data-ng-class="panelManager.showSolutionPreview ? 'btnedit' : 'btnreview'"
                               data-ng-click="panelManager.showSolutionPreview = !panelManager.showSolutionPreview" />
                    </div>
                </div>
                <div class="row content" ng-show="panelManager.solution">
                    <div class="editerwrapper" id="solutionwrapper">
                        <div id="previewboxsol" class="preview raw-html-directive" data-ng-show="panelManager.showSolutionPreview"
                             data-ng-model="feedback.Solution">
                        </div>
                        <div id="solutioneditorboxcontainer" class="solution-editor-container" data-ng-show="!panelManager.showSolutionPreview"
                             data-ng-model="feedback.Solution">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group last" data-ng-class="panelManager.review ? '' : 'consecutive-container-before'">
                <div class="row title">
                    <div class="pull-left" style="width: 45px;">
                        <label for="chkisreview" class="hand">@Labels.Review</label>
                        <input type="checkbox" class="review" id="chkisreview" ng-disabled="!hasReviewPermission"
                               ng-model="feedback.IsReviewed" ng-change="panelManager.review = !panelManager.review" />
                    </div>
                    <span class="reviewedby" data-ng-show="feedback.ReviewerId > 0" data-ng-bind="reviewedBy">
                    </span><span class="errormsg" style="margin-left: 25px;" data-ng-hide="requiredManager.review">@Labels.RequiredInformation</span>
                </div>
                <div class="row content" ng-show="panelManager.review">
                    <div class="editerwrapper" id="reviewwrapper">
                        <div id="previewboxrev" class="preview raw-html-directive" data-ng-show="!hasReviewPermission"
                             data-ng-model="feedback.Review">
                        </div>
                        <div id="revieweditorboxcontainer" class="review-editor-container" data-ng-show="hasReviewPermission"
                             data-ng-model="feedback.Review">
                        </div>
                    </div>
                </div>
            </div>
            @if (hasUpdateFeedbackPermission)
            {
                <div class="row btn-group">
                    <button class="btn" data-ng-click="updateFeedback();">
                        @Html.Raw(@CommonLabels.Btn_HotKey_Save)
                    </button>
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.highlight-3.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.autocomplete.client.js")
    @RazorHelper.RenderScripts("~/Scripts/common.js")
    @RazorHelper.RenderScripts("~/Scripts/TimePicker",
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/Areas/Feedbacks/UpdateCustomerFeedback/UpdateCustomerFeedbackScripts")
    @{ var currentTime = DateTimeUtilize.CurrentClientTime(); }
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var feedbackId = @ViewBag.FeedbackId;
        var hasReviewFeedbackPermission = '@hasReviewFeedbackPermission.ToString()';
        var isDeletedFeedbackView = '@isDeletedFeedbackView' === 'true';
        var isShowDeletedStatus = '@isShowDeletedStatus' === 'true';
        var currentTime = '@currentTime';
        var currentDate = '@currentTime.ToShortFormatedDate()';
        var currentUsername = '@AppSession.CurrentUser.Username';
        var updateFeedbackResources = {
            NoBettypeError: '@Labels.NoBettypeError',
            NoSubcategoryError: '@Labels.NoSubcategoryError',
            InsertEditBlock: '@Labels.Insert_Edit_Block',
            ReviewedBy: '@Labels.ReviewedBy',
            ErrorFeedbackResolutionTime: '@Labels.Error_FeedbackResolutionTime',
            NACommmunicationTool: '@Labels.Error_NACommmunicationTool',
            NAMainCategory: '@Labels.Error_NAMainCategory',
            NASubCategory: '@Labels.Error_NASubCategory',
            Error_NA_MainSubCategory: '@Labels.Error_NA_MainSubCategory',
            NALanguage: '@Labels.Error_NALanguage',
            EmptySubject: '@Labels.Error_EmptySubject',
            EmptyRemark: '@Labels.Error_EmptyRemark',
            EmptySolution: '@Labels.Error_EmptySolution',
            EmptyReview: '@Labels.Error_EmptyReview',
            ConfirmOverrideCRMInfo: '@Labels.ConfirmOverrideCRMInfo',
            UpdateFeedbackSuccessfully: '@Labels.UpdateFeedbackSuccessfully',
            CustomerVerification: '@Labels.Error_VerifyRelatedCustomer',
            CustomerNameLengthErrorMessage: '@Labels.RelatedCustomerNameLengthErrorMessage',
            InvalidCategoryError: '@Labels.InvalidCategoryError',
            DescriptionMaxLengthError: '@Labels.DescriptionMaxLengthError',
            SolutionMaxLengthError: '@Labels.SolutionMaxLengthError',
            Confirm_Changes: '@Labels.Confirm_Changes',
            Confirm_Changes_Message: '@Labels.Confirm_Changes_Message'
        };
    </script>
}