@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Feedback.Resources;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.UpdateFeedbackTitle;

    var hasReviewFeedbackPermission = (bool)ViewBag.HasReviewFeedbackPermission;
    var hasUpdateFeedbackPermission = (bool)ViewBag.HasUpdateFeedbackPermission;
    var isDeletedFeedbackView = ViewBag.IsDeletedFeedbackView as string;
    var isShowDeletedStatus = ViewBag.IsShowDeletedStatus as string;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/Tipsy-Tooltip/tipsy.css")
    @RazorHelper.RenderStyles("~/Areas/Feedbacks/UpdateCustomerFeedback/UpdateCustomerFeedbackStyles")
}
<div data-ng-app="feedbacks-updatecustomerfeedback-application">
