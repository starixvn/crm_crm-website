@using Fanex.CRM.Feedback.Models;
@using Fanex.CRM.Feedback.Resources;
@using Resources;
@using Fanex.CRM.Infrastructure.Common;
@using Fanex.CRM.Service.Interface;
@using Fanex.CRM.Service.Impl;
@using Fanex.CRM.Infrastructure.Core;
@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Infrastructure.Extension;
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="feedbacks-addguestfeedback-application">
<head>
    <title>@Resources.Language.Title_AddGuestFeedback </title>
    @Styles.Render("~/site/common")
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/Tipsy-Tooltip/tipsy.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/InputBox/style.css")" />
    @Styles.Render("~/Areas/Feedbacks/AddGuestFeedback/AddGuestFeedbackStyles")
</head>
<body data-ng-controller="addGuestFeedbackController">
    <div class="container main">
        <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                    class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="messageResultOptions.Message">
                    </div>
                </div>
            </div>
        </div>
        <div class="row panel-group" data-ng-class=" isShowCustomerDetailBox ? '': 'consecutive-container-before'">
            <div class="row title hand identify hand">
                <div class="col-xs-4 col-sm-4 col-md-4">
                    <div class="row item">
                        <div class="col-xs-5 col-sm-5 col-md-5" data-ng-click="showHideCustomerDetailBox();">
                            @Language.lblIdentityInformation
                            @Html.Raw(Language.RequiredFieldTemplate)
                        </div>
                        <div class="col-xs-7 col-sm-7 col-md-7">
                            <input id="txtidentity" type="text" class="textbox txtidentity" tabindex="1" data-ng-model="customerInfo.Name" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="CustInfo row content" data-ng-show="isShowCustomerDetailBox">
                <div class="col-xs-4 col-sm-4 col-md-4">
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="ddltitle">@Language.Title</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8 title-picker-container" data-ng-model="titleOptions.DataList">
                            <select id="title" tabindex="2">
                            </select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="contact1Info">@Language.ContactNumber1</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox code-country" id="contact1InfoCountry" tabindex="5"
                                data-ng-model="customerInfo.PhoneInfo[0].CountryCode" />
                            <input type="text" class="textbox code-area" id="contact1InfoArea" tabindex="6" data-ng-model="customerInfo.PhoneInfo[0].AreaCode" />
                            <input type="text" class="textbox phone" id="contact1InfoPhone" tabindex="7" data-ng-model="customerInfo.PhoneInfo[0].PhoneNumber" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="faxInfo">@Language.Fax</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox code-country" id="faxInfoCountry" tabindex="14"
                                data-ng-model="customerInfo.FaxInfo.CountryCode" />
                            <input type="text" class="textbox code-area" id="faxInfoArea" tabindex="15" data-ng-model="customerInfo.FaxInfo.CountryCode" />
                            <input type="text" class="textbox phone" id="faxInfoFax" tabindex="16" data-ng-model="customerInfo.FaxInfo.CountryCode" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="skypeInfo">@Language.Skype</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="skypeInfo" tabindex="21" data-ng-model="customerInfo.Skype" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="msnInfo">@Language.MSN</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="msnInfo" tabindex="24" data-ng-model="customerInfo.MSN" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="birthdayInfo">@Language.Birthday</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8 date-picker-container" data-ng-model="birthdayOptions.IsRerenderPicker">
                            <input type="text" class="textbox timepicker txtcalendar" id="birthdayInfo" tabindex="27" />
                        </div>
                    </div>
                </div>
                <div class="col-xs-4 col-sm-4 col-md-4">
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="firstNameInfo">@Language.FirstName</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="firstNameInfo" tabindex="3" data-ng-model="customerInfo.FirstName" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="contact2Info">@Language.ContactNumber2</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox code-country" id="contact2InfoCountry" tabindex="8"
                                data-ng-model="customerInfo.PhoneInfo[1].CountryCode" />
                            <input type="text" class="textbox code-area" id="contact2InfoArea" tabindex="9" data-ng-model="customerInfo.PhoneInfo[1].AreaCode" />
                            <input type="text" class="textbox phone" id="contact2InfoPhone" tabindex="10" data-ng-model="customerInfo.PhoneInfo[1].PhoneNumber" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="mobileInfo">@Language.Mobile</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox code-country" id="mobileInfoCountry" tabindex="17"
                                data-ng-model="customerInfo.MobilePhone.CountryCode" />
                            <input type="text" class="textbox code-area" id="mobileInfoArea" tabindex="18" data-ng-model="customerInfo.MobilePhone.AreaCode" />
                            <input type="text" class="textbox phone" id="mobileInfoPhone" tabindex="19" data-ng-model="customerInfo.MobilePhone.PhoneNumber" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="emailInfo">@Language.Email</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="emailInfo" tabindex="22" data-ng-model="customerInfo.Email" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="passportInfo">@Language.PassportNumber</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="passportInfo" tabindex="25" data-ng-model="customerInfo.Passport.Name" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="pic4Info">
                                @Labels.PIC_4
                            </label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="pic4Info" data-ng-model="customerInfo.PersonalInfoContact[3]"
                                tabindex="28" />
                        </div>
                    </div>
                </div>
                <div class="col-xs-4 col-sm-4 col-md-4">
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="lastNameInfo">@Language.LastName</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="lastNameInfo" tabindex="4" data-ng-model="customerInfo.LastName" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="contact3Info">@Language.ContactNumber3</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox code-country" id="contact3InfoCountry" tabindex="11"
                                data-ng-model="customerInfo.PhoneInfo[2].CountryCode" />
                            <input type="text" class="textbox code-area" id="contact3InfoArea" tabindex="12"
                                data-ng-model="customerInfo.PhoneInfo[2].AreaCode" />
                            <input type="text" class="textbox phone" id="contact3InfoPhone" tabindex="13" data-ng-model="customerInfo.PhoneInfo[2].PhoneNumber" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="pic1Info">
                                @Labels.PIC_1
                            </label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="pic1Info" data-ng-model="customerInfo.PersonalInfoContact[0]"
                                tabindex="20" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="pic2Info">
                                @Labels.PIC_2
                            </label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="pic2Info" data-ng-model="customerInfo.PersonalInfoContact[1]"
                                tabindex="23" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <label for="pic3Info">
                                @Labels.PIC_3
                            </label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input type="text" class="textbox" id="pic3Info" data-ng-model="customerInfo.PersonalInfoContact[2]"
                                tabindex="26" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-3 col-sm-3 col-md-3">
                            <label for="isVIP" class="labelforcheckbox checkbox">
                                <input id="isVIP" type="checkbox" tabindex="29" data-ng-model="customerInfo.IsVIP" />@Language.VIP</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row panel-group" data-ng-class="isShowFeedbackDetailBox ? '': 'consecutive-container-before'">
            <div class="row title hand" data-ng-click="showHideFeedbackDetailBox();">
                @Labels.Details
            </div>
            <div class="FeedbackDetail row content" data-ng-show="isShowFeedbackDetailBox">
                <div class="row ">
                    <div class="col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="startTime">@Language.FeedbackDate</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 time-picker-start-time-container" data-ng-model="addGuestFeedbackParams.StartTime">
                                <input type="text" id="startTime" class="txtcalendar textbox timepicker" tabindex="30"
                                    readonly />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlcommunication">@Language.Communication</label>
                                @Html.Raw(Language.RequiredFieldTemplate)
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 communication-tool-picker-container" data-ng-model="communicationToolOptions.DataList">
                                <select id="communication-tool" tabindex="33">
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlproduct">@Language.Product</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 product-picker-container" data-ng-model="productOptions.DataList">
                                <select id="product" tabindex="36">
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddllanguage">@Language._Language</label>
                                @Html.Raw(Language.RequiredFieldTemplate)
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 language-picker-container" data-ng-model="languageOptions.DataList">
                                <select id="language" tabindex="39">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="endTime">@Language.ResolutionTime</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 time-picker-end-time-container" data-ng-model="addGuestFeedbackParams.EndTime">
                                <input type="text" id="endTime" class="txtcalendar textbox timepicker" tabindex="31"
                                    readonly />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlcategory">@Language.Category</label>
                                @Html.Raw(Language.RequiredFieldTemplate)
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 main-category-picker-container" data-ng-model="mainCategoryOptions.DataList">
                                <select id="main-category" tabindex="34">
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="bettype">@Language.BetType</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8  bet-type-picker-container" data-ng-model="betTypeOptions.DataList">
                                <select id="bettype" tabindex="37">
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlstatus">@Language.Status</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 status-picker-container" data-ng-model="statusOptions.DataList">
                                <select id="status" tabindex="40">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlcsextension">@Language.CSExtension</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 extension-picker-container" data-ng-model="extensionOptions.DataList">
                                <select id="extension" tabindex="32">
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlsubcategory">@Language.SubCategory</label>
                                @Html.Raw(Language.RequiredFieldTemplate)
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 sub-category-picker-container" data-ng-model="subCategoryOptions.DataList">
                                <select id="sub-category" tabindex="35">
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlcountry">@Language.country</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 country-picker-container" data-ng-model="countryOptions.DataList">
                                <select id="country" tabindex="38">
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label for="ddlresponse">@Language.Response</label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 response-picker-container" data-ng-model="responseOptions.DataList">
                                <select id="response" tabindex="41">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="row item">
                        <div class="col-xs-3 col-sm-2 col-md-2">
                            <label class="labelforcheckbox checkbox">
                                <input type="checkbox" id="chkisrelated" data-ng-click="checkIsRelated();" data-ng-model="addGuestFeedbackParams.HasRelated"
                                    tabindex="42" />
                                @Language.IsRelatedCustomer
                            </label>
                        </div>
                        <div class="col-xs-9 col-sm-10 col-md-10">
                            <div class="row">
                                <div class="col-xs-11 col-sm-11 col-md-11 related-customer-directive-container" data-ng-model="relatedCustomerOptions.IsUpdate">
                                    <input type="button" value="  " id="btnRelatedHelp"
                                        class="btnHelp pull-left tipsy-directive" 
                                        title="@Labels.Related_Help" 
                                        data-ng-model="tipsyOptions.IsUpdateTip"
                                        tabindex="44" />
                                    <select id="txtrelatedcustomer" name="txtrelatedcustomer" disabled>
                                    </select>
                                </div>
                                <div class="col-xs-1 col-sm-1 col-md-1">
                                    <button id="btnverify" class="btn pull-right" data-ng-click="verifyUserName();" disabled
                                        tabindex="45">
                                        V<span class="hotkey">e</span>rify</button>
                                </div>
                            </div>
                            <div id="ColorGuide" class="row display-none colorGuide">
                                <div class="col-sm-2 col-md-2 relate-customer">
                                    @Language.Customer</div>
                                <div class="col-sm-2 col-md-2 relate-guest">
                                    @Language.Guest</div>
                                <div class="col-sm-2 col-md-2 relate-invalid">
                                    @Language.Invalid</div>
                            </div>
                            <div id="trRelatedInfo" class="row display-none relatedFeedback">
                                <table id="related">
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="row item">
                        <div class="col-xs-3 col-sm-2 col-md-2 lblSubject">
                            <label for="txtsubject">
                                @Language.Subject
                            </label>
                            @Html.Raw(Language.RequiredFieldTemplate)
                        </div>
                        <div class="col-xs-9 col-sm-10 col-md-10 subject-auto-complete-container" data-ng-model="subjectOptions.IsUpdate">
                            <input type="text" id="subject" class="textbox subject-auto-complete txtSubject"
                                autocomplete="off" tabindex="46" data-ng-model="subjectOptions.Subject" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row panel-group" data-ng-class="isShowDescriptionBox ? '' : 'consecutive-container-before'">
            <div class="row title">
                <div class="pull-left hand" data-ng-click="isShowDescriptionBox = !isShowDescriptionBox;">
                    @Labels.Description @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                </div>
                <div class="pull-right">
                    <input type="button" class="btnreview " value="@Language.Preview" id="btndesreview" data-ng-click="showDescriptionPreview();" 
                        data-ng-class="isShowDescriptionPreview ? 'hidden' : '' " />
                    <input type="button" class="btnedit hidden" value="@Language.Edit" id="btndesedit" data-ng-click="showDescriptionEditor();"
                        data-ng-class="isShowDescriptionPreview ? '' : 'hidden' " />
                </div>
            </div>
            <div class="FeedbackDescription row content" data-ng-class="isShowDescriptionBox ? '' : 'hide'">
                <div class="editerwrapper" id="descriptionwrapper">
                    <div id="previewboxdes" class="preview raw-html-directive" data-ng-class="isShowDescriptionPreview ? '' : 'hidden' "
                        data-ng-model="descriptionOptions.SelectedText">
                    </div>
                    <div id="descriptioneditorboxcontainer" class="description-editor-container" data-ng-model="descriptionOptions.SelectedText"
                        data-ng-class="isShowDescriptionPreview ? 'hidden' : '' ">
                    </div>
                </div>
            </div>
        </div>
        <div class="row panel-group last" data-ng-class="isShowSolutionBox ? '' : 'consecutive-container-before'">
            <div class="row title">
                <div class="pull-left hand" data-ng-click="isShowSolutionBox = !isShowSolutionBox;">
                    @Labels.Solution @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                </div>
                <div class="pull-right">
                    <input type="button" class="btnreview " value="@Language.Preview" id="btnsolreview" data-ng-click="showSolutionPreview();"
                        data-ng-class="isShowSolutionPreview ? 'hidden' : '' " />
                    <input type="button" class="btnedit" value="@Language.Edit" 
                        id="btnsoledit" data-ng-click="showSolutionEditor();"
                        data-ng-class="isShowSolutionPreview ? '' : 'hidden' " />
                </div>
            </div>
            <div class="FeedbackSolution row content" data-ng-class="isShowSolutionBox ? '' : 'hide'">
                <div class="editerwrapper" id="solutionwrapper">
                    <div id="previewboxsol" class="preview raw-html-directive" data-ng-class="isShowSolutionPreview ? '' : 'hidden' "
                        data-ng-model="solutionOptions.SelectedText">
                    </div>
                    <div id="solutioneditorboxcontainer" class="solution-editor-container" data-ng-model="solutionOptions.SelectedText"
                        data-ng-class="isShowSolutionPreview ? 'hidden' : '' ">
                    </div>
                </div>
            </div>
        </div>
        <div class="row btn-group">
            <button class="btn" data-ng-click="addFeedback();">
                <span class="hotkey">S</span>ave</button>
        </div>
        <input type="text" class="textbox default-focus-element default-focus" data-ng-model="isSetFocus" />
    </div>
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    <script type="text/javascript" src="~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js"></script>
    <script type="text/javascript" src="~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js"></script>
    <script type="text/javascript" src="~/Scripts/Jlinq/jlinq/jlinq.jquery.js"></script>
    <script type="text/javascript" src="~/Scripts/autocomplete/jquery.highlight-3.js"></script>
    <script type="text/javascript" src="~/Scripts/autocomplete/jquery.autocomplete.client.js"></script>
    <script type="text/javascript" src="~/Scripts/Tipsy-Tooltip/jquery.tipsy.js"></script>
    <script type="text/javascript" src="~/Scripts/common.js"></script>
    <script type="text/javascript" src="~/Scripts/InputBox/jquery.fcbkcomplete.js"></script>
    @Scripts.Render("~/Scripts/TimePicker",
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/Areas/Feedbacks/AddGuestFeedback/AddGuestFeedbackScripts")
    <script type="text/javascript">
        parent.document.title = '@Resources.Language.Title_AddGuestFeedback';
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTimeUtilize.GetCurrentClientTime().ToShortFormatedDate()';
        var currentTime = '@DateTimeUtilize.GetCurrentClientTime()';
        var currentTime = '@DateTimeUtilize.GetCurrentClientTime()';
        var currentUsername = "@AppSession.CurrentUser.Username";
        var viewResources = {
            All: '@Labels.All',
            Select: '@Labels.Select',
            Insert_Edit_Block: '@Labels.Insert_Edit_Block',
