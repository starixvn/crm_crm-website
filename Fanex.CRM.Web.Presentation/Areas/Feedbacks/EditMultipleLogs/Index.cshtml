@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
@using Newtonsoft.Json;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Edit_Multiple_Logs;
    var jsonLogInfo = JsonConvert.SerializeObject(Model);
    var hasUpdateMultipleLogsPermission = (bool)ViewBag.HasUpdateMultipleLogsPermission;
    var hasReviewPermission = ((bool)ViewBag.HasReviewPermission).ToString().ToLower();
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/autocomplete/autocomplete.css")
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
    @RazorHelper.RenderStyles("~/Areas/Feedbacks/EditMultipleLogsStyles")
}
<div data-ng-app="edit-multiple-logs-application">
    <div class="main popup container editmultiplelogscontroller" data-ng-controller="editMultipleLogsController">
        <div class="row panel-group" data-ng-show="isShowResultMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ isSuccess ? 'scc' : 'err' }}" class="alertbox{{ isSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="resultMessage">
                    </div>
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row content">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="listCustomer">
                                @Labels.ListOfCustomers
                            </label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input id="listCustomer" name="listCustomer" class="list-customer" disabled="disabled" data-ng-model="listOfCustomers" />
                        </div>
                        <div class="col-xs-1 col-sm-1 col-md-1"></div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="startTime">
                                @Labels.Start_Time
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3">
                            <input type="text" id="startTime" class="txtcalendar textbox timepicker" readonly
                                    onselect="onStartTimeChanged()" data-ng-model="multipleLogs.StartTime" datetimepicker />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="ext">
                                @Labels.Ext
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-extension data-ng-model="extensionList">
                            <select id="ext"></select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="endTime">
                                @Labels.End_Time
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3">
                            <input type="text" id="endTime" class="txtcalendar textbox timepicker" readonly data-ng-model="multipleLogs.EndTime"
                                    datetimepicker />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="country">
                                @Labels.Country
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-country data-ng-model="countryList">
                            <select id="country"></select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="communicationTool">
                                @Labels.Communication_Tool
                                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-communication-tool data-ng-model="communicationToolList">
                            <select id="communicationTool"></select>
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="language">
                                @Labels.Language
                                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-language data-ng-model="languageList">
                            <select id="language" class="languageoptions"></select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="mainCategory">
                                @Labels.Main_Category
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-main-category data-ng-model="mainCategoryList">
                            <select id="mainCategory"></select>
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="subcategory">
                                @Labels.Sub_Category
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-sub-category data-ng-model="subCategoryList">
                            <select id="subCategory"></select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="product">
                                @Labels.Product
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-product data-ng-model="productOptions.DataList">
                            <select id="product"></select>
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="subproduct">
                                @Labels.SubProduct
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-sub-product data-ng-model="subProductOptions.DataList">
                            <select id="subProduct"></select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="status">
                                @Labels.Status
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-status data-ng-model="statusList">
                            <select id="status"></select>
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="betType">
                                @Labels.Bet_Type
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-bet-type data-ng-model="betTypeList">
                            <select id="betType"></select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="role">
                                @Labels.Role
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-role data-ng-model="roleList">
                            <select id="role"></select>
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="site">
                                @Labels.Site
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3">
                             <select id="site" data-ng-model="multipleLogs.SiteInfo" ng-change="updateSelectedSite();"
                                    data-ng-options="s.Name group by s.AliasName for s in siteList track by s.Id">
                                <option value="">-- @Labels.Select --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="licensee-type">
                                @Labels.Licensee_Type
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3">
                            <select id="licensee-type" data-ng-model="multipleLogs.LicenseeType" data-ng-options="s.Name for s in licenseeTypes track by s.Id"></select>
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="response">
                                @Labels.Response
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3" dropdown-response data-ng-model="responseList">
                            <select id="response"></select>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="subject">
                                @Labels.Subject
                                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                            </label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8 subject-container">
                            <input type="text" class="textbox " id="subject" data-ng-model="multipleLogs.Subject"
                                    subject-auto-complete />
                            <span class="errormsg" data-ng-hide="requiredManager.subject">@Labels.RequiredInformation</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title remarktitle" data-ng-class="isShowRemarkBox ? '' : 'border-bottom-none'"
                    data-ng-click="isShowRemarkBox = !isShowRemarkBox">
                @Labels.Remark
                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                <span class="errormsg" data-ng-hide="requiredManager.remark">@Labels.RequiredInformation</span>
            </div>
            <div class="row content multi-text" data-ng-show="isShowRemarkBox">
                <div id="remarkeditorboxcontainer" data-ng-model="multipleLogs.Remark" remark-editor-container>
                </div>
            </div>
        </div>
        <div class="row panel-group last">
            <div class="row title solutiontitle" data-ng-class="isShowSolutionBox ? '' : 'border-bottom-none'"
                    data-ng-click="isShowSolutionBox = !isShowSolutionBox">
                @Labels.Solution
                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                <span class="errormsg" data-ng-hide="requiredManager.solution">@Labels.RequiredInformation</span>
            </div>
            <div class="row content multi-text" data-ng-show="isShowSolutionBox">
                <div id="solutionkeditorboxcontainer" data-ng-model="multipleLogs.Solution" solution-editor-container>
                </div>
            </div>
        </div>
        <div class="row panel-group last">
            <div class="row title" data-ng-class="!hasReviewPermission || !multipleLogs.IsReviewed ? 'border-bottom-none' : ''">
                <label for="review">
                    @Labels.Reviewed
                </label>                
                <input id="review" type="checkbox" class="review" data-ng-click="multipleLogs.IsReviewed=!multipleLogs.IsReviewed;"
                       data-ng-model="multipleLogs.IsReviewed" data-ng-disabled="!hasReviewPermission" />
                <span class="errormsg" data-ng-hide="requiredManager.review">@Labels.RequiredInformation</span>
                <label class="label-reivewedbyinfo" data-ng-class="{'display-none': !oldmultipleLogs.IsReviewed || !requiredManager.review}"
                       data-ng-bind="getReviewedInfo();">
                </label>
            </div>
            <div data-ng-class="{'display-none': hasReviewPermission }" class="disable-review-text">
                @Html.Raw(Model.Review)
            </div>
            <div class="row content multi-text" data-ng-class="{'display-none': !hasReviewPermission || !multipleLogs.IsReviewed}">
                <div id="revieweditorboxcontainer" data-ng-model="multipleLogs.Review" review-editor-container>
                </div>
            </div>
        </div>
        @if (hasUpdateMultipleLogsPermission)
        {
        <div class="row">
            <button class="btn btn-save" data-ng-click="editMultipleLogs();">
                <span class="hotkey">S</span>ave
            </button>
        </div>
        }
        <div class="footer-div">&nbsp;</div>
        <input type="text" class="textbox default-focus-element" default-focus data-ng-model="isSetFocus" />
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/TimePicker")
    @RazorHelper.RenderScripts("~/Scripts/FanexMultipleSelect")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/moment.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.highlight-3.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.autocomplete.client.js")
    @RazorHelper.RenderScripts("~/Scripts/common.js")
    @RazorHelper.RenderScripts("~/Areas/Feedbacks/EditMultipleLogsScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentTime = '@DateTimeUtilize.CurrentClientTime()';
        var currentUsername = "@AppSession.CurrentUser.Username";
        var multipleLogs = @Html.Raw(jsonLogInfo);
        var hasReviewPermission = @hasReviewPermission;
        var viewResources = {
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            Select: '@Labels.Select',
            Insert_Edit_Block: '@Labels.Insert_Edit_Block',
            Warning: '@Labels.Warning',
            OK: '@Labels.OK',
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            CustomerNameLengthErrorMessage: '@Labels.RelatedCustomerNameLengthErrorMessage',
            Multiple_Logs_VerifyRelatedCustomer: '@Labels.Multiple_Logs_VerifyRelatedCustomer',
            Multiple_Logs_NACommmunicationTool: '@Labels.Multiple_Logs_NACommmunicationTool',
            Multiple_Logs_EmptyListOfCustomers: '@Labels.Multiple_Logs_EmptyListOfCustomers',

            Multiple_Logs_ErrorEndTime: '@Labels.Multiple_Logs_ErrorEndTime',
            Multiple_Logs_NALanguage: '@Labels.Multiple_Logs_NALanguage',

            Multiple_Logs_EmptySubject: '@Labels.Multiple_Logs_EmptySubject',
            Multiple_Logs_EmptyRemark: '@Labels.Multiple_Logs_EmptyRemark',
            Multiple_Logs_EmptySolution: '@Labels.Multiple_Logs_EmptySolution',
            Confirm_Ignore_MultipleLogs_Changes: '@Html.Raw(Labels.Confirm_Ignore_MultipleLogs_Changes)',
            ReviewedInformation: '@Labels.ReviewedInformation',
            Multiple_Logs_EmptyReview: '@Labels.Multiple_Logs_EmptyReview'
        };
    </script>
}