@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
@using Newtonsoft.Json;
@using CommonLabels = Fanex.CRM.Common.Resources.Labels;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Edit_Multiple_Logs;
    var jsonLogInfo = JsonConvert.SerializeObject(Model);
    var hasUpdateMultipleLogsPermission = (bool)ViewBag.HasUpdateMultipleLogsPermission;
    var hasReviewPermission = ((bool)ViewBag.HasReviewPermission).ToString().ToLower();
    var isCN88 = (ViewBag.UserRole == Fanex.CRM.Common.Enumerations.UserRole.CN88Staff);
    var hideLicenseeTypeClass = isCN88 ? "hide-item" : "";
    var hideProvinceClass = isCN88 ? "" : "hide-item";
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/autocomplete/autocomplete.css")
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
    @RazorHelper.RenderStyles("~/Scripts/Directives/selectwithsearch/selectwithsearch.css")
    @RazorHelper.RenderStyles("~/Scripts/Directives/multileveldropdown/multileveldropdown.css")
    @RazorHelper.RenderStyles("~/Areas/Feedbacks/EditMultipleLogsStyles")
}
<div data-ng-app="edit-multiple-logs-application">
    <div class="main popup container edit-multiple-logs" data-ng-controller="editMultipleLogsController">
        <div class="row panel-group" data-ng-show="isShowResultMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ isSuccess ? 'scc' : 'err' }}" class="alertbox{{ isSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="resultMessage"></div>
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row content">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="listCustomer">@Labels.ListOfCustomers</label>
                        </div>
                        <div class="col-xs-8 col-sm-8 col-md-8">
                            <input id="listCustomer" name="listCustomer" class="list-customer" disabled="disabled" data-ng-model="listOfCustomers" />
                        </div>
                        <div class="col-xs-2 col-sm-2 col-md-2">
                            <div class="checkbox select-all-field">
                                <label>Select all <input type="checkbox" ng-change="onSelectAllField()" ng-model="selectAllField" /></label>
                            </div>
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="startTime">@Labels.Start_Time</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <input type="text" id="startTime" class="txtcalendar textbox timepicker field" readonly
                                   onselect="onStartTimeChanged()" data-ng-model="multipleLogs.StartTime" datetimepicker />
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateStartTime" ng-change="onSelectField('isUpdateStartTime')" />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="ext">@Labels.Ext</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <multileveldropdowntree class="field" text-settings="TextSettings"
                                                    data-ng-model="selectedExtensions"
                                                    data-settings="extensionDropdownSettings"></multileveldropdowntree>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateExtensions" ng-change="onSelectField('isUpdateExtensions')" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="endTime">@Labels.End_Time</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <input type="text" id="endTime" class="txtcalendar textbox timepicker field"
                                   readonly data-ng-model="multipleLogs.EndTime" datetimepicker />
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateEndTime" ng-change="onSelectField('isUpdateEndTime')" />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="response">@Labels.Response</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <select class="field" id="response"
                                    ng-model="multipleLogs.Response" ng-options="item.Value for item in responseList track by item.Id"></select>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateResponse" ng-change="onSelectField('isUpdateResponse')" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="communicationTool">
                                @Labels.Communication_Tool
                                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <multileveldropdowntree class="field" text-settings="TextSettings"
                                                    data-ng-model="selectedCommunications"
                                                    data-settings="communicationDropdownSettings"></multileveldropdowntree>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateCommunications" ng-change="onSelectField('isUpdateCommunications')" />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="language">
                                @Labels.Language
                                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <select id="language" class="languageoptions field"
                                    ng-model="multipleLogs.Language" ng-options="item.Name for item in languageList track by item.Id">
                            </select>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateLanguage" ng-change="onSelectField('isUpdateLanguage')" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="mainCategory">
                                @Labels.Main_Category
                                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <multileveldropdowntree class="field" text-settings="TextSettings"
                                                    data-ng-model="selectedCategories"
                                                    data-ng-change="categoryChangedHandler()"
                                                    data-settings="categoryDropdownSettings"
                                                    user-do-check="categoriesChangedByUser"></multileveldropdowntree>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateCategory" ng-change="onSelectField('isUpdateCategories')" />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="subCategory">
                                @Labels.Sub_Category
                                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                            </label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <multileveldropdowntree class="field" text-settings="TextSettings"
                                                    data-ng-change="subCategoryChangedHandler()"
                                                    data-ng-model="selectedSubCategories"
                                                    data-settings="subCategoryDropdownSettings"></multileveldropdowntree>
                            <input type="checkbox" class="selected-field" disabled ng-model="selectFields.isUpdateCategory" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="product">@Labels.Product</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <multileveldropdowntree class="field" text-settings="TextSettings"
                                                    data-ng-model="selectedProducts"
                                                    data-ng-change="productChangedHandler()"
                                                    data-settings="productDropdownSettings"></multileveldropdowntree>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateProduct" ng-change="onSelectField('isUpdateProducts')" />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="subproduct">@Labels.SubProduct</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <multileveldropdowntree class="field" text-settings="TextSettings"
                                                    data-ng-model="selectedSubProducts"
                                                    data-ng-change="subProductChangedHandler()"
                                                    data-settings="subProductDropdownSettings"></multileveldropdowntree>
                            <input type="checkbox" class="selected-field" disabled ng-model="selectFields.isUpdateProduct" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="status">@Labels.Status</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <select id="status" class="field"
                                    ng-model="multipleLogs.Status" ng-options="item.Name for item in statusList track by item.Id"></select>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateStatus" ng-change="onSelectField('isUpdateStatus')" />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="betType">@Labels.Bet_Type</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <multileveldropdowntree class="field" text-settings="TextSettings"
                                                    data-ng-model="selectedBettypes"
                                                    data-settings="bettypeDropdownSettings"
                                                    data-ng-change="bettypeChangeHandler()"></multileveldropdowntree>
                            <input type="checkbox" class="selected-field" disabled ng-model="selectFields.isUpdateProduct" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="role">@Labels.Role</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <select id="role" class="field"
                                    ng-model="multipleLogs.RoleInfo" ng-options="item.Value for item in roleList track by item.Id"></select>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateRole" ng-change="onSelectField('isUpdateRole')" />
                        </div>
                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                            <label for="site">@Labels.Site</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <selectwithsearchtree class="field" text-settings="TextSettings"
                                                  data-ng-model="selectedSite"
                                                  data-settings="siteDropdownSettings"
                                                  hide-NA="isCN88"></selectwithsearchtree>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateSite" ng-change="onSelectField('isUpdateSite')" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2">
                            <label for="country">@Labels.Country</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <select id="country" class="field"
                                    ng-model="multipleLogs.Country" ng-options="item.Name for item in countryList track by item.Id">
                            </select>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateCountry" ng-change="onSelectField('isUpdateCountry')" />
                        </div>

                        <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2 col-lg-2 @hideLicenseeTypeClass">
                            <label for="licensee-type">@Labels.Licensee_Type</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 @hideLicenseeTypeClass group-field">
                            <select id="licensee-type" ng-model="multipleLogs.LicenseeType" class="field"
                                    ng-options="s.Name for s in licenseeTypes track by s.Id"></select>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateLicenseeType" ng-change="onSelectField('isUpdateLicenseeType')" />
                        </div>
                    </div>
                    <div class="row item @hideProvinceClass">
                        <div class="col-xs-2 col-sm-2 col-md-2">
                            <label for="province">@Labels.Province</label>
                        </div>
                        <div class="col-xs-3 col-sm-3 col-md-3 group-field">
                            <select id="province" class="field"
                                    ng-model="multipleLogs.Province" ng-options="item.Name for item in provinceList track by item.Id">
                            </select>
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateProvince" ng-change="onSelectField('isUpdateProvince')" />
                        </div>
                    </div>
                    <div class="row item">
                        <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="subject">
                                @Labels.Subject
                                @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                            </label>
                        </div>
                        <div class="col-xs-9 col-sm-9 col-md-9 subject-container group-field">
                            <input type="text" class="textbox field" id="subject" data-ng-model="multipleLogs.Subject"
                                   subject-auto-complete />
                            <input type="checkbox" class="selected-field"
                                   ng-model="selectFields.isUpdateSubject" ng-change="onSelectField('isUpdateSubject')" />
                        </div>
                    </div>
                    <div class="row item" data-ng-hide="requiredManager.subject">
                        <div class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2">
                            <span class="errormsg">@Labels.RequiredInformation</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title">
                <div class="pull-left">@Labels.Auto_Generated</div>
                <div class="pull-right">
                    <input type="checkbox" ng-model="selectFields.isUpdateAutoField" ng-change="onSelectField('isUpdateAutoGenerated')" />
                </div>
            </div>
            <div class="FeedbackDescription row content">
                <div class="" id="">
                    <textarea rows="3" class="auto-generated-text" data-ng-model="autoGeneratedText"></textarea>
                </div>
            </div>
        </div>
        <div class="row panel-group">
            <div class="row title">
                <div class="pull-left">
                    @Labels.Remark
                    @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    <span class="errormsg" data-ng-hide="requiredManager.remark">@Labels.RequiredInformation</span>
                </div>
                <div class="pull-right">
                    <input type="checkbox" ng-model="selectFields.isUpdateRemark" ng-change="onSelectField('isUpdateRemark')" />
                </div>
            </div>
            <div class="row content multi-text" data-ng-show="isShowRemarkBox">
                <div id="remarkeditorboxcontainer" data-ng-model="multipleLogs.Remark" remark-editor-container></div>
            </div>
        </div>
        <div class="row panel-group last">
            <div class="row title">
                <div class="pull-left">
                    @Labels.Solution
                    @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                    <span class="errormsg" data-ng-hide="requiredManager.solution">@Labels.RequiredInformation</span>
                </div>
                <div class="pull-right">
                    <input type="checkbox" ng-model="selectFields.isUpdateSolution" ng-change="onSelectField('isUpdateSolution')" />
                </div>
            </div>
            <div class="row content multi-text" data-ng-show="isShowSolutionBox">
                <div id="solutionkeditorboxcontainer" data-ng-model="multipleLogs.Solution" solution-editor-container></div>
            </div>
        </div>
        <div class="row panel-group last">
            <div class="row title" data-ng-class="!hasReviewPermission || !multipleLogs.IsReviewed ? 'border-bottom-none' : ''">
                <div class="pull-left">
                    <label for="review">@Labels.Reviewed</label>
                    <input id="review" type="checkbox" class="review" ng-model="multipleLogs.IsReviewed" ng-disabled="!hasReviewPermission" />
                    <span class="errormsg" ng-hide="requiredManager.review">@Labels.RequiredInformation</span>
                    <label class="label-reivewedbyinfo" ng-class="{'display-none': !oldmultipleLogs.IsReviewed || !requiredManager.review}"
                           ng-bind="getReviewedInfo();">
                    </label>
                </div>
                <div class="pull-right">
                    <input type="checkbox" ng-model="selectFields.isUpdateReviewed" ng-change="onSelectField('isUpdateReviewed')" />
                </div>
            </div>
            <div data-ng-class="{'display-none': hasReviewPermission }" class="disable-review-text">
                @Html.Raw(Model.Review)
            </div>
            <div class="row content multi-text" data-ng-class="{'display-none': !hasReviewPermission || !multipleLogs.IsReviewed}">
                <div id="revieweditorboxcontainer" data-ng-model="multipleLogs.Review" review-editor-container></div>
            </div>
        </div>
        @if (hasUpdateMultipleLogsPermission)
        {
            <div class="row btn-group">
                <button class="btn btn-save" data-ng-click="editMultipleLogs();">
                    @Html.Raw(@CommonLabels.Btn_HotKey_Save)
                </button>
            </div>
        }
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/TimePicker")
    @RazorHelper.RenderScripts("~/Scripts/FanexMultipleSelect")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/moment.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.highlight-3.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.autocomplete.client.js")
    @RazorHelper.RenderScripts("~/Scripts/common.js")
    @RazorHelper.RenderScripts("~/Areas/Feedbacks/EditMultipleLogsScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentTime = '@DateTimeUtilize.CurrentClientTime()';
        var currentUsername = "@AppSession.CurrentUser.Username";
        var multipleLogs = @Html.Raw(jsonLogInfo);
        var hasReviewPermission = @hasReviewPermission;
        var isCN88 = '@isCN88' == 'True';
        var viewResources = {
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            Select: '@Labels.Select',
            Insert_Edit_Block: '@Labels.Insert_Edit_Block',
            Warning: '@Labels.Warning',
            OK: '@Labels.OK',
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            CustomerNameLengthErrorMessage: '@Labels.RelatedCustomerNameLengthErrorMessage',
            Multiple_Logs_VerifyRelatedCustomer: '@Labels.Multiple_Logs_VerifyRelatedCustomer',
            Multiple_Logs_NACommmunicationTool: '@Labels.Multiple_Logs_NACommmunicationTool',
            Multiple_Logs_EmptyListOfCustomers: '@Labels.Multiple_Logs_EmptyListOfCustomers',
            Error_NASubCategory: '@Labels.Error_NASubCategory',
            Error_NA_MainSubCategory: '@Labels.Error_NA_MainSubCategory',

            Multiple_Logs_ErrorEndTime: '@Labels.Multiple_Logs_ErrorEndTime',
            Multiple_Logs_NALanguage: '@Labels.Multiple_Logs_NALanguage',

            Multiple_Logs_EmptySubject: '@Labels.Multiple_Logs_EmptySubject',
            Multiple_Logs_EmptyRemark: '@Labels.Multiple_Logs_EmptyRemark',
            Multiple_Logs_EmptySolution: '@Labels.Multiple_Logs_EmptySolution',
            Confirm_Ignore_MultipleLogs_Changes: '@Html.Raw(Labels.Confirm_Ignore_MultipleLogs_Changes)',
            ReviewedInformation: '@Labels.ReviewedInformation',
            Multiple_Logs_EmptyReview: '@Labels.Multiple_Logs_EmptyReview',
            InvalidCategoryError: '@Labels.InvalidCategoryError',
            DescriptionMaxLengthError: '@Labels.DescriptionMaxLengthError',
            SolutionMaxLengthError: '@Labels.SolutionMaxLengthError',
            ConfirmMultipleUpdates: '@CommonLabels.ConfirmMultipleUpdates',
            ConfirmMultipleUpdatesMessage: '@CommonLabels.ConfirmMultipleUpdatesMessage',
            NoFieldSelectedMessage: '@CommonLabels.NoFieldSelectedMessage'
        };
    </script>
}