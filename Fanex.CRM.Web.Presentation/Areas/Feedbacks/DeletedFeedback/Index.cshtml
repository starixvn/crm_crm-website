@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Common.Helpers;
@using CommonLabels = Fanex.CRM.Common.Resources.Labels;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Language.Title_DeletedFeedback;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Areas/Feedbacks/DeletedFeedback/DeletedFeedbackStyles")
}
<div data-ng-app="deleted-feedback-application">
    <div class="main container" data-ng-controller="deletedFeedbackController">
        <div class="row filter-frm one-row deletedFeedback">
            <form novalidate data-ng-submit="searchDeletedFeedback();">
                <div class="row row-item">
                    <div class="item">
                        <label for="txtusername" class="width-80">
                            @Labels.Username
                        </label>
                        <input type="text" id="txtusername" class="textbox txtUsername" data-ng-model="searchCriteria.Username" />
                        &nbsp;
                        <select id="ddlguest" class="selGuest" data-ng-model="searchCriteria.IsGuest" data-ng-options="c.Name for c in customerTypes"></select>
                    </div>
                    <div class="item">
                        <label for="txtfromdate" class="width-70">
                            @Labels.FromDate
                        </label>
                        <div class="display-inline-block date-picker-from-date-container" data-ng-model="fromDateOptions.IsRerenderPicker">
                            <input id="fromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                        </div>
                    </div>
                    <div class="item">
                        <label for="txttodate" class="lblToDate">
                            @Labels.ToDate
                        </label>
                        <div class="display-inline-block date-picker-to-date-container" data-ng-model="toDateOptions.IsRerenderPicker">
                            <input id="toDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item main-category-picker-container" data-ng-model="mainCategoryOptions.DataList">
                        <label for="main-category" class="width-80">
                            @Labels.MainCategory
                        </label>
                        <select id="main-category" class="selMainCategory"></select>
                    </div>
                    <div class="item sub-category-picker-container" data-ng-model="subCategoryOptions.DataList">
                        <label for="sub-category" class="width-70">
                            @Labels.SubCategory
                        </label>
                        <select id="sub-category" class="selSubCategory"></select>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item">
                        <label for="ddlcommunication" class="width-80">
                            @Labels.Communication
                        </label>
                        <select id="ddlcommunication" class="selCommunication" data-ng-model="searchCriteria.Communication"
                                data-ng-options="c.Name for c in communications"></select>
                    </div>
                    <div class="item">
                        <label for="ddlCustomerReponse" class="lblReponse">
                            @Labels.CustomerResponse
                        </label>
                        <select id="ddlCustomerReponse" class="selResponse" data-ng-model="searchCriteria.Response"
                                data-ng-options="r.Value for r in responses"></select>
                    </div>
                    <div class="item">
                        <label for="ddlIsReviewed" class="width-70">
                            @Labels.IsReviewed
                        </label>
                        <select id="ddlIsReviewed" class="selReviewed" data-ng-model="searchCriteria.IsReviewed"
                                data-ng-options="r.Name for r in reviews"></select>
                    </div>
                    <div class="item">
                        <button class="btn">@Labels.Submit</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="row">
            <div table-deleted-feedback-container data-ng-model="report">
                <div id="table-deleted-feedback" class="freegrid hide">
                </div>
            </div>
        </div>

        <div class="download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/FanexGridScripts",
        "~/CRM/DownLoadFile/Scripts",
        "~/Areas/Feedbacks/DeletedFeedback/DeletedFeedbackScripts")
    <script language="javascript" type="text/javascript">
        parent.document.title = document.title;
        window.rootUrl = '@Url.Content("~")';

        var currentDate = '@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()';
        var currentTime = new Date(currentDate);
        var yesterday = new Date(currentDate);
        yesterday.setDate(yesterday.getDate() - 1);

        var deletedFeedbackResources = {
            All: '@Labels.All',
            Guest: '@Labels.Guest',
            Reviewed: '@Labels.Reviewed',
            NotReviewed: '@Labels.NotReviewed',
            Feedback: '@Labels.Feedback',
            Customer: '@Labels.Customer',
            Category: '@Labels.Category',
            Status: '@Labels.Status',
            RelatedCustomer: '@Labels.RelatedCustomer',
            UpdateFeedbackTitle: '@Labels.UpdateFeedbackTitle',
            DeletedFeedbackTitle: '@Labels.DeletedFeedbackTitle',
            Close: '@CommonLabels.Close'
        };
    </script>
}