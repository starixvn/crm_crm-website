@using Fanex.CRM.Infrastructure.Extensions;
@using CommonLabels = Fanex.CRM.Common.Resources.Labels;
@model IList<Fanex.CRM.Infrastructure.Models.BaseModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.LatestFeedbackDocumentTitle;
    var model = Newtonsoft.Json.JsonConvert.SerializeObject(Model);
}
@section Styles{
    @RazorHelper.RenderStyles("~/Areas/Feedbacks/LatestFeedback/LatestFeedbackStyles")
}
<div data-ng-app="feedback-latest-application">
    <div class="main container" data-ng-controller="latestFeedbackController">
        <div class="row filter-frm">
            <div class="row">
                <label for="top">@Labels.Top</label>
                <select id="top" class="sel-top" data-ng-model="top" data-ng-options="a.Name for a in tops"
                        data-ng-change="getLatestFeedback()"></select>
            </div>
        </div>
        <div class="row">
            <div table-latest-feedback-container data-ng-model="report">
                <div id="table-latest-feedback" class="freegrid hide">
                </div>
            </div>
        </div>

        <div class="download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/FanexGridScripts",
            "~/CRM/DownLoadFile/Scripts",
            "~/Areas/Feedbacks/LatestFeedback/LatestFeedbackScripts")
    <script language="javascript" type="text/javascript">
        parent.document.title = document.title;
        window.rootUrl = '@Url.Content("~")';

        var custId = @ViewBag.CustId;
        var username = "@HttpUtility.JavaScriptStringEncode(ViewBag.Username)";
        var tops = @Html.Raw(model);
        var latestFeedbackResources = {
            Feedback: '@Labels.Feedback',
            Category: '@Labels.Category',
            Status: '@Labels.Status',
            RelatedCustomer: '@Labels.RelatedCustomer',
            UpdateFeedbackTitle: '@Labels.UpdateFeedbackTitle',
            RunningNo: '@Labels.RunningNo',
            There_is_no_data: '@CommonLabels.There_is_no_data',
            Closed: '@CommonLabels.Closed'
        };
    </script>
}