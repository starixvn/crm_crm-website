@using Fanex.CRM.Infrastructure.Core;
@using Fanex.CRM.Infrastructure.Extension;
@model IList<Fanex.CRM.Infrastructure.Models.BaseModel>
@{
    var custId = (int)ViewBag.CustId;
    var username = ViewBag.Username;
    var model = Newtonsoft.Json.JsonConvert.SerializeObject(Model); 
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="feedback-latest-application">
<head>
    <title>@Labels.LatestFeedbackDocumentTitle</title>
    @Styles.Render("~/site/common",
        "~/Areas/Feedbacks/LatestFeedback/LatestFeedbackStyles")
</head>
<body>
    <div class="main container" data-ng-controller="latestFeedbackController">
        <div class="row filter-frm">
            <div class="row">
                <label for="top">@Labels.Top</label>
                <select id="top" class="sel-top" data-ng-model="top" data-ng-options="a.Name for a in tops" data-ng-change="getLatestFeedback()">
                </select>
            </div>
        </div>
        <div class="row">
            <div table-latest-feedback-container data-ng-model="report">
                <div id="table-latest-feedback" class="freegrid hide"></div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/Scripts/CommomScripts",
        "~/Scripts/AngularJSLibrary",
        "~/Scripts/FanexGridScripts",
        "~/Areas/Feedbacks/LatestFeedback/LatestFeedbackScripts")
    <script language="javascript" type="text/javascript">
        parent.document.title = document.title;
        window.rootUrl = '@Url.Content("~")';

        var custId = @custId;
        var username = '@username';
        var tops = @Html.Raw(model); 
        var latestFeedbackResources = {
            Feedback: '@Labels.Feedback',
            Category: '@Labels.Category',
            Status: '@Labels.Status',
            RelatedCustomer: '@Labels.RelatedCustomer',
            UpdateFeedbackTitle: '@Labels.UpdateFeedbackTitle'
        };
    </script>
</body>
</html>

