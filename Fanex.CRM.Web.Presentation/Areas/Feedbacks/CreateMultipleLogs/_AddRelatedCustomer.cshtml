<div id="template-add-realted-customers" style="display: none">
    <div class="modal-header">
        {{relatedCustomerCtrl.isEdit ? 'Update ' : 'Add '}}Related Customers
        <span class="icon-close fa fa-times" ng-click="relatedCustomerCtrl.close()"></span>
    </div>
    <div class="modal-body">
        <div class="row item" ng-show="relatedCustomerCtrl.resultMessages.length > 0 || relatedCustomerCtrl.overRelatedCustomers.length > 0">
            <div class="alertbox {{ relatedCustomerCtrl.isSuccessful ? 'success' : 'error' }}">
                <ul>
                    <li ng-repeat="item in relatedCustomerCtrl.resultMessages track by $index" ng-bind="item"></li>
                    <li ng-if="relatedCustomerCtrl.overRelatedCustomers.length > 0">
                        The number of related customers of a headline or direct account without group headline is not allowed over
                        {{relatedCustomerCtrl.maximumRelatedCustomersPerFeedback}}.
                        <br />
                        Click on these accounts to get the list of related customers:
                        <span ng-repeat="item in relatedCustomerCtrl.overRelatedCustomers track by $index">
                            <a ng-bind="item.Username" ng-click="relatedCustomerCtrl.viewOverRelatedCustomer(item)" style="cursor: pointer"></a>
                            <span ng-if="$index < relatedCustomerCtrl.overRelatedCustomers.length - 1">, </span>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="row item">
            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                <label>
                    @Fanex.CRM.Resources.Labels.Username
                    <span class="mandatoryfield">*</span>
                </label>
            </div>
            <div class="col-xs-10 col-sm-10 col-md-10">
                <div class="related-customer-container" ng-mousedown="$event.preventDefault()" ng-click="relatedCustomerCtrl.focused = true">
                    <div ng-if="relatedCustomerCtrl.relatedCustomers.length > 0">
                        <div class="related-customer-item {{item.isValid ? '' : 'invalid'}} {{relatedCustomerCtrl.isSellectedAll ? 'selected' : ''}}"
                             ng-repeat="item in relatedCustomerCtrl.relatedCustomers track by $index">
                            <span ng-bind="item.username"></span>
                            <span class="fa fa-times" ng-click="relatedCustomerCtrl.removeRelatedCustomer(item)"></span>
                        </div>
                    </div>
                    <input type="text" focus-me="relatedCustomerCtrl.focused" maxlength="30" ng-model="relatedCustomerCtrl.relatedCustomerInput"
                           ng-keydown="relatedCustomerCtrl.keydownHandler($event)"
                           ng-paste="relatedCustomerCtrl.pasteHandler($event)"
                           data-on-blur="relatedCustomerCtrl.focusoutHandler" />
                </div>
                <div class="maximum-username">Maximum usernames: {{relatedCustomerCtrl.maxItems - relatedCustomerCtrl.relatedCustomers.length}}</div>
            </div>
        </div>
        <div class="row item">
            <button class="btn verify-related-customer" ng-click="relatedCustomerCtrl.verifyRelatedCustomer()">@Fanex.CRM.Resources.Labels.Verify</button>
        </div>
        <div class="row item">
            <div id="related-customer-grid" class="related-customer-grid freegrid display-none"
                 related-customer-grid
                 ng-model="relatedCustomerCtrl.relatedCustomerResults"
                 data-on-view-related-customer="relatedCustomerCtrl.viewRelatedCustomer"></div>
        </div>
    </div>
    <div class="modal-footer">
        <button class="btn" ng-click="relatedCustomerCtrl.save()"
                ng-disabled="relatedCustomerCtrl.relatedCustomerResults.length === 0 || !relatedCustomerCtrl.verified">
            @Fanex.CRM.Resources.Labels.Save
        </button>
        <button class="btn" ng-click="relatedCustomerCtrl.close()">@Fanex.CRM.Resources.Labels.Cancel</button>
    </div>
</div>