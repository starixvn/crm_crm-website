@using Fanex.NAP.Core.Business;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
@using CommonLabels = Fanex.CRM.Common.Resources.Labels;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Create_Multiple_Logs;

    var customerId = Model;
    var isCN88 = (ViewBag.UserRole == Fanex.CRM.Common.Enumerations.UserRole.CN88Staff);
    var hideLicenseeTypeClass = isCN88 ? "hide-item" : "";
    var CN88SiteId = ViewBag.CN88SiteId;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
    @RazorHelper.RenderStyles("~/Areas/Feedbacks/CreateMultipleLogsStyles")
}
<div ng-app="create-multiple-logs-application">
    <div ng-controller="createMultipleLogsController">
        <div class="container main">
            <div class="row row-item" ng-show="isShowResultMessage">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div ng-class="alertbox{{ isSuccessful ? 'scc' : 'err' }}" class="alertbox{{ isSuccessful ? 'scc' : 'err' }}">
                        <div data-ng-bind="resultMessage"></div>
                    </div>
                </div>
            </div>
            <div class="row panel-group">
                <div class="row content">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label for="listCustomer">
                                    @Labels.ListOfCustomers
                                    @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                                </label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <input id="listCustomer" name="listCustomer" class="list-customer"
                                       ng-model="customersInput" autocomplete="off" />
                            </div>
                            <div class="col-xs-1 col-sm-1 col-md-1">
                                <button class="btn pull-right" ng-click="verifyListCustomer()" ng-disabled="customersInput === ''">
                                    @Html.Raw(@CommonLabels.Btn_HotKey_Verify)
                                </button>
                            </div>
                            <div class="col-xs-1 col-sm-1 col-md-1">
                                <span class="fa fa-exclamation-circle pull-right"
                                      tooltip-placement="bottom-right"
                                      uib-tooltip="Communication Tool, Country, Language, Role, Site, Licensee Type shall be update automatically by system!"></span>
                            </div>
                        </div>
                        <div class="row item">
                            <div id="ColorGuide" class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-8 col-sm-8 col-md-8"
                                 ng-show="relatedCustomerResultDirective.relatedCustomers.length > 0">
                                <div class="col-xs-2 col-sm-2 col-md-2 relate-customer">@Labels.Customer</div>
                                <div class="col-xs-2 col-sm-2 col-md-2 relate-guest">@Labels.Guest</div>
                                <div class="col-xs-2 col-sm-2 col-md-2 relate-invalid">@Labels.Invalid</div>
                            </div>
                            <div id="related-container" class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-8 col-sm-8 col-md-8 related"
                                 ng-show="relatedCustomerResultDirective.relatedCustomers.length > 0">
                                <table id="related" ng-model="relatedCustomerResultDirective.relatedCustomers" relatedcustomerresult></table>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label for="startTime">@Labels.Start_Time</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <input type="text" id="startTime" class="txtcalendar textbox timepicker" readonly
                                       onselect="onStartTimeChanged()" ng-model="multipleLogs.StartTime" datetimepicker />
                            </div>
                            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                                <label for="ext">@Labels.Ext</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <multileveldropdowntree text-settings="TextSettings"
                                                        ng-model="selectedExtensions"
                                                        data-settings="extensionDropdownSettings"></multileveldropdowntree>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label for="endTime">@Labels.End_Time</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <input type="text" id="endTime" class="txtcalendar textbox timepicker" readonly
                                       ng-model="multipleLogs.EndTime" datetimepicker />
                            </div>
                            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                                <label>@Labels.Country</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <select disabled>
                                    <option value="">@CommonLabels.Symbol_NotApply</option>
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label>@Labels.Communication_Tool</label>
                                <span ng-show="!multipleLogs.isUseDefaultCommunicationTool">@Html.Raw(Resources.Language.Html_Template_MandatoryField)</span>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <multileveldropdowntree text-settings="TextSettings"
                                                        data-ng-model="selectedCommunications"
                                                        data-settings="communicationDropdownSettings"
                                                        ng-change="communicationChangeHandler()"
                                                        ng-disabled="multipleLogs.isUseDefaultCommunicationTool" />
                            </div>
                            <div class="col-xs-1 col-sm-1 col-md-2">
                                <input type="checkbox" class="ckb-use-default-comm-tool"
                                       ng-model="multipleLogs.isUseDefaultCommunicationTool"
                                       ng-change="ckbDefaultCommunicationToolChangeHandler()"
                                       tooltip-placement="bottom-left"
                                       uib-tooltip="Apply default communication tool." />
                            </div>
                            <div class="col-xs-2 col-sm-2 col-md-2">
                                <label>@Labels.Language</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <select disabled>
                                    <option value="">@CommonLabels.Symbol_NotApply</option>
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label for="mainCategory">
                                    @Labels.Category
                                    @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                                </label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <multileveldropdowntree text-settings="TextSettings"
                                                        ng-model="selectedCategories"
                                                        ng-change="categoryChangedHandler()"
                                                        data-settings="categoryDropdownSettings"></multileveldropdowntree>
                            </div>
                            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                                <label for="subCategory">
                                    @Labels.SubCategory
                                    @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                                </label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <multileveldropdowntree text-settings="TextSettings"
                                                        ng-change="subCategoryChangedHandler()"
                                                        ng-model="selectedSubCategories"
                                                        data-settings="subCategoryDropdownSettings"></multileveldropdowntree>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label for="product">@Labels.Product</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <multileveldropdowntree text-settings="TextSettings"
                                                        ng-model="selectedProducts"
                                                        ng-change="productChangedHandler()"
                                                        data-settings="productDropdownSettings"></multileveldropdowntree>
                            </div>
                            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                                <label for="subproduct">@Labels.SubProduct</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <multileveldropdowntree text-settings="TextSettings"
                                                        ng-model="selectedSubProducts"
                                                        ng-change="subProductChangedHandler()"
                                                        data-settings="subProductDropdownSettings"></multileveldropdowntree>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label for="status">@Labels.Status</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <select ng-model="multipleLogs.Status"
                                        ng-options="item.Name for item in statusList track by item.Id"></select>
                            </div>
                            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                                <label for="betType">@Labels.Bet_Type</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <multileveldropdowntree text-settings="TextSettings"
                                                        ng-model="selectedBettypes"
                                                        data-settings="bettypeDropdownSettings"
                                                        ng-change="bettypeChangeHandler()"></multileveldropdowntree>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label>@Labels.Role</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <select disabled>
                                    <option value="">@CommonLabels.Symbol_NotApply</option>
                                </select>
                            </div>
                            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2">
                                <label>@Labels.Site</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <select disabled>
                                    <option value="">@CommonLabels.Symbol_NotApply</option>
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2">
                                <label>@Labels.Response</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <select ng-model="multipleLogs.Response"
                                        ng-options="item.Value for item in responseList track by item.Id"></select>
                            </div>
                            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-2 col-xs-2 col-sm-2 col-md-2 col-lg-2 @hideLicenseeTypeClass">
                                <label for="licensee-type">@Labels.Licensee_Type</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3 @hideLicenseeTypeClass">
                                <select disabled>
                                    <option value="">@CommonLabels.Symbol_NotApply</option>
                                </select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2">
                                <label for="response">@Labels.NoOfInquiries</label>
                            </div>
                            <div class="col-xs-3 col-sm-3 col-md-3">
                                <input class="textbox" type="number" name="input" ng-keydown="validateInquiriesInput($event);" oninput="validity.valid||value < 1 && (value=1)||value > 32000 && (value=32000);" min="1" max="32000" data-ng-model="multipleLogs.NoInquiries" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                                <label for="subject">
                                    @Labels.Subject
                                    @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                                </label>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8 subject-container">
                                <input type="text" class="textbox " id="subject" ng-model="multipleLogs.Subject"
                                       subject-auto-complete autocomplete="off" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row panel-group">
                <div class="row title">
                    <div class="pull-left hand">@Labels.Auto_Generated</div>
                </div>
                <div class="FeedbackDescription row content">
                    <div>
                        <textarea rows="3" class="auto-generated-text" ng-model="autoGeneratedText"></textarea>
                    </div>
                </div>
            </div>
            <div class="row panel-group">
                <div class="row title remarktitle" ng-class="isShowRemarkBox ? '' : 'border-bottom-none'"
                     ng-click="isShowRemarkBox = !isShowRemarkBox">
                    @Labels.Remark
                    @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                </div>
                <div class="row content multi-text" ng-show="isShowRemarkBox">
                    <div id="remarkeditorboxcontainer" ng-model="multipleLogs.Remark" remark-editor-container></div>
                </div>
            </div>
            <div class="row panel-group last">
                <div class="row title solutiontitle" ng-class="isShowSolutionBox ? '' : 'border-bottom-none'"
                     ng-click="isShowSolutionBox = !isShowSolutionBox">
                    @Labels.Solution
                    @Html.Raw(Resources.Language.Html_Template_MandatoryField)
                </div>
                <div class="row content multi-text" ng-show="isShowSolutionBox">
                    <div id="solutionkeditorboxcontainer" ng-model="multipleLogs.Solution" solution-editor-container></div>
                </div>
            </div>
            <div class="row btn-group">
                <button class="btn btn-save" ng-click="insertMultipleLogs();">
                    @Html.Raw(@CommonLabels.Btn_HotKey_Save)
                </button>
            </div>
            <input type="text" class="textbox default-focus-element" default-focus ng-model="isSetFocus" />
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/TimePicker")
    @RazorHelper.RenderScripts("~/Scripts/FanexMultipleSelect")
    @RazorHelper.RenderScripts("~/Areas/Feedbacks/CreateMultipleLogsScripts")
    <script type="text/javascript">
        parent.document.title = '@Labels.Create_Multiple_Logs';
        window.rootUrl = '@Url.Content("~")';
        var currentTime = '@DateTimeUtilize.CurrentClientTime()';
        var customerId = '@customerId';
        var currentUsername = "@AppSession.CurrentUser.Username";
        var isCN88 = '@isCN88' == 'True';
        var CN88SiteId = parseInt('@CN88SiteId');
        var viewResources = {
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            Select: '@Labels.Select',
            Insert_Edit_Block: '@Labels.Insert_Edit_Block',
            Warning: '@Labels.Warning',
            OK: '@Labels.OK',
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            CustomerNameLengthErrorMessage: '@Labels.RelatedCustomerNameLengthErrorMessage',
            Multiple_Logs_VerifyRelatedCustomer: '@Labels.Multiple_Logs_VerifyRelatedCustomer',
            Multiple_Logs_EmptyListOfCustomers: '@Labels.Multiple_Logs_EmptyListOfCustomers',
            Multiple_Logs_NACommmunicationTool: '@Labels.Multiple_Logs_NACommmunicationTool',
            Multiple_Logs_ErrorEndTime: '@Labels.Multiple_Logs_ErrorEndTime',
            Error_NAMainCategory: '@Labels.Error_NAMainCategory',
            NoSubcategoryError: '@Labels.NoSubcategoryError',
            Error_NASubCategory: '@Labels.Error_NASubCategory',
            Error_NA_MainSubCategory: '@Labels.Error_NA_MainSubCategory',

            Multiple_Logs_EmptySubject: '@Labels.Multiple_Logs_EmptySubject',
            Multiple_Logs_EmptyRemark: '@Labels.Multiple_Logs_EmptyRemark',
            Multiple_Logs_EmptySolution: '@Labels.Multiple_Logs_EmptySolution',
            Confirm_Ignore_MultipleLogs_Changes: '@Html.Raw(Labels.Confirm_Ignore_MultipleLogs_Changes)',
            InvalidCategoryError: '@Labels.InvalidCategoryError',
            DescriptionMaxLengthError: '@Labels.DescriptionMaxLengthError',
            SolutionMaxLengthError: '@Labels.SolutionMaxLengthError',
            FeedbackDuplicationError: '@Labels.FeedbackDuplicationError',
            Confirm_Changes: '@Labels.Confirm_Changes',
            Confirm_Changes_Message: '@Labels.Confirm_Changes_Message',
            Remark_Multiple_Log_Note: '@Labels.Remark_Multiple_Log_Note'
        };
    </script>
}