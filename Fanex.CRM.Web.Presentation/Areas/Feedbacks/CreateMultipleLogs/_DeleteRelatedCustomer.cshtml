<div id="template-delete-realted-customers" style="display: none">
    <div class="modal-header">
        Delete Related Customers
        <span class="icon-close fa fa-times" ng-click="deleteRelatedCustomerCtrl.close()"></span>
    </div>
    <div class="modal-body">
        <div class="row row-item">
            Are you sure you want to delete the related customers?
        </div>
    </div>
    <div class="modal-footer">
        <button class="btn" ng-click="deleteRelatedCustomerCtrl.delete()">@Fanex.CRM.Resources.Labels.OK</button>
        <button class="btn" ng-click="deleteRelatedCustomerCtrl.close()">@Fanex.CRM.Resources.Labels.Cancel</button>
    </div>
</div>