@using Fanex.CRM.Common.Resources

<div id="template-edit-commtool-setting" style="display: none">
    <div class="modal-header">
        @Labels.UpdateSetting
        <span class="icon-close fa fa-times" ng-click="editCommToolSettingCtrl.close()"></span>
    </div>
    <div class="modal-body">
        <div class="row row-item" ng-show="editCommToolSettingCtrl.isShowResultMessage">
            <div class="alertbox{{ editCommToolSettingCtrl.isSuccessful ? 'scc' : 'err' }}"><div>{{editCommToolSettingCtrl.resultMessage}}</div></div>
        </div>
        <div class="row item">
            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                <label>@Labels.Customer</label>
            </div>
            <div class="col-xs-8 col-sm-8 col-md-8">{{editCommToolSettingCtrl.username}}</div>
        </div>
        <div class="row item">
            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                <label>
                    @Labels.Category
                    <span class="mandatoryfield">*</span>
                </label>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3 category-select">
                <multileveldropdowntree text-settings="editCommToolSettingCtrl.textSettings"
                                        data-settings="editCommToolSettingCtrl.categoryDropdownSettings"
                                        data-show-selected-all-text="true"
                                        ng-model="editCommToolSettingCtrl.selectedCategories"
                                        ng-change="editCommToolSettingCtrl.categoryChangedHandler()"
                                        ng-on-checkall="editCommToolSettingCtrl.categorySelectAllHandler()" />
            </div>
            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                <label>
                    @Labels.SubCategory
                    <span class="mandatoryfield">*</span>
                </label>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3 subcategory-select">
                <multileveldropdowntree text-settings="editCommToolSettingCtrl.textSettings"
                                        data-settings="editCommToolSettingCtrl.subCategoryDropdownSettings"
                                        data-show-selected-all-text="true"
                                        ng-model="editCommToolSettingCtrl.selectedSubCategories"
                                        ng-change="editCommToolSettingCtrl.subCategoryChangedHandler()"
                                        ng-on-checkall="editCommToolSettingCtrl.subCategorySelectAllHandler()" />
            </div>
        </div>
        <div class="row item">
            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                <label>
                    @Labels.CommunicationTool
                    <span class="mandatoryfield">*</span>
                </label>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <multileveldropdowntree text-settings="editCommToolSettingCtrl.communicationTextSettings"
                                        data-settings="editCommToolSettingCtrl.communicationDropdownSettings"
                                        ng-model="editCommToolSettingCtrl.selectedCommunications"
                                        ng-change="editCommToolSettingCtrl.communicationChangeHandler()" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button class="btn" ng-click="editCommToolSettingCtrl.save()" ng-disabled="editCommToolSettingCtrl.isDisableEdit">
            @Html.Raw(Labels.Btn_HotKey_Update)
        </button>
        <button class="btn" ng-click="editCommToolSettingCtrl.close()">@Labels.Cancel</button>
    </div>
</div>