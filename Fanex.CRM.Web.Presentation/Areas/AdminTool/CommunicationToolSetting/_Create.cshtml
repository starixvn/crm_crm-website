@using Fanex.CRM.Common.Resources

<div id="template-create-commtool-setting" style="display: none">
    <div class="modal-header">
        @Labels.InsertNewSetting
        <span class="icon-close fa fa-times" ng-click="createCommToolSettingCtrl.close()"></span>
    </div>
    <div class="modal-body">
        <div class="row row-item" ng-show="createCommToolSettingCtrl.isShowResultMessage">
            <div class="alertbox{{ createCommToolSettingCtrl.isSuccessful ? 'scc' : 'err' }}"><div>{{createCommToolSettingCtrl.resultMessage}}</div></div>
        </div>
        <div class="row item">
            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                <label>
                    @Labels.ListOfCustomers
                    <span class="mandatoryfield">*</span>
                    <span class="fa fa-question-circle-o"
                          tooltip-placement="bottom-left"
                          uib-tooltip="@Labels.Helper_RelatedCustomerInputMessage" />
                </label>
            </div>
            <div class="col-xs-8 col-sm-8 col-md-8">
                <input name="listCustomer" class="list-customer" autocomplete="off"
                       ng-model="createCommToolSettingCtrl.customersInput" autofocus />
            </div>
            <div class="col-xs-1 col-sm-1 col-md-1">
                <button class="btn pull-right" ng-click="createCommToolSettingCtrl.verifyCustomers()"
                        ng-disabled="createCommToolSettingCtrl.customersInput === ''">
                    @Labels.Btn_Verify
                </button>
            </div>
        </div>
        <div class="row item" ng-show="createCommToolSettingCtrl.relatedCustomers.length > 0">
            <div class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-8 col-sm-8 col-md-8 description-result">
                <div class="col-xs-2 col-sm-2 col-md-2 customer">@Labels.Customer</div>
                <div class="col-xs-2 col-sm-2 col-md-2 guest">@Labels.Guest</div>
                <div class="col-xs-2 col-sm-2 col-md-2 invalid">@Labels.Invalid</div>
            </div>
            <div class="col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-xs-8 col-sm-8 col-md-8 related-customer-grid related"
                 related-customer-grid
                 ng-model="createCommToolSettingCtrl.relatedCustomers"
                 data-on-delete-customer="createCommToolSettingCtrl.deleteCustomer">
            </div>
        </div>
        <div class="row item">
            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                <label>
                    @Labels.Category
                    <span class="mandatoryfield">*</span>
                </label>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <multileveldropdowntree text-settings="createCommToolSettingCtrl.textSettings"
                                        data-settings="createCommToolSettingCtrl.categoryDropdownSettings"
                                        data-show-selected-all-text="true"
                                        ng-model="createCommToolSettingCtrl.selectedCategories"
                                        ng-change="createCommToolSettingCtrl.categoryChangedHandler()"
                                        ng-on-checkall="createCommToolSettingCtrl.categorySelectAllHandler()" />
            </div>
            <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-2 col-sm-2 col-md-2">
                <label>
                    @Labels.SubCategory
                    <span class="mandatoryfield">*</span>
                </label>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <multileveldropdowntree text-settings="createCommToolSettingCtrl.textSettings"
                                        data-settings="createCommToolSettingCtrl.subCategoryDropdownSettings"
                                        data-show-selected-all-text="true"
                                        ng-model="createCommToolSettingCtrl.selectedSubCategories"
                                        ng-change="createCommToolSettingCtrl.subCategoryChangedHandler()"
                                        ng-on-checkall="createCommToolSettingCtrl.subCategorySelectAllHandler()" />
            </div>
        </div>
        <div class="row item">
            <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2">
                <label>
                    @Labels.CommunicationTool
                    <span class="mandatoryfield">*</span>
                </label>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <multileveldropdowntree text-settings="createCommToolSettingCtrl.communicationTextSettings"
                                        data-settings="createCommToolSettingCtrl.communicationDropdownSettings"
                                        ng-model="createCommToolSettingCtrl.selectedCommunications" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button class="btn" ng-click="createCommToolSettingCtrl.saveAndContinue()" ng-disabled="createCommToolSettingCtrl.isDiableCreate">@Labels.Btn_Save & @Labels.Continue</button>
        <button class="btn" ng-click="createCommToolSettingCtrl.save()"  ng-disabled="createCommToolSettingCtrl.isDiableCreate">@Labels.Btn_Save</button>
        <button class="btn" ng-click="createCommToolSettingCtrl.close()">@Labels.Cancel</button>
    </div>
</div>