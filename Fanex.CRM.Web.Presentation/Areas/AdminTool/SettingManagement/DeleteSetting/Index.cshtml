﻿@using Fanex.CRM.AdminTool.Resources;
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Models;
@model SettingInfo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Title_AdminTool_SettingManagement;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Areas/Admin/SettingManagement/DeleteSettingStyles")
}
<div data-ng-app="addmintool-settingmanagement-deletesetting">
    <div class="deleteSettingController" data-ng-controller="deleteSettingController">
        <div class="container main popup">
            <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                        class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                        <div data-ng-bind="messageResultOptions.Message">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                @string.Format(Labels.SettingManagement_DeleteSetting_Message, Model.SettingType, Model.Value)
            </div>
            <div class="row btn-group">
                <button id="btn-ok" class="btn pull-left btn-ok" data-ng-click="deleteSetting();">@Labels.Ok
                </button>
                <button id="btn-cancel" class="btn pull-left btn-cancel" data-ng-click="cancelDeleteSetting();">@Labels.Cancel
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/CommomScripts")
    @RazorHelper.RenderScripts("~/Scripts/AngularJSLibrary")
    @RazorHelper.RenderScripts(
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/Areas/Admin/SettingManagement/DeleteSettingScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var settingInfo =
        {
            Id: @Model.Id,
            SettingType: '@Model.SettingType',
            Value: '@Model.Value'
        };
    </script>
}