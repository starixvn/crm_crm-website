﻿@using Fanex.CRM.AdminTool.Resources;
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Models;
@model SettingInfo
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="addmintool-settingmanagement-deletesetting">
<head>
    <title>@Labels.Title_AdminTool_SettingManagement </title>
    @Styles.Render("~/site/common")
    @Styles.Render("~/Areas/Admin/SettingManagement/DeleteSettingStyles")
</head>
<body class="deleteSettingController" data-ng-controller="deleteSettingController">
    <div class="container main popup">
        <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                    class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="messageResultOptions.Message">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            @string.Format(Labels.SettingManagement_DeleteSetting_Message, Model.Type, Model.Value)
        </div>
        <div class="row btn-group">
            <button id="btn-ok" class="btn pull-left btn-ok" data-ng-click="deleteSetting();">@Labels.Ok
            </button>
            <button id="btn-cancel" class="btn pull-left btn-cancel" data-ng-click="cancelDeleteSetting();">@Labels.Cancel
            </button>
        </div>
    </div>
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    @Scripts.Render(
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/Areas/Admin/SettingManagement/DeleteSettingScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var settingInfo = 
        {
            Id: @Model.Id,
            Type: '@Model.Type',
            Value: '@Model.Value'
        };
    </script>
</body>
</html>
