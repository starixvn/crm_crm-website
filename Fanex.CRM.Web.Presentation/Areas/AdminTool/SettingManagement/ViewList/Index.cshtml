﻿@using Fanex.CRM.AdminTool.Resources;
@using Fanex.CRM.Infrastructure.Extension;
@using Fanex.CRM.Infrastructure.Core;
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="addmintool-settingmanagement-application">
<head>
    <title>@Labels.Title_AdminTool_SettingRelation </title>
    @Styles.Render("~/site/common")
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/FanexGridV2/Fanex.Grid.css?ver=1")"  />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/site/customizeFanexGridV2.less?ver=1")"  />
    @Styles.Render("~/Areas/Admin/SettingManagement/ViewListStyles")
</head>
<body class="viewListController" data-ng-controller="viewListController">
    <div class="container main">
        <div class="row filter-frm one-row">
            <div class="item afterButton main-setting-container" data-ng-model="mainSettingOptions.DataList">
                <select id="mainsetting">
                </select>
            </div>
            <div class="item afterButton">
                <button id="btn-search" class="btn pull-left btn" data-ng-click="getSettingRelations();">
                    <span class="hotkey">S</span>earch
                </button>
            </div>
            <div class="item afterButton">
                <button id="btn-insert-newsetting" class="btn pull-left btn" data-ng-click="insertNewSetting();">
                    <span>@Labels.Insert_New_Setting</span>
                </button>
            </div>
            <div class="item afterButton">
                <button id="btn-insert-newsettingvaluefor" class="btn pull-left btn" data-ng-click="insertSubSetting();">
                    <span data-ng-bind="sharedScriptManager.stringFormat('{0} {1}', ['@Labels.Insert_Setting_value_for', getSettingRelationsParams.MainSetting.Type])">
                    </span>
                </button>
            </div>
        </div>
        <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                    class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="messageResultOptions.Message">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div id="setting-management-list-container" class="setting-management-list-container"
                data-ng-model="settingManagementView">
                <div id="settingmanagement-list" class="freegrid display-none">
                </div>
            </div>
        </div>
        <input type="text" class="textbox default-focus-element default-focus" data-ng-model="isSetFocus" />
    </div>
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    @Scripts.Render(
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/Scripts/FanexGridScripts",
        "~/Areas/Admin/SettingManagement/ViewListScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var viewResources = {
            All: '@Labels.All',
            Edit: '@Labels.Edit',
            Delete: '@Labels.Delete',
            Setting: '@Labels.Setting',
            Relation: '@Labels.Relation',
            Setting_Id: '@Labels.Setting_Id',
            Order: '@Labels.Order',
            ViewListTitle: '@Labels.SettingManagement_ViewListTitle',
            Setting_Relation_Management: '@Labels.Setting_Relation_Management',
            Insert_New_Setting: '@Labels.Insert_New_Setting'
        };
    </script>
</body>
</html>
