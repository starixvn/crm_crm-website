﻿@using Fanex.CRM.AdminTool.Resources;
@using Fanex.CRM.Infrastructure.Extensions;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Labels.Title_AdminTool_FeedbackSubjectManagement;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Scripts/FanexGridV2/Fanex.Grid.css")
    @RazorHelper.RenderStyles("~/Scripts/FanexGridV2/Fanex.Pagination.css")
    @RazorHelper.RenderStyles("~/Content/site/customizeFanexGridV2.less")
    @RazorHelper.RenderStyles("~/Areas/Admin/FeedbackSubjectManagement/ViewListStyles")
}
<div data-ng-app="addmintool-feedbacksubjectmanagement-application">
    <div class="feedbackSubjectManagementController" data-ng-controller="feedbackSubjectManagementController">
        <div class="container main">
            <div class="row filter-frm one-row subjectTemplate">
                <div class="item afterButton subject-auto-complete-container" data-ng-model="subjectOptions.IsUpdate">
                    <input id="subject" name="txt-template-subject" type="text" class="textbox txt-search subject-auto-complete"
                        autocomplete="off" data-ng-model="subjectOptions.Subject" />
                </div>
                <div class="item afterButton">
                    <button id="btn-search" class="btn pull-left btn-update " data-ng-click="searchTemplate();">
                        <span class="hotkey">S</span>earch
                    </button>
                </div>
                <div class="item">
                    <button id="btn-insert-setting" class="btn pull-left btn-update " data-ng-click="showInsertPopup();">
                        <span class="hotkey">I</span>nsert New Feedback Subject
                    </button>
                </div>
            </div>
            <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                        class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                        <div data-ng-bind="messageResultOptions.Message">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div id="feedback-template-list-container" class="feedback-template-list-container"
                    data-ng-model="feedbackSubjectTemplateView">
                    <div id="feedback-template-list" class="freegrid display-none">
                    </div>
                </div>
            </div>
            <input type="text" class="textbox default-focus-element default-focus" data-ng-model="isSetFocus" />
        </div>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/Jlinq/jlinq/jlinq.jquery.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.highlight-3.js")
    @RazorHelper.RenderScripts("~/Scripts/autocomplete/jquery.autocomplete.client.js")
    @RazorHelper.RenderScripts("~/Scripts/Paging/jpager.js")
    @RazorHelper.RenderScripts(
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/Scripts/FanexGridScripts",
        "~/Areas/Admin/FeedbackSubjectManagement/ViewListScripts")
    <script type="text/javascript">
        parent.document.title = '@Labels.Title_AdminTool_FeedbackSubjectManagement';
        window.rootUrl = '@Url.Content("~")';
        var viewResources = {
            Active: '@Labels.Active',
            Edit: '@Labels.Edit',
            Feedback_Subject_Template_Content: '@Labels.Feedback_Subject_Template_Content',
            Template_Id: '@Labels.Template_Id',
            Edit_Feedback_Subject_Template: '@Labels.Edit_Feedback_Subject_Template',
            Insert_Feedback_Subject_Template: '@Labels.Insert_New_Feedback_Subject_Template',
            ActiveFeedbackSubjectTitle: '@Labels.ActiveFeedbackSubjectTitle',
            DeactiveFeedbackSubjectTitle: '@Labels.DeactiveFeedbackSubjectTitle'
        };
    </script>
}