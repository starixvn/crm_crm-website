﻿@using Fanex.CRM.AdminTool.Resources;
@using Fanex.CRM.Infrastructure.Extension;
@using Fanex.CRM.Infrastructure.Core;
@model int
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="addmintool-feedbacksubjectmanagement-deletetemplate">
<head>
    <title>@Labels.Title_AdminTool_FeedbackSubjectManagement </title>
    @Styles.Render("~/site/common")
    @Styles.Render("~/Areas/Admin/FeedbackSubjectManagement/DeleteTemplateStyles")
</head>
<body class="deleteTemplateController" data-ng-controller="deleteTemplateController">
    <div class="container main">
        <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                    class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="messageResultOptions.Message">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            @string.Format(Labels.FeedbackSubjectManagement_DeleteTemplate_Message, Model)
        </div>
        <div class="row btn-group">
            <button id="btn-ok" class="btn pull-left btn-ok" data-ng-click="deleteTemplate();">@Labels.Ok
            </button>
            <button id="btn-cancel" class="btn pull-left btn-cancel" data-ng-click="cancelDeleteTemplate();">@Labels.Cancel
            </button>
        </div>
    </div>
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    @Scripts.Render(
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/Areas/Admin/FeedbackSubjectManagement/DeleteTemplateScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var templateId = @Model;
        var viewResources = {
            Edit: '@Labels.Edit',
            Delete: '@Labels.Delete'
        };
    </script>
</body>
</html>
