@using Fanex.CRM.Redemption.Resources;
@using Newtonsoft.Json;
@using Fanex.CRM.Redemption.Models;
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@using Fanex.NAP.Core.Business;
@model int
@{
    var customerId = JsonConvert.SerializeObject(Model);
    var customerInfoPolicy = (Constant.Policy)ViewBag.CustomerInfoPolicy;
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="redemption-viewlog-application">
<head>
    <title>@Resources.Language.Title_RedemptionTab </title>
    @RazorHelper.RenderStyles("~/site/common")
    @RazorHelper.RenderStyles("~/Scripts/FanexGridV2/Fanex.Grid.css")
    @RazorHelper.RenderStyles("~/Content/site/customizeFanexGridV2.less")
    @RazorHelper.RenderStyles("~/Areas/Redemption/ViewLogStyles")
</head>
<body>
    <div class="container main" data-ng-controller="redemptionViewLogController">
        <div class="row filter-frm one-row redemption-filter">
            <div class="item">
                <label for="fromDate">
                    @Labels.From_date</label>
                <div class="display-inline-block" data-ng-model="searchCriteria.MaxFromDate" date-picker-from-date-container>
                    <input id="fromDate" type="text" class="textbox txtcalendar" />
                </div>
            </div>
            <div class="item">
                <label for="toDate">
                    @Labels.To_date</label>
                <div class="display-inline-block" data-ng-model="searchCriteria.MinToDate" date-picker-to-date-container>
                    <input id="toDate" type="text" class="textbox txtcalendar" />
                </div>
            </div>
            <div class="item afterButton" data-ng-model="statusList" dropdown-status-container>
                <label for="status">
                    @Labels.Status</label>
                <select id="status">
                </select>
            </div>
            <div class="item">
                <button class="btn" data-ng-click="searchLogs();">
                    <span class="hotkey">S</span>ubmit</button>
            </div>
        </div>
        <div class="row row-item" data-ng-show="isShowResultMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ isSuccess ? 'scc' : 'err' }}" class="alertbox{{ isSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="resultMessage">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div data-ng-model="logs" table-redemption-logs-container>
                <div id="table-redemption-logs" class="freegrid display-none">
                </div>
            </div>
        </div>
        @if (customerInfoPolicy == Constant.Policy.Host)
        {
            <div class="row btn-group">
                <button class="btn" data-ng-click="insertLog();">
                    <span class="hotkey">I</span>nsert Case</button>
            </div>
        }
        <input type="text" class="textbox default-focus-element" default-focus data-ng-model="isSetFocus" />
    </div>
    @RazorHelper.RenderScripts("~/Scripts/CommomScripts")
    @RazorHelper.RenderScripts("~/Scripts/AngularJSLibrary")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/Fanex.Grid.js")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/moment.js")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridV2/NumeralScripts", "~/Areas/Redemption/ViewLogScripts")
    <script type="text/javascript">
        parent.document.title = document.title;
        window.rootUrl = '@Url.Content("~")';
        var customerId = @customerId; 
        var currentDate = '@DateTimeUtilize.CurrentClientTime().Date.ToShortFormatedDate()';
        var initFromDate = '@DateTimeUtilize.CurrentClientTime().Date.FirstDayOfMonth().ToShortFormatedDate()';
        var viewResources = { 
            Edit_Redemption_Log: '@Labels.Edit_Redemption_Log',
            Insert_Redemption_Log: '@Labels.Insert_Redemption_Log',
            Subject:'@Labels.Subject',
            Claimed_Time: '@Labels.Claimed_Time',
            Status: '@Labels.Status',
            Customer_Redemption_Logs: '@Labels.Customer_Redemption_Logs',
            All: '@Labels.All',
            Currency: '@Labels.Currency',
            DoneBy: '@Labels.DoneBy',
            Amount: '@Labels.Amount'
        }; 
    </script>
</body>
</html>
