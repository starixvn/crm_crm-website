@using Fanex.CRM.Redemption.Resources;
@using Newtonsoft.Json;
@using Fanex.CRM.Redemption.Models;
@using Fanex.CRM.Infrastructure.Extension;
@using Fanex.CRM.Infrastructure.Core;
@{
    var jsonLogInfo = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="redemption-editlog-application">
<head>
    <title>@Labels.Insert_Redemption_Log </title>
    @Styles.Render("~/site/common")
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.css")"  />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/autocomplete/styles.css")" />
    @Styles.Render("~/Areas/Redemption/EditLogStyles")
</head>
<body>
    <div class="main popup container" data-ng-controller="editLogController">
        <div class="row form-group">
            <div class="row row-item" data-ng-show="isShowResultMessage">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div data-ng-class="alertbox{{ isSuccess ? 'scc' : 'err' }}" class="alertbox{{ isSuccess ? 'scc' : 'err' }}">
                        <div data-ng-bind="resultMessage">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2">
                    <label for="claimTime">
                        @Labels.Claimed_Time</label></div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div date-picker-container>
                        <input id="claimTime" type="text" class="textbox timepicker txtcalendar" tabindex="1" />
                    </div>
                </div>
                <div class="col-xs-offset-1 col-sm-offset-1 col-md-offset-1 col-xs-1 col-sm-1 col-md-1">
                    <label for="status">
                        @Labels.Status</label>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3" data-ng-model="statusList" dropdown-status-container>
                    <select id="status" tabindex="2">
                    </select>
                </div>
            </div>
            <div class="row row-item">
                <div class="col-xs-2 col-sm-2 col-md-2">
                    <label for="subject">
                        @Labels.Subject</label></div>
                <div class="col-xs-8 col-sm-8 col-md-8 subject-container">
                    <input type="text" class="textbox" id="subject" data-ng-model="redemptionLog.Subject"
                        subject-auto-complete />
                </div>
            </div>
        </div>
        <div class="row panel-group last">
            <div class="row title">
                @Labels.Remark</div>
            <div class="row content multi-text">
                <div id="remarkeditorboxcontainer" data-ng-model="redemptionLog.Remark" remark-editor-container>
                </div>
            </div>
        </div>
        <div class="row">
            <button class="btn btn-save" button-save default-focus data-ng-model="isSetFocus">
                <span class="hotkey">S</span>ave</button>
        </div>
    </div>
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/TimePicker")
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    <script type="text/javascript" src="~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js"></script>
    <script type="text/javascript" src="~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js"></script>
    <script type="text/javascript" src="~/Scripts/Jlinq/jlinq/jlinq.jquery.js"></script>
    <script type="text/javascript" src="~/Scripts/autocomplete/jquery.highlight-3.js"></script>
    <script type="text/javascript" src="~/Scripts/autocomplete/jquery.autocomplete.client.js"></script>
    @Scripts.Render("~/Areas/Redemption/EditLogScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTimeUtilize.ChangeTimeZoneToClientDateTime(DateTime.Now)';
        var viewResources = {
            Insert_Edit_Block: '@Labels.Insert_Edit_Block',
            Redemption_Log_EmptySubject: '@Labels.Redemption_Log_EmptySubject',
            Redemption_Log_EmptyRemark: '@Labels.Redemption_Log_EmptyRemark',
            Confirm_Ignore_EditRedemption_Changes: '@Html.Raw(Labels.Confirm_Ignore_EditRedemption_Changes)'
    };

        editLogApplication.factory('$redemptionBootstrappedData', function () {
            return {
                redemptionLog: @Html.Raw(jsonLogInfo)
            };
        });
    </script>
</body>
</html>
