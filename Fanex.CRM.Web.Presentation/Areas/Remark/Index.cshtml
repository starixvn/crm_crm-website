@using Newtonsoft.Json;
@using Fanex.CRM.Remark.Models;
@using Fanex.CRM.Remark.Resources;
@model int
@{
    var serverModel = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="remark-application">
<head>
    <title>@Labels.SpecialRemark</title>
    @Styles.Render("~/site/common")
    @Styles.Render("~/Areas/Remark/Styles")
</head>
<body>
    <div class="container main" data-ng-controller="remarkController">
        <div class="row panel-group last">
            <div class="row title group-header" data-ng-click="isShowSpecialRemark = !isShowSpecialRemark">@Labels.SpecialRemark</div>
            <div class="row content" data-ng-show="isShowSpecialRemark">
                <ul class="list-remark col-xs-11 col-sm-11 col-md-11">
                    <li data-ng-repeat="remark in remarks.SpecialRemarks track by $index">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <span>{{$index + 1}}.</span>
                            <input type="text" class="textbox-remark" data-ng-model="remarks.SpecialRemarks[$index]" />
                        </div>
                        <span class="icon-del" data-ng-click="deleteRemark(true, $index)"></span>
                    </li>
                    <li class="last-remark">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <span>{{remarks.SpecialRemarks.length + 1}}.</span>
                            <input type="text" class="textbox-remark" defaulttext="@Labels.SpecialRemarkPlaceHolder"
                                data-ng-model="lastSpecialRemark"
                                on-enter-keyup="insertSpecialRemark" 
                                custom-place-holder/>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
        <div class="row panel-group last remark">
            <div class="row title group-header" data-ng-click="isShowRemark = !isShowRemark">@Labels.Remark</div>
            <div class="row content" data-ng-show="isShowRemark">
                <ul class="list-remark col-xs-11 col-sm-11 col-md-11">
                    <li data-ng-repeat="remark in remarks.NormalRemarks track by $index">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <span>{{$index + 1}}.</span>
                            <input type="text" class="textbox-remark" data-ng-model="remarks.NormalRemarks[$index]" />
                        </div>
                        <span class="icon-del" data-ng-click="deleteRemark(false, $index)"></span>
                    </li>
                    <li class="last-remark">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <span>{{remarks.NormalRemarks.length + 1}}.</span>
                            <input type="text" class="textbox-remark" defaulttext="@Labels.RemarkPlaceHolder"
                                data-ng-model="lastRemark"
                                on-enter-keyup="insertRemark"
                                custom-place-holder/>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
        <div class="row">
            <button class="btn btn-save"
                data-ng-disabled="!compareOldNewValues()"
                data-ng-click="updateRemarks()"><span class="hotkey">S</span>ave</button>
        </div>
    </div>

    @Scripts.Render("~/Scripts/CommomScripts")  
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    @Scripts.Render("~/Areas/Remark/RemarkScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var customerId = '@serverModel';
        var remarkResources = {
            Alert: '@Labels.Alert',
            OK: '@Labels.OK',
            UpdateRemarkSuccess: '@Labels.UpdateRemarkSuccess',
            Confirm_Ignore_EditCustomer_ChangesTabDetail: '@Html.Raw(Resources.Language.Confirm_Ignore_EditCustomer_ChangesTabDetail)'
        };
    </script>
</body>
</html>