@using Newtonsoft.Json;
@using Fanex.CRM.Remark.Models;
@using Fanex.CRM.Remark.Resources;
@model int
@{
    var serverModel = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="remark-application">
<head>
    <title>@Resources.Language.Title_SpecialRemarkTab</title>
    @Styles.Render("~/site/common", "~/Areas/Remark/RemarkStyles")
</head>
<body>
    <div class="container main" data-ng-controller="remarkController">
        <div alert-box-container></div>
        <div class="row panel-group last">
            <div class="row title group-header" data-ng-click="isShowSpecialRemark = !isShowSpecialRemark"
                data-ng-class="isShowSpecialRemark ? '' : 'border-bottom-none'">@Labels.SpecialRemark</div>
            <div class="row content" data-ng-show="isShowSpecialRemark">
                <ul class="list-remark col-xs-11 col-sm-11 col-md-11">
                    <li data-ng-repeat="remark in remarks.SpecialRemarks track by $index">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <span data-ng-bind="$index + 1 + '. '"></span>
                            <textarea class="textarea-remark" rows="4" data-ng-model="remarks.SpecialRemarks[$index]">
                            </textarea>
                        </div>
                        <span class="icon-del" data-ng-click="deleteRemark(true, $index)"></span>
                    </li>
                    <li class="last-remark">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <span data-ng-bind="remarks.SpecialRemarks.length + 1 + '. '"></span>
                            <textarea class="textarea-remark" rows="4"
                                defaulttext="@Labels.SpecialRemarkPlaceHolder"
                                data-ng-model="lastSpecialRemark"
                                on-enter-keyup="insertSpecialRemark()" 
                                custom-place-holder>
                            </textarea>
                        </div>
                        <span class="icon-add" data-ng-click="insertSpecialRemark();"></span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="row panel-group last remark">
            <div class="row title group-header" data-ng-click="isShowRemark = !isShowRemark"
                data-ng-class="isShowRemark ? '' : 'border-bottom-none'">@Labels.Remark</div>
            <div class="row content" data-ng-show="isShowRemark">
                <ul class="list-remark col-xs-11 col-sm-11 col-md-11">
                    <li data-ng-repeat="remark in remarks.NormalRemarks track by $index">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <span data-ng-bind="$index + 1 + '. '"></span>
                            <textarea class="textarea-remark" rows="4" data-ng-model="remarks.NormalRemarks[$index]" />
                            </textarea>
                        </div>
                        <span class="icon-del" data-ng-click="deleteRemark(false, $index)"></span>
                    </li>
                    <li class="last-remark">
                        <div class="col-xs-11 col-sm-11 col-md-11">
                            <span data-ng-bind="remarks.NormalRemarks.length + 1 + '. '"></span>
                            <textarea class="textarea-remark" rows="4"
                                defaulttext="@Labels.RemarkPlaceHolder"
                                data-ng-model="lastRemark"
                                on-enter-keyup="insertRemark()"
                                custom-place-holder>
                            </textarea>
                        </div>
                        <span class="icon-add" data-ng-click="insertRemark();"></span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="row">
            <button class="btn btn-save" data-ng-click="updateRemarks()">
                <span class="hotkey">S</span>ave</button>
        </div>
        <input type="text" class="textbox default-focus-element"
            default-focus data-ng-model="isSetFocus" />
    </div>

    @Scripts.Render("~/Scripts/CommomScripts")  
    @Scripts.Render("~/Scripts/AngularJSLibrary")
    @Scripts.Render("~/Areas/Remark/RemarkScripts")
    <script type="text/javascript">
        parent.document.title = document.title;
        window.rootUrl = '@Url.Content("~")';
        var customerId = '@serverModel';
        var remarkResources = {
            Alert: '@Labels.Alert',
            OK: '@Labels.OK',
            UpdateRemarkSuccess: '@Labels.UpdateRemarkSuccess',
            Confirm_Ignore_EditCustomer_ChangesTabRemark: '@Html.Raw(Labels.ConfirmIgnoreDataChange)'
        };
    </script>
</body>
</html>