@using Newtonsoft.Json;
@using Fanex.CRM.Remark.Models;
@using Fanex.CRM.Remark.Resources;
@model int
@{
    var serverModel = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="remark-application">
<head>
    <title>@Resources.Language.Title_SpecialRemarkTab</title>
    @RazorHelper.RenderStyles("~/site/common")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.css")
    @RazorHelper.RenderStyles("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu.css")
    @RazorHelper.RenderStyles("~/Areas/Remark/RemarkStyles")
</head>
<body>
    <div class="container main" data-ng-controller="remarkController">
        <div alert-box-container></div>
        <div class="row panel-group last">
            <div class="row title group-header" data-ng-click="isShowSpecialRemark = !isShowSpecialRemark"
                data-ng-class="isShowSpecialRemark ? '' : 'border-bottom-none'">@Labels.SpecialRemark</div>
            <div class="row content" data-ng-show="isShowSpecialRemark">
                <ul class="list-remark col-xs-11 col-sm-11 col-md-11">
                    <li data-ng-repeat="remark in remarks.SpecialRemarks track by $index">
                        <div class="col-xs-11 col-sm-11 col-md-11 remark-editor-directive" data-isspecialremark="1"
                            data-remarkindex="{{$index}}">
                            <span class="number" data-ng-bind="$index + 1 + '. '"></span>
                            <div class="textarea-remark raw-html-directive" rows="4" data-ng-model="remarks.SpecialRemarks[$index]">
                            </div>
                        </div>
                        <span class="icon-del" data-ng-click="deleteRemark(true, $index)"></span></li>
                    <li class="last-remark">
                        <div class="col-xs-11 col-sm-11 col-md-11 remark-editor-directive" data-isspecialremark="1"
                            data-remarkindex="{{remarks.SpecialRemarks.length}}">
                            <span class="number" data-ng-bind="remarks.SpecialRemarks.length + 1 + '. '"></span>
                            <div class="textarea-remark" rows="4">@Labels.SpecialRemarkPlaceHolder
                            </div>
                        </div>
                        <span class="icon-add" data-ng-click="insertSpecialRemark();"></span></li>
                </ul>
            </div>
        </div>
        <div class="row panel-group last remark">
            <div class="row title group-header" data-ng-click="isShowRemark = !isShowRemark"
                data-ng-class="isShowRemark ? '' : 'border-bottom-none'">@Labels.Remark</div>
            <div class="row content" data-ng-show="isShowRemark">
                <ul class="list-remark col-xs-11 col-sm-11 col-md-11">
                    <li data-ng-repeat="remark in remarks.NormalRemarks track by $index">
                        <div class="col-xs-11 col-sm-11 col-md-11 remark-editor-directive" data-isspecialremark="0"
                            data-remarkindex="{{$index}}">
                            <span class="number" data-ng-bind="$index + 1 + '. '"></span>
                            <div class="textarea-remark raw-html-directive" rows="4" data-ng-model="remarks.NormalRemarks[$index]">
                            </div>
                        </div>
                        <span class="icon-del" data-ng-click="deleteRemark(false, $index)"></span>
                    </li>
                    <li class="last-remark">
                        <div class="col-xs-11 col-sm-11 col-md-11 remark-editor-directive" data-isspecialremark="0"
                            data-remarkindex="{{remarks.NormalRemarks.length}}">
                            <span class="number" data-ng-bind="remarks.NormalRemarks.length + 1 + '. '"></span>
                            <div class="textarea-remark" rows="4">@Labels.RemarkPlaceHolder>
                            </div>
                        </div>
                        <span class="icon-add" data-ng-click="insertRemark();"></span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="row">
            <button class="btn btn-save" data-ng-click="updateRemarks()">
                <span class="hotkey">S</span>ave</button>
        </div>
    </div>
    <input type="text" class="textbox default-focus-element" default-focus data-ng-model="isSetFocus" />
    @RazorHelper.RenderScripts("~/Scripts/CommomScripts", "~/Scripts/AngularJSLibrary", "~/Areas/Remark/RemarkScripts")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea-0.7.0.js")
    @RazorHelper.RenderScripts("~/Scripts/jHtmlArea/jHtmlArea.ColorPickerMenu-0.7.0.js")
    @RazorHelper.RenderScripts("~/Areas/Remark/Scripts/RemarkApplication.js")
    @RazorHelper.RenderScripts("~/Areas/Remark/Scripts/RemarkService.js")
    @RazorHelper.RenderScripts("~/Areas/Remark/Scripts/RemarkController.js")
    @RazorHelper.RenderScripts("~/Areas/Remark/Scripts/Directives/DefaultFocus.js")
    @RazorHelper.RenderScripts("~/Areas/Remark/Scripts/Directives/RemarkEditorDirective.js")
    @RazorHelper.RenderScripts("~/Areas/Remark/Scripts/Directives/RichRemarkEditorDirective.js")
    @RazorHelper.RenderScripts("~/Areas/Remark/Scripts/Directives/RegisterSharedDirectives.js")

    <script type="text/javascript">
        parent.document.title = document.title;
        window.rootUrl = '@Url.Content("~")';
        var customerId = '@serverModel';
        var remarkResources = {
            Alert: '@Labels.Alert',
            OK: '@Labels.OK',
            UpdateRemarkSuccess: '@Labels.UpdateRemarkSuccess',
            Confirm_Ignore_EditCustomer_ChangesTabRemark: '@Html.Raw(Labels.ConfirmIgnoreDataChange)',
            RemarkPlaceHolder: '@Labels.RemarkPlaceHolder'
        };
    </script>
</body>
</html>
