@using Fanex.CRM.Customer.Resources;
@using Fanex.CRM.Customer.Models;
@using Newtonsoft.Json;
@using Fanex.CRM.Infrastructure.Extensions;
@using Fanex.CRM.Common.Helpers;
@using Fanex.NAP.Core.Business;
@model CustomerInfo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = Resources.Language.Title_DetailTab;

    var jsonCustomerDetail = JsonConvert.SerializeObject(Model);
    var customerInfoPolicy = (Constant.Policy)ViewBag.CustomerInfoPolicy;
    var updateHeadlineInfoPolicy = (Constant.Policy)ViewBag.UpdateHeadlineInfoPolicy;
    var canEditHeadline = (updateHeadlineInfoPolicy == Constant.Policy.Host);
    var isCN88 = (ViewBag.UserRole == Fanex.CRM.Common.Enumerations.UserRole.CN88Staff);
    var hideLicenseeTypeClass = isCN88 ? "hide-item" : "";
    var hideProvinceClass = isCN88 ? "" : "hide-item";
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/Directives/selectwithsearch/selectwithsearch.css")
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
}
<div data-ng-app="customerdetail-application">
    <div class="main container" data-ng-controller="customerDetailController">
        <div class="row panel-group">
            <div class="row title group-header" data-ng-class="isShowPersonalInfo ? '' : 'border-bottom-none'"
                 data-ng-click="isShowPersonalInfo = !isShowPersonalInfo">@Labels.Personal_Info</div>
                <div class="row content" data-ng-show="isShowPersonalInfo">
                    <div class="col-md-4">
                        <div class="row item">
                            <div class="col-md-3">
                                <label for="customerinfodetail-titleoptions">
                                    @Labels.Title
                                </label>
                            </div>
                            <div class="col-md-9" data-ng-model="titleList" dropdown-title-container>
                                <select id="customerinfodetail-titleoptions" tabindex="1" default-focus data-ng-issetfocus="isSetFocus"></select>
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-md-3">
                                <label for="birthday">
                                    @Labels.Birthday
                                </label>
                            </div>
                            <div class="col-md-9" date-picker-container>
                                <input id="birthday" type="text" class="textbox timepicker txtcalendar" tabindex="4" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-md-3">
                                <label for="language">
                                    @Labels.Language
                                </label>
                            </div>
                            <div class="col-md-9" dropdown-language data-ng-model="languageList">
                                <select id="customerinfodetail-languageoptions" tabindex="7"></select>
                            </div>
                        </div>
                        <div class="row item @hideLicenseeTypeClass">
                            <div class="col-md-3">
                                <label for="customerinfodetail-licenseeTypeoptions">
                                    @Labels.LicenseeType
                                </label>
                            </div>
                            <div class="col-md-9">
                                <select id="customerinfodetail-licenseeTypeoptions" tabindex="10" data-ng-model="customerDetail.LicenseeType"
                                        data-ng-options="s.Name for s in licenseeTypes track by s.Id"></select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row item">
                            <div class="col-md-3">
                                <label for="firstName">
                                    @Labels.First_Name
                                </label>
                            </div>
                            <div class="col-md-9">
                                <input type="text" class="textbox" id="firstName" data-ng-model="customerDetail.FirstName"
                                       tabindex="2" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-md-3">
                                <label for="passport">
                                    @Labels.Passport_Number
                                </label>
                            </div>
                            <div class="col-md-9">
                                <input type="text" class="textbox" id="passport" data-ng-model="customerDetail.Passport.Name"
                                       tabindex="5" />
                            </div>
                        </div>
                        <div class="row item">
                            <div class="col-md-3">
                                <label for="customerinfodetail-siteoptions">
                                    @Labels.Site
                                </label>
                            </div>
