                                        <input type="text" class="textbox" id="email" data-ng-model="customerDetail.Email"
                                               tabindex="39" />
                                    </div>
                                </div>
                                <div class="row item">
                                    <div class="col-md-3">
                                        <label for="whatsapp">
                                            @Labels.WhatsApp
                                        </label>
                                    </div>
                                    <div class="col-md-9">
                                        <input type="text" class="textbox" id="whatsapp" data-ng-model="customerDetail.WhatsApp"
                                               tabindex="42" />
                                    </div>
                                </div>
                                <div class="row item">
                                    <div class="col-md-3">
                                        <label for="qq">
                                            @Labels.QQ
