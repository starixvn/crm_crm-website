                                                      data-settings="siteDropdownSettings"
                                                      hide-NA="isCN88"></selectwithsearchtree>
                            </div>
                        </div>                      
                                                                  
                    </div>
                    <div class="col-md-4">
                        <div class="row item">
                            <div class="col-md-3">
                                <label for="lastName">
                                    @Labels.Last_Name
                                </label>
                            </div>
                            <div class="col-md-9">
                                <input type="text" class="textbox" id="lastName" data-ng-model="customerDetail.LastName"
                                       tabindex="3" />
                            </div>
                        </div>
