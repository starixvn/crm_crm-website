@using Fanex.CRM.Customer.Resources;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="customer-application">
<head>
    <title>@Labels.Customer_Info </title>
    <link rel="stylesheet" type="text/css" href="~/Content/site/ui-darkness/jquery-ui-1.8.14.custom.css" />
    @Styles.Render("~/Areas/CustomerInfo/Styles")
    <link href="@Url.Content("~/Content/site/customizeJqueryUI.less?ver=1")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div id="errmsg">
    </div>
    <div id="divContent" class="container left-container customerinfo-container display-none"
        data-ng-controller="customerController">
        <div class="customer-uplineinfo-container" data-ng-repeat="uplineInfo in customer.UplineInfo">
            <div class="row item">
                <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                    {{ uplineInfo.Role.Name }}</div>
                <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                    <a data-ng-href="#" data-ng-click="searchUplineInfo(uplineInfo.Name)">{{ uplineInfo.Name
                        }}</a></div>
                <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                    {{ uplineInfo.Status }}
                </div>
            </div>
        </div>
        <div class="row item current">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                {{ customer.Role.Name }}</div>
            <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                {{ customer.Name }}</div>
            <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                {{ customer.Status }}</div>
        </div>
        <div class="row item" data-ng-show="customer.Role.Id == 1 || 
            customer.Role.Id == 7000 || 
            customer.Role.Id == 2 || 
            customer.Role.Id == 7001">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                @Labels.Danger</div>
            <div class="col-xs-8 col-sm-8 col-md-8">
                <div class="row">
                    <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                        @Labels.Orginal</div>
                    <div class="col-xs-3 col-sm-3 col-md-3 text-left">
                        @Labels.ABT</div>
                    <div class="col-xs-5 col-sm-5 col-md-5 text-left">
                        @Labels.Other_sports</div>
                </div>
                <div class="row">
                    <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                        <span class="lv{{ customer.OriginalDangerLevel }}">@Labels.Lvl {{ customer.OriginalDangerLevel
                            }}</span></div>
                    <div class="col-xs-3 col-sm-3 col-md-3 text-left">
                        <span class="lv{{ customer.ABTDangerLevel }}">@Labels.Lvl {{ customer.ABTDangerLevel
                            }}</span></div>
                    <div class="col-xs-5 col-sm-5 col-md-5 text-left">
                        <span class="lv{{ customer.OtherSportsDangerLevel }}">@Labels.Lvl {{ customer.OtherSportsDangerLevel
                            }}</span></div>
                </div>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.Site</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <select>
                    <option value="0">None</option>
                    <option value="0">IBC Bet</option>
                    <option value="0">ABC Bet</option>
                </select>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.Country</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <select>
                    <option value="0">None</option>
                    <option value="0">Malaysia</option>
                    <option value="0">VietNam</option>
                </select>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.First_Name</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <input type="text" class="textbox" value="{{ customer.FirstName }}" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.Last_Name</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <input type="text" class="textbox" value="{{ customer.LastName }}" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.Nick_Name</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <span class="text">{{ customer.NickName }}</span>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.Language</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <select>
                    <option value="0">None</option>
                    <option value="0">Mandarin/English</option>
                    <option value="0">Mandarin/English</option>
                </select>
            </div>
        </div>
        <div class="row item title text-left">
            @Labels.Communication_Tool
        </div>
        <div class="customer-phoneinfo-container" data-ng-repeat="phoneInfo in customer.PhoneInfo">
            <div class="row item no-border-bg">
                <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                    @Labels.Phone {{ $index + 1 }}</div>
                <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                    <input type="text" class="textbox code-country" value="{{ phoneInfo.CountryCode }}" />
                    <input type="text" class="textbox code-area" value="{{ phoneInfo.AreaCode }}" />
                    <input type="text" class="textbox phone" value="{{ phoneInfo.PhoneNumber }}" />
                </div>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.Mobile</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <input type="text" class="textbox code-country label-left" value="{{ customer.Mobile.CountryCode }}" />
                <input type="text" class="textbox code-area" value="{{ customer.Mobile.AreaCode }}" />
                <input type="text" class="textbox phone" value="{{ customer.Mobile.PhoneNumber }}" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.Email</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <input type="text" class="textbox" value="{{ customer.Email }}" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.MSN</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <input type="text" class="textbox" value="{{ customer.MSN }}" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                @Labels.Skype</div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <input type="text" class="textbox" value="{{ customer.Skype }}" />
            </div>
        </div>
        <div class="customer-personalInfoContact-container" data-ng-repeat="personalInfoContact in customer.PersonalInfoContact">
            <div class="row item no-border-bg">
                <div class="col-xs-4 col-sm-4 col-md-4 text-left label-left">
                    @Labels.PIC {{ $index + 1 }}</div>
                <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                    <input type="text" class="textbox" value="{{ personalInfoContact }}" />
                </div>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-4 col-sm-4 col-md-4 text-left">
            </div>
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <button class="btn pull-left btn-update">
                    <span class="hotkey">U</span>pdate</button>
            </div>
        </div>
        <div class="row item title text-left">
            @Labels.Detail
        </div>
        <div class="row item no-border-bg">
            <ul class="list-unstyled list-menu pull-left">
                <li><a data-ng-href="#" data-ng-click="viewCRMInfo();">
                    @Labels.CRM_Info</a></li>
                <li><a data-ng-href="#" data-ng-click="addFeedback();">
                    @Labels.Add_Feedback</a></li>
            </ul>
            <ul class="list-unstyled list-menu pull-left no-margin">
                <li><a data-ng-href="#" data-ng-click="viewLatestFeedback();">
                    @Labels.Latest_Feedback</a></li>
                <li><a data-ng-href="#" data-ng-click="manageFeedback();">
                    @Labels.Manage_Feedback</a></li>
            </ul>
        </div>
    </div>
    <div id="divPopup" class="selector display-none">@Labels.GetCustomerInfo_ConfirmSearchByGuest
    </div>
    <iframe height="0" frameborder="0" width="0" name="frmUpdate" id="frmUpdate"></iframe>
    @Scripts.Render("~/Scripts/CommomScripts")
    <script type="text/javascript" src="~/Scripts/jquery.json-1.3.js"></script>
    <script type="text/javascript" src="~/Scripts/jscookies.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.tmpl.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery-ui-1.8.14.custom.min.js"></script>
    <script type="text/javascript" src="~/Scripts/common.js"></script>
    <script type="text/javascript" src="~/Scripts/showhidepopup.js"></script>
    @Scripts.Render("~/Scripts/AgularJS")
    @Scripts.Render("~/Areas/CustomerInfo/Scripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var accId = @Fanex.CRM.Infrastructure.Common.AppSession.CurrentUser.Id;
    </script>
</body>
</html>
