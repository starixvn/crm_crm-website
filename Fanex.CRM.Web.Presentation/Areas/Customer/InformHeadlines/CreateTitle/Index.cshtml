@using Fanex.CRM.Customer.Resources;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    @RazorHelper.RenderStyles("~/Areas/Customer/InformHeadlines/CreateTitleStyle")
}
<div data-ng-app="customer-informheadline-create">
    <div class="main popup container" data-ng-controller="createInformHeadlineTitleController">
        <div class="row" alert-box-container>
        </div>
        <form name="frmNewInform" data-ng-submit="createTitle()" novalidate>
        <div class="row form-group">
            <div class="row row-item">
                <input id="title" name="title" type="text" class="textbox" maxlength="200" data-ng-model="title"
                    required />
            </div>
        </div>
        <div class="row">
            <button class="btn btn-save">
                <span class="hotkey">S</span>ave</button>
        </div>
        </form>
    </div>
</div>
@section Scripts {
    @RazorHelper.RenderScripts("~/Areas/Customer/InformHeadlines/CreateTitleScript")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var createInformResource = {
            InformHeadline_TitleEmpty: '@Labels.InformHeadline_TitleEmpty'
        };
        $('#title').focus();
    </script>
}