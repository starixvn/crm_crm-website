@using Fanex.CRM.Customer.Resources;
@{
    bool canCreateTitle = (bool)ViewBag.CanCreateTitle;
    int canUpdateStatus = (bool)ViewBag.CanUpdateStatus ? 1 : 0;
}

<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="customer-informheadline-statistic">
<head>
    <title></title>
    @Styles.Render("~/site/common",
        "~/Areas/Customer/InformHeadlines/InformStatisticStyle")
</head>
<body>
    <div class="container main" data-ng-controller="informHeadlineStatisticController">
        <div class="row" alert-box alert-result="alertResult"></div>
        <div class="row" data-ng-model="statistic" table-inform-statistic-container>
            <div id="table-inform-statistic" class="freegrid display-none">
            </div>
        </div>
        @if (canCreateTitle)
        {
            <div class="row">
                <button class="btn btn-save" data-ng-click="openCreateTitle()">N<span class="hotkey">e</span>w Case</button>
            </div>
        }
        <div class="row download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
        <input type="text" class="textbox default-focus default-focus-element" data-ng-model="defaultFocusOptions.IsSetFocus" />
    </div>

    @Scripts.Render("~/Scripts/CommomScripts",
        "~/Scripts/AngularJSLibrary",
        "~/Scripts/FanexGridV2/NumeralScripts",
        "~/Scripts/FanexGridScripts",
        "~/Scripts/PopUp",
        "~/CRM/DownLoadFile/Scripts",
        "~/Areas/Customer/InformHeadlines/InformStatisticScript")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var canUpdateStatus = @canUpdateStatus;
        var informStatisticResourceView = {
            Title: '@Labels.Title',
            NoOfHeadlines: '@Labels.NoOfHeadlines',
            CreatedTime: '@Labels.CreatedTime',
            Done: '@Labels.Done',
            RequestCallback: '@Labels.RequestCallback',
            NoNeedToCall: '@Labels.NoNeedToCall',
            NoReply: '@Labels.NoReply',
            Uncontactable: '@Labels.Uncontactable',
            InternalAccount: '@Labels.InternalAccount',
            NeverTouch: '@Labels.NeverTouch',
            CreateTitleSuccess: '@Labels.CreateTitleSuccess',
            UpdateInformsSuccess: '@Labels.UpdateInformsSuccess',
            NewCase: '@Labels.NewCase',
            NewInformHeadlines: '@Labels.NewInformHeadlines',
            Confirm_Ignore_UpdateInforms_Changes: '@Html.Raw(Labels.Confirm_Ignore_UpdateInforms_Changes)'
        }; 
    </script>
</body>
</html>
