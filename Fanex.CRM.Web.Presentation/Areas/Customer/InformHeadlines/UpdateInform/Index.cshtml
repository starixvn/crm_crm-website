@using Fanex.CRM.Customer.Resources;
@{
    bool canUpdateTitle = (bool)ViewBag.CanUpdateTitle;
    bool canUpdateStatus = (bool)ViewBag.CanUpdateStatus;
}
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="customer-informheadline-update">
<head>
    <title></title>
    @Styles.Render("~/site/common",
        "~/Styles/FanexMultipleSelect",
        "~/Areas/Customer/InformHeadlines/UpdateInformStyle")
</head>
<body>
    <div class="main popup container" data-ng-controller="updateInformHeadlineController">
        <div class="row" alert-box-container>
        </div>
        <div class="row filter-frm inform-filter">
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="row row-item">
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <label class="filter-lbl" for="username">@Labels.Username</label>
                    </div>
                    <div class="col-xs-9 col-sm-9 col-md-9">
                        <input type="text" class="textbox" id="username" tabindex="2" data-ng-model="username" />
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="row">
                    <div class="col-xs-3 col-sm-3 col-md-3">
                        <label class="filter-lbl" for="status">@Labels.Status</label>
                    </div>
                    <div class="col-xs-9 col-sm-9 col-md-9">
                        <div class="select-multi" status-multi-container data-ng-model="statusOptions.DataList">
                            <select tabindex="6" id="status">
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="row row-item">
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <label class="filter-lbl" for="position">@Labels.Position</label>
                    </div>
                    <div class="col-xs-8 col-sm-8 col-md-8">
                        <div class="select-multi" position-multi-container data-ng-model="positionOptions.DataList">
                            <select tabindex="3" id="position">
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="row">
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <label class="filter-lbl" for="currency">@Labels.Currency</label>
                    </div>
                    <div class="col-xs-8 col-sm-8 col-md-8">
                        <div class="select-multi" currency-multi-container data-ng-model="currencyOptions.DataList">
                            <select tabindex="7" id="currency">
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="row row-item">
                    <div class="col-xs-2 col-sm-2 col-md-2">
                        <label class="filter-lbl" for="site">@Labels.Site</label>
                    </div>
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        <div site-multi-container data-ng-model="siteOptions.DataList">
                            <select tabindex="4" id="site">
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <button type="button" class="btn pull-right" data-ng-click="searchInform()">
                                S<span class="hotkey">e</span>arch</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row filter-frm inform-filter title-filter">
            <div class="row row-item">
                <div class="col-xs-5 col-sm-5 col-md-5">
                    <div class="width-15">
                        <label class="filter-lbl" for="ddltitle">@Labels.Title</label>
                    </div>
                    <div class="width-85">
                        <input id="title" type="text" class="textbox title" tabindex="1" @(canUpdateTitle ? "" : "disabled") data-ng-model="title"/>
                    </div>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        <label class="filter-lbl" for="noHeadlinesToInform">@Labels.NoHeadlinesToInform</label>
                    </div>
                    <div class="col-xs-5 col-sm-5 col-md-5">
                        <input id="noHeadlinesToInform" type="text" class="textbox" number-only-input  tabindex="5" data-ng-model="NoHeadlinesToInform" />
                    </div>
                    <div class="col-xs-1 col-sm-1 col-md-1">
                        <input id="btn-excel" class="btnExcel" type="button" title="@Labels.ExportToExcel" data-ng-click="exportInformsExcel()" />
                    </div>
                </div>
                <div class="col-xs-4 col-sm-4 col-md-4">
                </div>
            </div>
        </div>
        <div class="row">
            <div data-ng-model="informs" table-inform-headline-container>
                <div id="table-inform-headline" class="freegrid display-none">
                </div>
            </div>
        </div>
        <div class="row download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
        @if (canUpdateStatus)
        {
            <div class="row">
                <button type="button" class="btn btn-save" data-ng-click="updateInforms()">
                    <span class="hotkey">S</span>ave</button>
            </div>
        }
    </div>
    @Scripts.Render("~/Scripts/CommomScripts",
        "~/Scripts/FanexGridScripts",
        "~/Scripts/AngularJSLibrary",
        "~/CRM/DownLoadFile/Scripts",
        "~/Areas/Customer/InformHeadlines/UpdateInformScript")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var titleId = @ViewBag.TitleId;
        var updateInformResources = {
            Headline: '@Labels.Headline',
            Status: '@Labels.Status',
            UpdatedTime: '@Labels.UpdatedTime',
            Remark: '@Labels.Remark',
            Handler: '@Labels.Handler',
            Extension: '@Labels.Extension',
            ProductStatus: '@Labels.ProductStatus',
            AllStatus: '@Labels.AllStatus',
            Symbol_NotApply: '@Labels.Symbol_NotApply',
            No_status_found: '@Labels.No_status_found',
            UpdateInformsSuccess: '@Labels.UpdateInformsSuccess',
            Confirm_Ignore_UpdateInforms_Changes: '@Html.Raw(Labels.Confirm_Ignore_UpdateInforms_Changes)',
            UpdateInforms_TitleEmpty: '@Labels.UpdateInforms_TitleEmpty',
            InformHeadline_NoStatusFound: '@Labels.InformHeadline_NoStatusFound',
            InformHeadline_NoDataChanged: '@Labels.InformHeadline_NoDataChanged',
            Confirm_Export_InformStatus: '@Html.Raw(Labels.Confirm_Export_InformStatus)'
        };
    </script>
</body>
</html>