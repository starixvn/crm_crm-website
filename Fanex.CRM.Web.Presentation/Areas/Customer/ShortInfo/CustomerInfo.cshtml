@using Fanex.CRM.Customer.Resources;
@using Fanex.CRM.Setting.Constants;
<!DOCTYPE>
<html xmlns="http://www.w3.org/1999/xhtml" data-ng-app="customer-application">
<head>
    <title>@Labels.Customer_Info </title>
    @Styles.Render("~/site/common")
    @Styles.Render("~/Areas/ShortCustomerInfo/Styles")
    @Styles.Render("~/Styles/MultipleSelect")
</head>
<body>
    <div id="divContent" class="container left-container customerinfo-container display-none"
        data-ng-controller="customerController">
        <div class="customer-uplineinfo-container" data-ng-repeat="uplineInfo in customer.UplineInfo">
            <div class="row item">
                <div class="col-xs-3 col-sm-3 col-md-3 text-left">
                    {{ uplineInfo.Role.Name }}</div>
                <div class="col-xs-6 col-sm-6 col-md-6 text-left username">
                    <a data-ng-href="#" data-ng-click="searchUplineInfo(uplineInfo.Name)">{{ uplineInfo.Name
                        }}</a></div>
                <div class="col-xs-3 col-sm-3 col-md-3 text-right status">
                    {{ uplineInfo.Status }}
                </div>
            </div>
        </div>
        <div class="row item current">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left">
                {{ customer.Role.Name }}</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-lef username">
                {{ customer.Name }}</div>
            <div class="col-xs-3 col-sm-3 col-md-3 text-right status">
                {{ customer.Status }}</div>
        </div>
        <div class="row item" data-ng-show="customer.Role.Id == @RoleIdConstants.Member || 
            customer.Role.Id == @RoleIdConstants.CRMMember">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left">
                @Labels.Danger</div>
            <div class="col-xs-9 col-sm-9 col-md-9">
                <div class="row">
                    <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                        @Labels.Orginal</div>
                    <div class="col-xs-3 col-sm-3 col-md-3 text-left">
                        @Labels.ABT</div>
                    <div class="col-xs-5 col-sm-5 col-md-5 text-left">
                        @Labels.Other_sports</div>
                </div>
                <div class="row">
                    <div class="col-xs-4 col-sm-4 col-md-4 text-left">
                        <span class="lv{{ customer.OriginalDangerLevel }}">{{ customer.OriginalDangerLevel !=
                            0 ? ('@Labels.Lvl ' + customer.ABTDangerLevel) : '@Labels.None' }}</span></div>
                    <div class="col-xs-3 col-sm-3 col-md-3 text-left">
                        <span class="lv{{ customer.ABTDangerLevel }}">{{ customer.ABTDangerLevel != 0 ? ('@Labels.Lvl
                            ' + customer.ABTDangerLevel) : '@Labels.None' }}</span></div>
                    <div class="col-xs-5 col-sm-5 col-md-5 text-left">
                        <span class="lv{{ customer.OtherSportsDangerLevel }}">{{ customer.OtherSportsDangerLevel
                            != 0 ? ('@Labels.Lvl ' + customer.ABTDangerLevel) : '@Labels.None' }}</span></div>
                </div>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.Site</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <select id="customerinfo-siteoptions">
                </select>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.Country</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <select id="customerinfo-countryoptions">
                </select>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.First_Name</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <input type="text" class="textbox" data-ng-model="customer.FirstName" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.Last_Name</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <input type="text" class="textbox" data-ng-model="customer.LastName" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.Nick_Name</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <span class="text">{{ customer.NickName }}</span>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.Language</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <select id="customerinfo-languageoptions">
                </select>
            </div>
        </div>
        <div class="row item title text-left">
            @Labels.Communication_Tool
        </div>
        <div class="customer-phoneinfo-container" data-ng-repeat="phoneInfo in customer.PhoneInfo">
            <div class="row item no-border-bg">
                <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                    @Labels.Phone {{ $index + 1 }}</div>
                <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                    <input type="text" class="textbox code-country" data-ng-model="phoneInfo.CountryCode" />
                    <input type="text" class="textbox code-area" data-ng-model="phoneInfo.AreaCode" />
                    <input type="text" class="textbox phone" data-ng-model="phoneInfo.PhoneNumber" />
                </div>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.Mobile</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <input type="text" class="textbox code-country label-left" data-ng-model="customer.MobilePhone.CountryCode" />
                <input type="text" class="textbox code-area" data-ng-model="customer.MobilePhone.AreaCode" />
                <input type="text" class="textbox phone" data-ng-model="customer.MobilePhone.PhoneNumber" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.Email</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <input type="text" class="textbox" data-ng-model="customer.Email" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.MSN</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <input type="text" class="textbox" data-ng-model="customer.MSN" />
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                @Labels.Skype</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <input type="text" class="textbox" data-ng-model="customer.Skype" />
            </div>
        </div>
        <div class="customer-personalInfoContact-container" data-ng-repeat="personalInfoContact in customer.PersonalInfoContact track by $index">
            <div class="row item no-border-bg">
                <div class="col-xs-3 col-sm-3 col-md-3 text-left label-left">
                    @Labels.PIC {{ $index + 1 }}</div>
                <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                    <input type="text" class="textbox" data-ng-model="customer.PersonalInfoContact[$index]"
                        data-ng-change="editPersonalInfo(this);" />
                </div>
            </div>
        </div>
        <div class="row item no-border-bg">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left">
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-left">
                <button class="btn pull-left btn-update" data-ng-click="updateCustomerInfo();">
                    <span class="hotkey">U</span>pdate</button>
            </div>
        </div>
        <div class="row item title text-left">
            @Labels.Detail
        </div>
        <div class="row item no-border-bg">
            <ul class="list-unstyled list-menu pull-left">
                <li><a data-ng-href="#" data-ng-click="viewCRMInfo();">
                    @Labels.CRM_Info</a></li>
                <li><a data-ng-href="#" data-ng-click="addFeedback();">
                    @Labels.Add_Feedback</a></li>
            </ul>
            <ul class="list-unstyled list-menu pull-left no-margin">
                <li><a data-ng-href="#" data-ng-click="viewLatestFeedback();">
                    @Labels.Latest_Feedback</a></li>
                <li><a data-ng-href="#" data-ng-click="manageFeedback();">
                    @Labels.Manage_Feedback</a></li>
            </ul>
        </div>
    </div>
    @Scripts.Render("~/Scripts/CommomScripts")
    @Scripts.Render("~/Scripts/AgularJS")
    @Scripts.Render("~/Scripts/PopUp")
    @Scripts.Render("~/Scripts/MultipleSelect")
    @Scripts.Render("~/Areas/ShortCustomerInfo/Scripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var accId = @Fanex.CRM.Infrastructure.Common.AppSession.CurrentUser.Id;
    </script>
</body>
</html>
