@using CommonLabels = Fanex.CRM.Common.Resources.Labels;
﻿@using Fanex.CRM.PicAndHeadline.Resources
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.PICManagement;
}

@section Styles{
    @RazorHelper.RenderStyles("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.css")
    @RazorHelper.RenderStyles("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.css")
    @RazorHelper.RenderStyles("~/Content/site/customizeFanexGridV2.less")
    @RazorHelper.RenderStyles("~/Areas/PicAndHeadline/PicManagementStyles")
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
}

<div data-ng-app="picmanagement-application">
    <div class="picManagementController" data-ng-controller="picManagementController">
        <div class="main container">
            <div class="row" data-ng-show="errorMessage !== ''">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="alertboxerr">
                        <div data-ng-bind="errorMessage">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row filter-frm one-row expand-filter">
                <div class="row row-item">
                    <div class="item default-focus" data-ng-model="defaultFocusOptions.IsSetFocus">
                        <label for="username" class="width-70">
                            @Labels.Username
                        </label>
                        <input type="text" class="textbox search-by-enter" id="username" data-ng-model="searchCriteria.Username" />
                    </div>
                    <div class="item">
                        <label for="viptype" class="width-50 pull-left">
                            @Labels.Role
                        </label>
                        <div class="role-picker-container pull-left" data-ng-model="roleOptions.DataList">
                            <select id="role" class="selRole"></select>
                        </div>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item">
                        <button id="button-submit" class="btn" data-ng-click="getReport();">
                            <span>@Labels.Submit</span>
                        </button>
                    </div>
                    <div class="item">
                        <button id="button-submit" class="btn" data-ng-click="inserNew();">
                            <span>@Labels.Insert</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="row">
                <div data-ng-model="reportOptions.IsUpdateGrid" class="table-report-container">
                    <div id="table-report" class="freegrid display-none table-report">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/FanexMultipleSelect")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.js")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.js")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/moment.js")
    @RazorHelper.RenderScripts("~/CRM/DownLoadFile/Scripts")
    @RazorHelper.RenderScripts("~/Areas/PicAndHeadline/PicManagementScripts")
    <script type="text/javascript">
        parent.document.title = '@Resources.Language.Title_Report_CustomerReport';
        window.rootUrl = '@Url.Content("~")';
        
        var viewResources = {     
            ReportTitle: '@Labels.PICManagement',
            Position: '@Labels.Position',
            Status: '@Labels.Status',
            No: '@Labels.No',
            Username: '@Labels.Username',
            Role: '@Labels.Role',
            GroupHeadline: '@Labels.GroupHeadline',
            Contact: '@Labels.Contact',
            Remark: '@Labels.Remark',
            Edit: '@Labels.Edit',
            Active: '@Labels.Active'
        };
    </script>
}