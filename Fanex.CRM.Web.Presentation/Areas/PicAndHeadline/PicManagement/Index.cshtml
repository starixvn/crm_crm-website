﻿@using Fanex.CRM.Resources
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.PICManagement;
    var isHost = (bool)ViewBag.IsHost;
}

@section Styles{
    <link rel="stylesheet" href="~/wwwroot/dist/styles/pic.management.css" />
}

<div data-ng-app="pic-management-application">
    <div class="picManagementController" data-ng-controller="picManagementController">
        <div class="main container">
            <div class="row" data-ng-show="errorMessage !== ''">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div id="alertboxerr">
                        <div data-ng-bind="errorMessage">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row filter-frm one-row expand-filter">
                <div class="row row-item">
                    <div class="item default-focus" data-ng-model="defaultFocusOptions.IsSetFocus">
                        <label for="username" class="width-60">
                            @Labels.Name
                        </label>
                        <input type="text" class="textbox search-by-enter" id="username" data-ng-model="searchCriteria.Username" autocomplete="off" />
                    </div>
                    <div class="item">
                        <label for="username" class="width-100">
                            @Labels.GroupHeadline
                        </label>
                        <input type="text" class="textbox search-by-enter" id="headline-name" data-ng-model="searchCriteria.HeadlineName" autocomplete="off" />
                    </div>
                    <div class="item">
                        <label for="viptype" class="width-30 pull-left">
                            @Labels.Role
                        </label>
                        <multileveldropdowntree class="pull-left"
                                                text-settings="textSettings"
                                                data-settings="roleDropdownSettings"
                                                data-show-selected-all-text="true"
                                                ng-model="selectedRoles"
                                                ng-change="roleChangedHandler()"
                                                ng-on-checkall="roleChangedHandler()" />
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item">
                        <button id="button-submit" class="btn" data-ng-click="getReport();">
                            <span class="hotkey">S</span>ubmit
                        </button>
                    </div>
                    @if (isHost)
                    {
                        <div class="item">
                            <button id="button-submit" class="btn" data-ng-click="insertPic();">
                                <span class="hotkey">I</span>nsert
                            </button>
                        </div>
                    }
                </div>
            </div>
            <div class="row">
                <div data-ng-model="reportOptions.IsUpdateGrid" class="table-report-container">
                    <div id="table-report" class="freegrid display-none table-report">
                    </div>
                </div>
            </div>
            <div class="download-file-container" data-ng-model="downloadFileOptions">
                <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/PicAndHeadline/PicManagement/_Create.cshtml")
@Html.Partial("~/Areas/PicAndHeadline/PicManagement/_Edit.cshtml")
@Html.Partial("~/Areas/PicAndHeadline/PicManagement/_ChangeConfirm.cshtml")
@Html.Partial("~/Areas/PicAndHeadline/PicManagement/_ChangeState.cshtml")
@Html.Partial("~/Areas/PicAndHeadline/PicManagement/_ValidateEditConfirm.cshtml")

@section Scripts {
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.js")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.js")
    @RazorHelper.RenderScripts("~/CRM/DownLoadFile/Scripts")
    @RazorHelper.RenderScripts("~/Areas/PicAndHeadline/PicManagement/ViewList/PicManagementScripts")
    <script src="~/wwwroot/dist/js/pic.management.js"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var isHostOnPICManagement = '@isHost' == 'True';

        var viewResources = {
            ReportTitle: '@Labels.PICManagement',
            Position: '@Labels.Position',
            Status: '@Labels.Status',
            No: '@Labels.No',
            Username: '@Labels.Name',
            PicType: '@Labels.PicType',
            Role: '@Labels.Role',
            GroupHeadline: '@Labels.GroupHeadline',
            Contact: '@Labels.Contact',
            Remark: '@Labels.Remark',
            Edit: '@Labels.Edit',
            Active: '@Labels.Active',
            InsertPIC: '@Labels.InsertPIC',
            CommunicationTool: '@Labels.CommunicationTool',
            Confirmation: '@Labels.Confirmation',
            EditPIC: '@Labels.EditPIC',
            Language: '@Labels.Language',
            Country: '@Labels.Country',
            IsRequired: '@Labels.IsRequired',
            NoData: '@Labels.NoData',
            Search: '@Labels.Search',
            All: '@Labels.All',
            Selected: '@Labels.Select',
            HeadlinePIC: '@Labels.HeadlinePIC'
        };
    </script>
}