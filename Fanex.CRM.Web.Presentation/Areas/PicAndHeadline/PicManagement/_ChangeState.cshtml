@using Fanex.CRM.Resources

<div id="template-pic-change-state" style="display: none">
    <div class="modal-header" movable-modal>
        @Labels.ChangePICState
        <span class="icon-close fa fa-times" ng-click="picChangeStateCtrl.close()"></span>
    </div>
    <div class="modal-body">
        <div class="row" ng-show="picChangeStateCtrl.messageResultOptions.IsShowMessage">
            <div class="alertbox{{ picChangeStateCtrl.messageResultOptions.IsSuccess ? 'scc' : 'err' }}"><div>{{picChangeStateCtrl.messageResultOptions.Message}}</div></div>
        </div>
        <div class="row margin-bottom-16">
            {{picChangeStateCtrl.ComfirmContent}}
        </div>
        <div class="modal-footer">
            <button class="btn" ng-click="picChangeStateCtrl.changeState()" ng-disabled="picChangeStateCtrl.isDiabled">@Labels.OK</button>
            <button class="btn" ng-click="picChangeStateCtrl.close()">@Labels.Cancel</button>
        </div>
    </div>
</div>