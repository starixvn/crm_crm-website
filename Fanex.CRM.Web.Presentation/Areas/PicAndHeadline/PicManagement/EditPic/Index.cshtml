@using Fanex.CRM.Resources
@using Newtonsoft.Json;
@model Fanex.CRM.Criteria.PicAndHeadline.EditPicCriteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var model = JsonConvert.SerializeObject(Model);
}

@section Styles{
    @RazorHelper.RenderStyles("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.css")
    @RazorHelper.RenderStyles("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.css")
    @RazorHelper.RenderStyles("~/Content/site/customizeFanexGridV2.less")
    @RazorHelper.RenderStyles("~/Areas/PicAndHeadline/PicManagement/EditPic/Styles")
    @RazorHelper.RenderStyles("~/Styles/FanexMultipleSelect")
}

<div data-ng-app="editpic-application">
    <div class="editPicController" data-ng-controller="editPicController">
        <div class="main container">
            <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                         class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                        <div data-ng-bind="messageResultOptions.Message">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <form class="form-horizontal frm" role="form">
                    <div class="form-group">
                        <label for="txtSettingName" class="col-xs-3 col-sm-3 col-md-2 control-label">
                            @Labels.Username
                            @Html.Raw(Labels.RequiredFieldTemplate)
                        </label>
                        <div class="col-xs-8 col-sm-8 col-md-9">
                            <input type="text" class="textbox form-control" id="username" data-ng-model="insertParams.Username" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="txtSettingName" class="col-xs-3 col-sm-3 col-md-2 control-label">
                            @Labels.Role
                            @Html.Raw(Labels.RequiredFieldTemplate)
                        </label>
                        <div class="col-xs-8 col-sm-8 col-md-9 role-picker-container pull-left" 
                             select-options="roleOptions" selected-value="insertParams.RoleId"
                             on-change-event="updateSelectedRole(selectedItem)">
                            <select id="role" class="selRole"></select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="txtSettingName" class="col-xs-3 col-sm-3 col-md-2 control-label">
                            @Labels.Remark
                        </label>
                        <div class="col-xs-8 col-sm-8 col-md-9">
                            <textarea type="text" class="textbox form-control" id="remark" data-ng-model="insertParams.Remark"></textarea>
                        </div>
                    </div>
                    <div>
                        <div class="form-group" ng-repeat="x in communicationToolItems">
                            <div class="col-xs-2 col-sm-2 col-md-1 communication-tool-picker-container"
                                 select-options="communicationToolOptions"
                                 on-change-event="updateSelectedCommunicationTool(target, selectedItem)"
                                 target="x"
                                 selected-value="x.Type">
                                <select id="communication-tool" class="selRole"></select>
                                <span ng-if="$index == 0" class="required-span">
                                    @Html.Raw(Labels.RequiredFieldTemplate)
                                </span>
                            </div>
                            <div class="col-xs-1 col-sm-1 col-md-1">

                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-9">
                                <input type="text" class="textbox form-control" id="username" data-ng-model="x.Value" />
                            </div>
                            <div class="col-xs-1 col-sm-1 col-md-1 communication-tools">
                                <span ng-if="$index != 0" title="Remove" class="remove-tool" data-ng-click="removeCommunicationTool(this);">x</span>
                                <span ng-if="$index == (communicationToolItems.length - 1)" title="Add" class="add-tool" data-ng-click="addCommunicationTool();">+</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-xs-offset-3 col-sm-offset-3 col-md-offset-2 col-xs-9 col-sm-9 col-md-10">
                            <button id="button-submit" class="btn" data-ng-click="savePic();">
                                <span>@Labels.Save</span>
                            </button>
                            <button id="button-submit" class="btn" data-ng-click="cancelPic();">
                                <span>@Labels.Cancel</span>
                            </button>
                        </div>

                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RazorHelper.RenderScripts("~/Scripts/FanexMultipleSelect")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Pagination.js")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/Fanex.Grid.js")
    @RazorHelper.RenderScripts("~/wwwroot/sources/libs/FanexGrid/moment.js")
    @RazorHelper.RenderScripts("~/CRM/DownLoadFile/Scripts")
    @RazorHelper.RenderScripts("~/Scripts/ShareScripts/Applications/ResultMessageScripts")
    @RazorHelper.RenderScripts("~/Areas/PicAndHeadline/PicManagement/EditPic/Scripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';

        var viewResources = {
            ReportTitle: '@Labels.PICManagement',
            Position: '@Labels.Position',
            Status: '@Labels.Status',
            No: '@Labels.No',
            Username: '@Labels.Username',
            Role: '@Labels.Role',
            GroupHeadline: '@Labels.GroupHeadline',
            Contact: '@Labels.Contact',
            Remark: '@Labels.Remark',
            Edit: '@Labels.Edit',
            Active: '@Labels.Active',
            InsertPIC: '@Labels.InsertPIC',
            Select: '@Labels.Select',
            IsRequired: '@Labels.IsRequired',
            CommunicationTool: '@Labels.CommunicationTool',
            ConfirmCancel: '@Labels.ConfirmCancel'
        };

        var item = @Html.Raw(model);
    </script>
}