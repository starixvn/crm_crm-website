@using Fanex.CRM.Resources

<div id="template-pic-insert" style="display: none">
    <div class="modal-header">
        @Labels.InsertPIC
        <span class="icon-close fa fa-times" ng-click="picInsertCtrl.close()"></span>
    </div>
    <div class="modal-body">
        <div class="row row-item" ng-show="picInsertCtrl.isShowResultMessage">
            <div class="alertbox{{ picInsertCtrl.isSuccessful ? 'scc' : 'err' }}"><div>{{picInsertCtrl.resultMessage}}</div></div>
        </div>
        <div class="row item">
            <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
                <label>
                    @Labels.Username
                    <span class="mandatoryfield">*</span>
                    <span class="fa fa-question-circle-o"
                          tooltip-placement="bottom-left"
                          uib-tooltip="@Labels.RequiredFieldTemplate" />
                </label>
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9">
                <input class="width100" name="username" autocomplete="off" ng-model="picInsertCtrl.insertParams.Username" />
            </div>
        </div>
        <div class="row item">
            <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
                <label>
                    @Labels.Role
                    <span class="mandatoryfield">*</span>
                    <span class="fa fa-question-circle-o"
                          tooltip-placement="bottom-left"
                          uib-tooltip="@Labels.RequiredFieldTemplate" />
                </label>
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9 role-insert-picker-container pull-left" select-options="picInsertCtrl.roleInsertOptions" on-change-event="picInsertCtrl.updateSelectedRole(selectedItem)">
                <select id="role"></select>
            </div>
        </div>
        <div class="row item">
            <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
                <label>
                    @Labels.Language
                </label>
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9 language-select">
                <multileveldropdowntree text-settings="picInsertCtrl.textSettings"
                                        data-settings="picInsertCtrl.languageDropdownSettings"
                                        data-show-selected-all-text="true"
                                        ng-model="picInsertCtrl.selectedLanguages"
                                        ng-change="picInsertCtrl.languageChangedHandler()"
                                        ng-on-checkall="picInsertCtrl.languageChangedHandler()" />
            </div>
        </div>
        <div class="row item">
            <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
                <label>
                    @Labels.Country
                </label>
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9 country-picker-container pull-left"
                 select-options="picInsertCtrl.countryOptions"
                 on-change-event="picInsertCtrl.updateSelectedCountry(selectedItem)">
                <select id="country"></select>
            </div>
        </div>
        <div class="row item">
            <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
                <label>
                    @Labels.Remark
                </label>
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9">
                <textarea rows="3" type="text" id="remark" ng-model="picInsertCtrl.insertParams.Remark"></textarea>
            </div>
        </div>
        <div class="row item" ng-repeat="x in picInsertCtrl.communicationToolItems">
            <div class="col-xs-3 col-sm-3 col-md-2">
                <div class="communication-tool-picker-container"
                     select-options="picInsertCtrl.communicationToolsInsertOptions"
                     on-change-event="picInsertCtrl.updateSelectedCommunicationTool(target, selectedItem)"
                     target="x">
                    <select id="communication-tool" class="selRole"></select>
                    <span ng-if="$index == 0" class="required-span">
                        @Html.Raw(Labels.RequiredFieldTemplate)
                    </span>
                </div>
            </div>
            <div class="col-xs-1 col-sm-1 col-md-1"></div>
            <div class="col-xs-7 col-sm-7 col-md-8">
                <input type="text" id="username" data-ng-model="x.Value" autocomplete="off" />
            </div>
            <div class="col-xs-1 col-sm-1 col-md-1 communication-tools">
                <span ng-if="$index != 0" title="Remove" class="remove-tool" data-ng-click="picInsertCtrl.removeCommunicationTool(this);">x</span>
                <span ng-if="$index == (picInsertCtrl.communicationToolItems.length - 1)" title="Add" class="add-tool" data-ng-click="picInsertCtrl.addCommunicationTool();">+</span>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn" ng-click="picInsertCtrl.savePic()" ng-disabled="picInsertCtrl.isDiableInsert">
                @Html.Raw(Labels.Save)
            </button>
            <button class="btn" ng-click="picInsertCtrl.close()">@Labels.Cancel</button>
        </div>
    </div>
</div>