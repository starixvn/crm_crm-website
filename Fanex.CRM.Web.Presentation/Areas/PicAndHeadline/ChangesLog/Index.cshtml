@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
﻿@using Fanex.CRM.Resources

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.ChangesLog;
}

@section Styles{
    <link rel="stylesheet" href="~/wwwroot/dist/styles/changes.log.css" />
}

<div id="changes-log-application" ng-app="changes-log-application">
    <div class="changesLogController" ng-controller="changesLogController as changesLogCtrl">
        <div class="main container" focus-me="focused">
            <div class="row" ng-show="isError">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div ng-class="isError ? 'alertboxerr' : ''">
                        <div ng-bind="errorMessage">
                        </div>
                    </div>
                </div>
            </div>

            <div class="row btn-group display-none">
                <button ng-class="changesLogCtrl.isPicReport ? 'btn not-select-btn' : 'btn'" ng-click="changesLogCtrl.changeHeadlineDATab();">@Labels.HeadlineDirectAccount</button>
                <button ng-class="!changesLogCtrl.isPicReport ? 'btn not-select-btn' : 'btn'" ng-click="changesLogCtrl.changePicTab();">@Labels.PIC</button>
            </div>

            <div class="display-none" ng-class="!changesLogCtrl.isPicReport ? 'row display-block' : ''" ng-controller="headlineDAController as headlineDACtrl">
                <form class="filter-form" ng-submit="headlineDACtrl.getReport()">
                    <div class="row filter-frm one-row expand-filter">
                        <div class="row row-item">
                            <div class="item">
                                <label class="width-65">
                                    @Labels.HeadlineDA
                                </label>
                                <input type="text" class="textbox" ng-model="headlineDACtrl.searchCriteria.HeadlineDA" autocomplete="off" />
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.FromDate
                                </label>
                                <div class="display-inline-block date-picker-from-date-container" ng-model="fromDateOptions.IsRerenderPicker">
                                    <input id="fromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                                </div>
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.ToDate
                                </label>
                                <div class="display-inline-block date-picker-to-date-container" ng-model="toDateOptions.IsRerenderPicker">
                                    <input id="toDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                                </div>
                            </div>
                            <div class="item">
                                <label class="pull-left">
                                    @Labels.ActionType
                                </label>
                                <multileveldropdowntree class="pull-left"
                                                        text-settings="headlineDACtrl.textSettings"
                                                        data-settings="headlineDACtrl.actionDropdownSettings"
                                                        data-show-selected-all-text="true"
                                                        ng-model="headlineDACtrl.selectedActions" />
                            </div>
                        </div>
                        <div class="row row-item">
                            <div class="item">
                                <label class="width-65">
                                    @Labels.EditBy
                                </label>
                                <input type="text" class="textbox" ng-model="headlineDACtrl.searchCriteria.EditBy" autocomplete="off" />
                            </div>
                            <div class="item">
                                <button class="btn" type="submit">@Labels.Submit</button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="row">
                    <div ng-model="headlineDAReportOptions.IsUpdateGrid" class="headline-da-table-report-container">
                        <div id="headline-da-table-report" class="freegrid display-none table-report">
                        </div>
                    </div>
                </div>
            </div>

            <div class="display-none" ng-class="changesLogCtrl.isPicReport ? 'row display-block' : ''" ng-controller="picController as picCtrl">
                <form class="filter-form" ng-submit="picCtrl.getReport()">
                    <div class="row filter-frm one-row expand-filter">
                        <div class="row row-item">
                            <div class="item">
                                <label>
                                    @Labels.PIC
                                </label>
                                <input type="text" class="textbox" ng-model="picCtrl.searchCriteria.Pic" autocomplete="off" />
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.FromDate
                                </label>
                                <div class="display-inline-block date-picker-pic-from-date-container" ng-model="picFromDateOptions.IsRerenderPicker">
                                    <input id="picFromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                                </div>
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.ToDate
                                </label>
                                <div class="display-inline-block date-picker-pic-to-date-container" ng-model="picToDateOptions.IsRerenderPicker">
                                    <input id="picToDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                                </div>
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.EditBy
                                </label>
                                <input type="text" class="textbox" ng-model="picCtrl.searchCriteria.EditBy" autocomplete="off" />
                            </div>
                            <div class="item">
                                <button class="btn" type="submit">@Labels.Submit</button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="row">
                    <div ng-model="picReportOptions.IsUpdateGrid" class="pic-table-report-container">
                        <div id="pic-table-report" class="freegrid display-none table-report">
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @RazorHelper.RenderScripts("~/Areas/PicAndHeadline/ChangesLogScripts")
    @RazorHelper.RenderScripts("~/Scripts/FanexGridScripts")
    <script src="~/Scripts/jquery-ui-1.8.14.custom.js"></script>
    <script src="~/wwwroot/dist/js/changes.log.js"></script>
    <script type="text/javascript">
        parent.document.title = '@Labels.ChangesLog';
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()';
        var minReportDate = new Date('@AppSetting.MinReportDate.ToShortFormatedDate()');
        var logActions = null;

        var viewResources = {
            ReportTitle: '@Labels.ChangesLog',
            No: '@Labels.No',
            LogId: '@Labels.LogId',
            LogDate: '@Labels.LogDateGMTA8',
            Action: '@Labels.Action',
            EditBy: '@Labels.EditBy',
            HeadlineDA: '@Labels.HeadlineDA',
            PleaseChooseAction: '@Messages.PleaseChooseAction',
            ToDateCanNotBeforeFromDate: '@Messages.ToDateCanNotBeforeFromDate',
            PIC: '@Labels.PIC',
            Detail: '@Labels.Detail',
            NoData: '@Labels.NoData',
            Search: '@Labels.Search',
            All: '@Labels.All',
            Selected: '@Labels.Select',
            Name: '@Labels.Name',
            Language: '@Labels.Language',
            Role: '@Labels.Role',
            Country: '@Labels.Country',
            CommunicationTool: '@Labels.CommunicationTool',
            IsActive: '@Labels.IsActive',
            DirectAccount: '@Labels.DirectAccount',
            GroupHeadline: '@Labels.GroupHeadline',
            PIC: '@Labels.PIC',
            IsGroupHeadline: '@Labels.IsGroupHeadline'
        };
    </script>
}