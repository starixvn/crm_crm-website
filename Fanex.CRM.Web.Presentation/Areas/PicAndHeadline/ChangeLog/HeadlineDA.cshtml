@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
﻿@using Fanex.CRM.Resources

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.ChangeLog;
}

@section Styles{
    <link rel="stylesheet" href="~/wwwroot/dist/styles/change.log.css" />
}

<div ng-app="change-log-application" class="change-log">
    <div class="changeLogController" ng-controller="changeLogController as changeLogCtrl">
        <div class="main container">
            <div class="row" ng-show="changeLogCtrl.errorMessage !== ''">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div id="alertboxerr">
                        <div ng-bind="changeLogCtrl.errorMessage">
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <button>@Labels.GroupHeadline</button>
                <button>@Labels.PIC</button>
            </div>

            <div ng-if="!isPicReport" class="row" ng-controller="headlineDALogController as headlineDALogCtrl">
                <form class="filter-form" id="headline-da-log-filter" ng-submit="headlineDALogCtrl.getReport()">
                    <div class="row filter-frm one-row expand-filter">
                        <div class="row row-item">
                            <div class="item">
                                <label class="width-85">
                                    @Labels.GroupHeadline
                                </label>
                                <input type="text" class="textbox" id="username" ng-model="headlineDALogCtrl.searchCriteria.HeadlineDA" autocomplete="off" />
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.FromDate
                                </label>
                                <div class="display-inline-block date-picker-from-date-container" ng-model="fromDateOptions.IsRerenderPicker">
                                    <input id="fromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                                </div>
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.ToDate
                                </label>
                                <div class="display-inline-block date-picker-to-date-container" ng-model="toDateOptions.IsRerenderPicker">
                                    <input id="toDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                                </div>
                            </div>
                            <div class="item">
                                <label class="width-50 pull-left">
                                    @Labels.Action
                                </label>
                                <multileveldropdowntree class="pull-left"
                                                        text-settings="headlineDALogCtrl.textSettings"
                                                        data-settings="headlineDALogCtrl.actionDropdownSettings"
                                                        data-show-selected-all-text="true"
                                                        ng-model="headlineDALogCtrl.selectedActions"
                                                        ng-change="headlineDALogCtrl.actionChangedHandler()"
                                                        ng-on-checkall="headlineDALogCtrl.actionChangedHandler()" />
                            </div>
                        </div>
                        <div class="row row-item">
                            <div class="item">
                                <label class="width-85">
                                    @Labels.EditBy
                                </label>
                                <input type="text" class="textbox" id="edit-by" ng-model="headlineDALogCtrl.searchCriteria.EditBy" autocomplete="off" />
                            </div>
                            <div class="item">
                                <button class="btn" type="submit"><span class="hotkey">S</span>ubmit</button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="row">
                    <div ng-model="reportOptions.IsUpdateGrid" class="table-report-container">
                        <div id="table-report" class="freegrid display-none table-report">
                        </div>
                    </div>
                </div>
            </div>

            <div ng-if="isPicReport" class="row" ng-controller="headlineDALogController as headlineDALogCtrl">
                <form class="filter-form display-none" id="headline-da-log-filter" ng-submit="headlineDALogCtrl.getReport()">
                    <div class="row filter-frm one-row expand-filter">
                        <div class="row row-item">
                            <div class="item">
                                <label class="width-85">
                                    @Labels.GroupHeadline
                                </label>
                                <input type="text" class="textbox" id="username" ng-model="headlineDALogCtrl.searchCriteria.HeadlineDA" autocomplete="off" />
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.FromDate
                                </label>
                                <div class="display-inline-block date-picker-from-date-container" ng-model="fromDateOptions.IsRerenderPicker">
                                    <input id="fromDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                                </div>
                            </div>
                            <div class="item">
                                <label>
                                    @Labels.ToDate
                                </label>
                                <div class="display-inline-block date-picker-to-date-container" ng-model="toDateOptions.IsRerenderPicker">
                                    <input id="toDate" type="text" class="textbox txtcalendar" autocomplete="off" />
                                </div>
                            </div>
                            <div class="item">
                                <label class="width-50 pull-left">
                                    @Labels.Action
                                </label>
                                <multileveldropdowntree class="pull-left"
                                                        text-settings="headlineDALogCtrl.textSettings"
                                                        data-settings="headlineDALogCtrl.actionDropdownSettings"
                                                        data-show-selected-all-text="true"
                                                        ng-model="headlineDALogCtrl.selectedActions"
                                                        ng-change="headlineDALogCtrl.actionChangedHandler()"
                                                        ng-on-checkall="headlineDALogCtrl.actionChangedHandler()" />
                            </div>
                        </div>
                        <div class="row row-item">
                            <div class="item">
                                <label class="width-85">
                                    @Labels.EditBy
                                </label>
                                <input type="text" class="textbox" id="edit-by" ng-model="headlineDALogCtrl.searchCriteria.EditBy" autocomplete="off" />
                            </div>
                            <div class="item">
                                <button class="btn" type="submit"><span class="hotkey">S</span>ubmit</button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="row">
                    <div ng-model="reportOptions.IsUpdateGrid" class="table-report-container">
                        <div id="table-report" class="freegrid display-none table-report">
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @RazorHelper.RenderScripts("~/Areas/PicAndHeadline/ChangeLogScripts")
    <script src="~/Scripts/jquery-ui-1.8.14.custom.js"></script>
    <script src="~/wwwroot/dist/js/change.log.js"></script>
    <script type="text/javascript">
        parent.document.title = '@Labels.ChangeLog';
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()';
        var minReportDate = new Date('@AppSetting.MinReportDate.ToShortFormatedDate()');
        var initFromDate = '@DateTimeUtilize.CurrentClientTime().FirstDayOfMonth().ToShortFormatedDate()';

        var viewResources = {
            No: '@Labels.No',
            LogId: '@Labels.LogId',
            LogDate: '@Labels.LogDate' + '(GMT+8)',
            Username: '@Labels.Username',
            Action: '@Labels.Action',
            OldValue: '@Labels.OldValue',
            NewValue: '@Labels.NewValue',
            EditBy: '@Labels.EditBy',
            HeadlineDA: '@Labels.GroupHeadline',
            PIC: '@Labels.PIC',
            NoData: '@Labels.NoData',
            Search: '@Labels.Search',
            All: '@Labels.All',
            Selected: '@Labels.Select'
        };
    </script>
}