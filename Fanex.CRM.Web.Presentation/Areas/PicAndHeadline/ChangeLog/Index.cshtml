@using Fanex.CRM.Common.Extensions;
@using Fanex.CRM.Common.Helpers;
@using Fanex.CRM.Common.Services;
﻿@using Fanex.CRM.Resources

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.ChangeLog;
}

@section Styles{
    @*<link rel="stylesheet" href="~/wwwroot/dist/styles/change.log.css" />*@
}

<div ng-app="change-log-application" class="change-log">
    <div class="changeLogController" ng-controller="changeLogController">
        <div class="main container">
            <div class="row row-item" ng-show="validateFilterMessage.isShowErrMsg">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="alertbox{{validateFilterMessage.isShowErrMsg ? 'err' : ''}}">
                        <div ng-bind="validateFilterMessage.message"></div>
                    </div>
                </div>
            </div>
            <form class="filter-form" id="change-log-filter" ng-submit="getReport()">
                <div class="row filter-frm one-row expand-filter">
                    <div class="row row-item">
                        <div class="item">
                            <label class="width-85">
                                @Labels.Username
                            </label>
                            <input type="text" class="textbox" id="username" ng-model="searchCriteria.Username" autocomplete="off" />
                        </div>
                        <div class="item">
                            <label class="width-85 pull-left">
                                @Labels.FromDate
                            </label>
                            <div class="display-inline-block date-picker-from-date-container" ng-model="searchCriteria.IsRerenderPicker">
                                <input id="from-date" type="text" class="textbox txtcalendar" autocomplete="off" />
                            </div>
                        </div>
                        <div class="item" status-multi-container ng-model="statusOptions.DataList">
                            <label class="width-85 pull-left">
                                @Labels.ToDate
                            </label>
                            <div class="input-container pull-left">
                                <select id="status" class="status"></select>
                            </div>
                        </div>
                        <div class="item">
                            <label class="width-85 pull-left">
                                @Labels.Action
                            </label>
                            <div class="input-container pull-left">
                                <select id="headline" class="headline" ng-model="searchCriteria.HeadlineType" ng-init="searchCriteria.HeadlineType = ''">
                                    <option value="">All</option>
                                    <option value="1">VIP</option>
                                    <option value="0">Normal</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row row-item">
                        <div class="item">
                            <label class="width-85 pull-left">
                                @Labels.EditBy
                            </label>
                            <div class="input-container pull-left">
                                <input type="text" ng-model="searchCriteria.GroupHeadline" />
                            </div>
                        </div>
                        <div class="item">
                            <button class="btn" type="submit"><span class="hotkey">S</span>ubmit</button>
                        </div>
                    </div>
                </div>
            </form>

            <div class="row">
                <div ng-model="reportOptions.IsUpdateGrid" class="table-report-container">
                    <div id="table-report" class="freegrid display-none table-report">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RazorHelper.RenderScripts("~/Areas/PicAndHeadline/ChangeLogScripts");
    <script src="~/Scripts/jquery-ui-1.8.14.custom.js"></script>
    <script src="~/wwwroot/dist/js/change.log.js"></script>
    <script type="text/javascript">
        parent.document.title = '@Labels.ChangeLog';
        window.rootUrl = '@Url.Content("~")';
        var currentDate = '@DateTimeUtilize.CurrentClientTime().ToShortFormatedDate()';
        var minReportDate = new Date('@AppSetting.MinReportDate.ToShortFormatedDate()');
        var initFromDate = '@DateTimeUtilize.CurrentClientTime().FirstDayOfMonth().ToShortFormatedDate()';

        var viewResources = {
            No: '@Labels.No',
            LogId: '@Labels.LogId',
            LogDate: '@Labels.LogDate' + '(GMT+8)',
            Username: '@Labels.Username',
            Action: '@Labels.Action',
            OldValue: '@Labels.OldValue',
            NewValue: '@Labels.NewValue',
            EditBy: '@Labels.EditBy'
        };
    </script>
}