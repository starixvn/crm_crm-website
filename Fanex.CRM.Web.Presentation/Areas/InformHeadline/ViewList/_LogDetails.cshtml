@using CommonLabels = Fanex.CRM.Common.Resources.Labels;

<div id="template-log-details" style="display: none">
    <div class="modal-header">
        @CommonLabels.InformHeadlines - @CommonLabels.RemovedEditedAccountsLogs
        <span class="icon-close glyphicon glyphicon-remove" ng-click="logDetailsCtrl.close()"></span>
    </div>
    <div class="modal-body">
        <div class="freegrid display-none"
             log-details-grid ng-model="logDetailsCtrl.data" data-pager-option="logDetailsCtrl.pagerOption"
             data-on-page-change="logDetailsCtrl.getRemovedAccountLogs"></div>
    </div>
    <div class="modal-footer">
        <button class="btn" ng-click="logDetailsCtrl.close()">@CommonLabels.Close</button>
    </div>
</div>