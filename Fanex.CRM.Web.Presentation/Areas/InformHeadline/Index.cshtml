@using CommonLabels = Fanex.CRM.Common.Resources.Labels;
﻿@using Fanex.CRM.InformHeadline.Resources;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.InformHeadlines;
}
@section Styles{
    <link rel="stylesheet" href="~/wwwroot/dist/styles/inform.headline.css" />
}
<div ng-app="informHeadlineModule">
    <div ng-controller="InformHeadlineController"
         ng-init="contactPolicy='@ViewBag.ContactPolicy';searchPolicy='@ViewBag.SearchPolicy';">

        @if (ViewBag.ContactPolicy != "None" || ViewBag.SearchPolicy != "None")
        {
            <div class="row download-file-container" ng-model="downloadFileOptions">
                <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
            </div>
            <div id="contextMenu" class="dropdown clearfix" style="display: none;position: absolute">
                <ul class="dropdown-menu" role="menu" aria-labelledby="dropdownMenu" style="display:block;position:relative">
                    <li class="status-closed">
                        <a data-status="0" class="open-menu-item" tabindex="-1" href="javascript:;">
                            <i class="fa fa-folder-open"></i> Open case
                        </a>
                    </li>
                    <li class="status-closed divider"></li>
                    <li class="status-closed">
                        <a class="view-logs" tabindex="-1" href="javascript:;">
                            <i class="fa fa-list-alt"></i> @CommonLabels.RemovedEditedAccountsLogs
                        </a>
                    </li>

                    <li>
                        <a class="edit-menu-item" tabindex="-1" href="javascript:;">
                            <i class="fa fa-pencil-square-o"></i> Edit number of account
                        </a>
                    </li>
                    <li class="divider"></li>
                    <li>
                        <a class="view-logs" tabindex="-1" href="javascript:;">
                            <i class="fa fa-list-alt"></i> @CommonLabels.RemovedEditedAccountsLogs
                        </a>
                    </li>
                    <li class="divider"></li>
                    <li>
                        <a class="close-menu-item" data-status="1" tabindex="-1" href="javascript:;">
                            <i class="fa fa-times"></i> Close case
                        </a>
                    </li>
                </ul>
            </div>
            <div class="container main">
                <div class="row row-item" ng-show="messageResultOptions.IsShowMessage">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                             class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                            <div ng-bind="messageResultOptions.Message"></div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div inform-headline-grid data-ng-model="listData" class="freegrid inform-headline-grid display-none"></div>
                </div>
                @if (ViewBag.SearchPolicy == "Host")
                {
                    <div class="row btn-group">
                        <button id="buttoninsert" class="btn" ng-click="showAddCaseDialog()">
                            @Labels.NewCase
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-danger">@CommonLabels.NoPermission</div>
        }
    </div>
</div>
@Html.Partial("~/Areas/InformHeadline/_Logs.cshtml")
@Html.Partial("~/Areas/InformHeadline/_LogDetails.cshtml")
@section Scripts {
    @RazorHelper.RenderScripts(
        "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
        "~/CRM/DownLoadFile/Scripts",
        "~/wwwroot/sources/libs/FanexGrid/NumeralScripts",
        "~/Scripts/FanexGridScripts",
        "~/Bundles/InformHeadline/ViewListScripts")
    <script type="text/javascript">
        parent.document.title = '@Labels.InformHeadlines';
        var viewResources = {
            Edit: '@Labels.Edit',
            InformHeadlinesCases: '@Labels.InformHeadlinesCases',
            Title: '@Labels.Title',
            CreatedDate: '@Labels.CreatedDate',
            NoDirectAccounts: '@Labels.NoDirectAccounts',
            Status: '@CommonLabels.Status',
            Done: '@Labels.Done',
            RequestToCallBack: '@Labels.RequestToCallBack',
            NoNeedToCall: '@Labels.NoNeedToCall',
            NoReply: '@Labels.NoReply',
            Uncontactable: '@Labels.Uncontactable',
            InternalAccount: '@Labels.InternalAccount',
            NeverTouch: '@Labels.NeverTouch',
            KeptForReference: '@Labels.KeptForReference',
            UpdateFailed: '@Labels.UpdateFailed',
            NewInformHeadlines: '@Labels.NewInformHeadlines',
            UpdateInformHeadlines: '@Labels.UpdateInformHeadlines',
            EditNumberOfAccounts: '@Labels.EditNumberOfAccounts',
            Date: '@CommonLabels.Date',
            EditedBy: '@CommonLabels.EditedBy',
            NumberOfRemovedEditedAccounts: '@CommonLabels.NumberOfRemovedEditedAccounts',
            DirectAccount: '@CommonLabels.DirectAccount',
            UpdatedTime: '@CommonLabels.UpdatedTime',
            Remark: '@CommonLabels.Remark',
            Handler: '@CommonLabels.Handler',
            Extension: '@CommonLabels.Extension',
            ProductStatus: '@CommonLabels.ProductStatus'
        };
    </script>
}