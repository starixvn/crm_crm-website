﻿@using Fanex.CRM.InformHeadline.Resources;
@using Fanex.CRM.Infrastructure.Extensions;
@{    
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
}
@{
    ViewBag.Title = Labels.InformHeadlines;
}
@section Styles{
    @RazorHelper.RenderStyles("~/Scripts/FanexGridV2/Fanex.Grid.css",
        "~/Content/site/customizeFanexGridV2.less",
        "~/Scripts/Directives/dropdowntree/fanex.directive.dropdowntree.css",
        "~/Areas/InformHeadline/NewInformStyles")
}
<div data-ng-app="newInformApplication">
    <div data-ng-controller="NewInformController">
        <div class="row row-item" data-ng-show="messageResultOptions.IsShowMessage">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div data-ng-class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}"
                    class="alertbox{{ messageResultOptions.IsSuccess ? 'scc' : 'err' }}">
                    <div data-ng-bind="messageResultOptions.Message">
                    </div>
                </div>
            </div>
        </div>
        <div class="row download-file-container" data-ng-model="downloadFileOptions">
            <iframe id="downloadFileContainer" width="0" height="0" class="display-none"></iframe>
        </div>
        <div class="container main">
            <div class="row filter-frm one-row deletedFeedback">
                <form name="mainForm" role="form">
                <div class="row row-item">
                    <div class="input-group" style="width: 100%">
                        <input class="" type="text" id="txtTitle" placeholder="@Labels.Title" class="textbox" data-ng-model="titleDetail.Title" />                     
                        <i style="padding: 0px" class="input-group-addon btnExcel" data-ng-show="listData.length > 0" data-ng-click="exportInformHeadlines()"></i>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item">
                        <label for="txtfromdate" class="width-70">
                            @Labels.Currency</label>
                        <div class="display-inline-block">
                            <dropdowntree ng-model="selectedCurrencies" data-settings="currencyDropdownSettings"></dropdowntree>
                        </div>
                    </div>
                    <div class="item">
                        <label for="txtfromdate" class="width-70">
                            @Labels.Position</label>
                        <div class="display-inline-block">
                            <dropdowntree ng-model="selectedPositions" data-settings="positionDropdownSettings"></dropdowntree>
                        </div>
                    </div>
                    <div class="item">
                        <label for="txtfromdate" class="width-70">
                            @Labels.Site</label>
                        <div class="display-inline-block">
                            <dropdowntree ng-model="selectedSites" data-settings="siteDropdownSettings"></dropdowntree>
                        </div>
                    </div>
                    <div class="item">
                        <button class="btn" data-ng-click="getInforms()">@Labels.Search</button>
                    </div>
                </div>
                <div class="row row-item">
                    <div class="item main-category-picker-container" data-ng-model="mainCategoryOptions.DataList">
                        <label for="main-category" class="width-80">@Labels.DirectAccounts</label>
                        <div class="display-inline-block">
                            <input id="headlineCheckBox" checked type="checkbox" data-ng-model="headlineChecked" />
                            <label for="headlineCheckBox" class="width-80">@Labels.Headline</label>
                            <input id="directCheckBox" checked type="checkbox" data-ng-model="directChecked" />
                            <label for="directCheckBox" class="width-80">@Labels.WithoutAnyGroup</label>
                        </div>
                    </div>
                </div>
                </form>
            </div>
            <div class="row">
                <div id="inform-headline-list-container" inform-headline-list-container data-ng-model="listData" updated-items="updatedItems">
                    <div id="inform-headline-list" class="freegrid display-none">
                    </div>
                </div>
            </div> 
            <div class="row btn-group" data-ng-show="showSaveButton">
                <button id="buttoninsert" class="btn" data-ng-click="insertInforms()">
                    @Labels.Save</button>
            </div>              
        </div>
        @section Scripts {
            @RazorHelper.RenderScripts(
                "~/Scripts/CommomScripts",
                "~/Scripts/AngularJSLibrary",
                "~/Content/bootstrap/js/bootstrap.min.js",
                "~/Scripts/AngularJS/angular-sanitize.min.js",
                "~/Scripts/Directives/dropdowntree/fanex.directive.dropdowntree.min.js",
                "~/Scripts/ShareScripts/Applications/ResultMessageScripts",
                "~/Scripts/FanexGridScripts",
                "~/CRM/DownLoadFile/Scripts",
                "~/Bundles/InformHeadline/NewInformScripts")
            
            <script type="text/javascript">
                parent.document.title = '@Labels.InformHeadlines';
                var viewResources = {
                    Status: '@Labels.Status',
                    Title: '@Labels.Title',
                    Status: '@Labels.Status',
                    Search: '@Labels.Search',
                    Currency: '@Labels.Currency',
                    Position: '@Labels.Position',
                    Site: '@Labels.Site',
                    DirectAccounts: '@Labels.DirectAccounts',
                    DirectAccount: '@Labels.DirectAccount',
                    Headline: '@Labels.Headline',
                    WithoutAnyGroup: '@Labels.WithoutAnyGroup',
                    UpdatedTime: '@Labels.UpdatedTime',
                    Remark: '@Labels.Remark',
                    Handler: '@Labels.Handler',
                    Extension: '@Labels.Extension',
                    ProductStatus: '@Labels.ProductStatus',
                    Save: '@Labels.Save',
                    NewInformHeadlines: '@Labels.NewInformHeadlines'
                };
            </script>
        }
    </div>
</div>
