@using CommonLabels = Fanex.CRM.Common.Resources.Labels;

<div id="template-logs" style="display: none">
    <div class="modal-header">
        @CommonLabels.InformHeadlines - @CommonLabels.RemovedEditedAccountsLogs
        <span class="icon-close" ng-click="logsCtrl.close()"></span>
    </div>
    <div class="modal-body">
        <div class="freegrid display-none"
             logs-grid ng-model="logsCtrl.data" data-pager-option="logsCtrl.pagerOption"
             data-on-page-change="logsCtrl.getRemovedAccountLogs"
             data-on-view-details="logsCtrl.viewLogDetails"></div>
    </div>
    <div class="modal-footer">
        <button class="btn" ng-click="logsCtrl.close()">@CommonLabels.Close</button>
    </div>
</div>