<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!--Fanex setting-->
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <!--Enterprise Library Distributor Service-->
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <!--End Fanex Setting-->
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />

    <sectionGroup name="bundleTransformer">
      <section name="core" type="BundleTransformer.Core.Configuration.CoreSettings, BundleTransformer.Core" />
      <section name="less" type="BundleTransformer.Less.Configuration.LessSettings, BundleTransformer.Less" />
    </sectionGroup>
    <sectionGroup name="jsEngineSwitcher">
      <section name="core" type="JavaScriptEngineSwitcher.Core.Configuration.CoreConfiguration, JavaScriptEngineSwitcher.Core" />
    </sectionGroup>
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    
  <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" /></configSections>

  <!--<NapSettings UMAddress="tcp://10.40.40.150:8990/UMControllerInterface" Environment="UAT" EnableDirectLogin="1" SiteId="83" EnableCheckUM="false" EnableReCheckin="false" UnauthorizeUrl="~/Common/AccessDenied" HubUrl="http://localhost:54332/NAPHub">
